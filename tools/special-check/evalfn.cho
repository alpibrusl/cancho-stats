edition 5;

module check.evalfn;

// The functions of special-check by name and number, the decoding of a bit pattern (every pattern: infinities and NaNs included) and the evaluation of one case.

import std.math;
import ml.fbits;
import special.dist;
import special.lgam;
import special.igam;
import special.ibeta;
import special.quantile;

pub fn same[&a, &b](x: &a [byte], y: &b [byte]) -> [] bool {
    if len(x) != len(y) {
        return false;
    }
    var i = 0;
    while i < len(x) {
        if x[i] != y[i] {
            return false;
        }
        i = i + 1;
    }
    return true;
}

pub fn which[&s](name: &s [byte]) -> [] int {
    if same(name, "lgamma") {
        return 1;
    }
    if same(name, "erf") {
        return 2;
    }
    if same(name, "erfc") {
        return 3;
    }
    if same(name, "gamma_p") {
        return 4;
    }
    if same(name, "gamma_q") {
        return 5;
    }
    if same(name, "beta_lo") {
        return 6;
    }
    if same(name, "beta_up") {
        return 7;
    }
    if same(name, "norm_cdf") {
        return 8;
    }
    if same(name, "norm_sf") {
        return 9;
    }
    if same(name, "qnorm") {
        return 10;
    }
    if same(name, "t_cdf") {
        return 11;
    }
    if same(name, "t_sf") {
        return 12;
    }
    if same(name, "chi2_cdf") {
        return 13;
    }
    if same(name, "chi2_sf") {
        return 14;
    }
    if same(name, "f_cdf") {
        return 15;
    }
    if same(name, "f_sf") {
        return 16;
    }
    if same(name, "binom_cdf") {
        return 17;
    }
    if same(name, "binom_sf") {
        return 18;
    }
    if same(name, "lgamma1p") {
        return 19;
    }
    if same(name, "gamma_quantile") {
        return 20;
    }
    if same(name, "gamma_quantile_upper") {
        return 21;
    }
    if same(name, "chi2_quantile") {
        return 22;
    }
    if same(name, "chi2_quantile_upper") {
        return 23;
    }
    if same(name, "beta_quantile") {
        return 24;
    }
    if same(name, "beta_quantile_comp") {
        return 25;
    }
    if same(name, "beta_quantile_upper") {
        return 26;
    }
    if same(name, "t_quantile") {
        return 27;
    }
    if same(name, "t_quantile_upper") {
        return 28;
    }
    if same(name, "f_quantile") {
        return 29;
    }
    if same(name, "f_quantile_upper") {
        return 30;
    }
    if same(name, "gamma_iterations") {
        return 31;
    }
    if same(name, "beta_iterations") {
        return 32;
    }
    if same(name, "ks_sf") {
        return 33;
    }
    return 0;
}

pub fn hexval(c: int) -> [] int {
    if c >= '0' && c <= '9' {
        return c - '0';
    }
    if c >= 'a' && c <= 'f' {
        return c - 'a' + 10;
    }
    if c >= 'A' && c <= 'F' {
        return c - 'A' + 10;
    }
    return 0;
}

// the double whose bits are `bits`, every pattern: infinities and NaNs included (ml.fbits.decode answers NaN for both)
pub fn decode(bits: int) -> [] float {
    if bits >> 52 & 2047 == 2047 {
        if bits & 4503599627370495 == 0 {
            if bits < 0 {
                return -1.0 / 0.0;
            }
            return 1.0 / 0.0;
        }
        return 0.0 / 0.0;
    }
    return fbits.decode(bits);
}

pub fn eval(f: int, x: float, y: float, z: float) -> [] (float, int) {
    if f == 1 {
        return dist.lgamma(x);
    }
    if f == 2 {
        return dist.erf(x);
    }
    if f == 3 {
        return dist.erfc(x);
    }
    if f == 4 || f == 5 {
        let (p, q, code) = igam.gamma_pq(x, y);
        if f == 4 {
            return (p, code);
        }
        return (q, code);
    }
    if f == 6 || f == 7 {
        let (lo, up, code) = ibeta.beta_ix(x, y, z);
        if f == 6 {
            return (lo, code);
        }
        return (up, code);
    }
    if f == 8 {
        return dist.norm_cdf(x);
    }
    if f == 9 {
        return dist.norm_sf(x);
    }
    if f == 10 {
        return dist.qnorm(x);
    }
    if f == 11 {
        return dist.t_cdf(x, y);
    }
    if f == 12 {
        return dist.t_sf(x, y);
    }
    if f == 13 {
        return dist.chi2_cdf(x, y);
    }
    if f == 14 {
        return dist.chi2_sf(x, y);
    }
    if f == 15 {
        return dist.f_cdf(x, y, z);
    }
    if f == 16 {
        return dist.f_sf(x, y, z);
    }
    if f == 17 {
        return dist.binom_cdf(x, y, z);
    }
    if f == 19 {
        if is_nan(x) || x < 0.0 {
            return (0.0 / 0.0, 2);
        }
        return (lgam.lgamma1p(x), 0);
    }
    if f == 20 {
        return quantile.gamma_quantile(x, y);
    }
    if f == 21 {
        return quantile.gamma_quantile_upper(x, y);
    }
    if f == 22 {
        return quantile.chi2_quantile(x, y);
    }
    if f == 23 {
        return quantile.chi2_quantile_upper(x, y);
    }
    if f == 24 {
        return quantile.beta_quantile(x, y, z);
    }
    if f == 25 {
        return quantile.beta_quantile_comp(x, y, z);
    }
    if f == 26 {
        return quantile.beta_quantile_upper(x, y, z);
    }
    if f == 27 {
        return quantile.t_quantile(x, y);
    }
    if f == 28 {
        return quantile.t_quantile_upper(x, y);
    }
    if f == 29 {
        return quantile.f_quantile(x, y, z);
    }
    if f == 30 {
        return quantile.f_quantile_upper(x, y, z);
    }
    if f == 31 {
        return quantile.gamma_iterations(x, y);
    }
    if f == 32 {
        return quantile.beta_iterations(x, y, z);
    }
    if f == 33 {
        return dist.ks_sf(x);
    }
    return dist.binom_sf(x, y, z);
}
