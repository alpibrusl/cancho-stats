// special-check: evaluates one special function on the cases of standard input (docs/numerics.md section 4). Input, one case per line:
//
//     ID HEX [HEX [HEX]]       ID a decimal number; each HEX the 16 hex digits of the bits of a double (so NaN payloads, infinities and -0.0 are expressible)
//
// Output, one line per case, in input order:
//
//     ID HEX CODE              HEX the bits of the result (a refusal answers a NaN), CODE 0 or the refusal code of special.rules
//
// special-check tags prints the table of codes and rule tags. A line is never rejected: a missing argument is the bits 0, an extra token is ignored.
edition 5;

import std.io;
import std.math;
import ml.fbits;
import special.rules;
import special.dist;
import special.igam;
import special.ibeta;

fn same[&a, &b](x: &a [byte], y: &b [byte]) -> [] bool {
    if len(x) != len(y) {
        return false;
    }
    var i = 0;
    while i < len(x) {
        if x[i] != y[i] {
            return false;
        }
        i = i + 1;
    }
    return true;
}

fn which[&s](name: &s [byte]) -> [] int {
    if same(name, "lgamma") {
        return 1;
    }
    if same(name, "erf") {
        return 2;
    }
    if same(name, "erfc") {
        return 3;
    }
    if same(name, "gamma_p") {
        return 4;
    }
    if same(name, "gamma_q") {
        return 5;
    }
    if same(name, "beta_lo") {
        return 6;
    }
    if same(name, "beta_up") {
        return 7;
    }
    if same(name, "norm_cdf") {
        return 8;
    }
    if same(name, "norm_sf") {
        return 9;
    }
    if same(name, "qnorm") {
        return 10;
    }
    if same(name, "t_cdf") {
        return 11;
    }
    if same(name, "t_sf") {
        return 12;
    }
    if same(name, "chi2_cdf") {
        return 13;
    }
    if same(name, "chi2_sf") {
        return 14;
    }
    if same(name, "f_cdf") {
        return 15;
    }
    if same(name, "f_sf") {
        return 16;
    }
    if same(name, "binom_cdf") {
        return 17;
    }
    if same(name, "binom_sf") {
        return 18;
    }
    return 0;
}

fn hexval(c: int) -> [] int {
    if c >= '0' && c <= '9' {
        return c - '0';
    }
    if c >= 'a' && c <= 'f' {
        return c - 'a' + 10;
    }
    if c >= 'A' && c <= 'F' {
        return c - 'A' + 10;
    }
    return 0;
}

// the double whose bits are `bits`, every pattern: infinities and NaNs included (ml.fbits.decode answers NaN for both)
fn decode(bits: int) -> [] float {
    if (bits >> 52 & 2047) == 2047 {
        if (bits & 4503599627370495) == 0 {
            if bits < 0 {
                return -1.0 / 0.0;
            }
            return 1.0 / 0.0;
        }
        return 0.0 / 0.0;
    }
    return fbits.decode(bits);
}

fn eval(f: int, x: float, y: float, z: float) -> [] (float, int) {
    if f == 1 {
        return dist.lgamma(x);
    }
    if f == 2 {
        return dist.erf(x);
    }
    if f == 3 {
        return dist.erfc(x);
    }
    if f == 4 || f == 5 {
        let (p, q, code) = igam.gamma_pq(x, y);
        if f == 4 {
            return (p, code);
        }
        return (q, code);
    }
    if f == 6 || f == 7 {
        let (lo, up, code) = ibeta.beta_ix(x, y, z);
        if f == 6 {
            return (lo, code);
        }
        return (up, code);
    }
    if f == 8 {
        return dist.norm_cdf(x);
    }
    if f == 9 {
        return dist.norm_sf(x);
    }
    if f == 10 {
        return dist.qnorm(x);
    }
    if f == 11 {
        return dist.t_cdf(x, y);
    }
    if f == 12 {
        return dist.t_sf(x, y);
    }
    if f == 13 {
        return dist.chi2_cdf(x, y);
    }
    if f == 14 {
        return dist.chi2_sf(x, y);
    }
    if f == 15 {
        return dist.f_cdf(x, y, z);
    }
    if f == 16 {
        return dist.f_sf(x, y, z);
    }
    if f == 17 {
        return dist.binom_cdf(x, y, z);
    }
    return dist.binom_sf(x, y, z);
}

fn hex16[&i](io: &!i Io, bits: int) -> [io_write] int {
    var k = 0;
    while k < 16 {
        let nib = bits >> 60 - 4 * k & 15;
        if nib < 10 {
            putchar(io, '0' + nib);
        } else {
            putchar(io, 'a' + nib - 10);
        }
        k = k + 1;
    }
    return 0;
}

fn answer[&i](io: &!i Io, f: int, id: int, b0: int, b1: int, b2: int) -> [io_write] int {
    let (v, code) = eval(f, decode(b0), decode(b1), decode(b2));
    io.print_int(io, id);
    io.space(io);
    hex16(io, bits_of(v));
    io.space(io);
    io.print_int(io, code);
    io.newline(io);
    return 0;
}

fn serve[&i](io: &!i Io, f: int) -> [io_read, io_write] int {
    var tok = 0;
    var inword = false;
    var v = 0;
    var id = 0;
    var b0 = 0;
    var b1 = 0;
    var b2 = 0;
    var c = getchar(io);
    while c >= 0 {
        if c == ' ' || c == '\n' || c == '\r' || c == '\t' {
            if inword {
                if tok == 0 {
                    id = v;
                } else if tok == 1 {
                    b0 = v;
                } else if tok == 2 {
                    b1 = v;
                } else if tok == 3 {
                    b2 = v;
                }
                tok = tok + 1;
                inword = false;
                v = 0;
            }
            if c == '\n' {
                if tok > 0 {
                    answer(io, f, id, b0, b1, b2);
                }
                tok = 0;
                id = 0;
                b0 = 0;
                b1 = 0;
                b2 = 0;
            }
        } else {
            inword = true;
            if tok == 0 {
                if v < 100000000000 {
                    v = v * 10 + (c - '0');
                }
            } else {
                v = v << 4 | hexval(c);
            }
        }
        c = getchar(io);
    }
    return 0;
}

fn tags[&i](io: &!i Io) -> [io_write] int {
    var k = 1;
    while k <= rules.count() {
        io.print_int(io, k);
        io.space(io);
        io.write_all(io, rules.tag(k));
        io.newline(io);
        k = k + 1;
    }
    return 0;
}

fn main(world: World) -> [] int {
    let Split { io, ffi, fs, heap, args, net, clock } = split(world);
    release(ffi);
    release(net);
    release(fs);
    release(heap);
    release(clock);
    var f = 0;
    var show = false;
    borrow args as &g in {
        if arg_count(g) >= 2 {
            f = which(arg(g, 1));
            show = same(arg(g, 1), "tags");
        }
    }
    release(args);
    var status = 0;
    borrow mut io as &!w in {
        if show {
            tags(w);
        } else if f == 0 {
            io.error_all(w, "usage: special-check FUNCTION | tags   (cases on standard input)\n");
            status = 2;
        } else {
            serve(w, f);
        }
    }
    release(io);
    return status;
}
