// special-check: evaluates one special function on the cases of standard input (docs/numerics.md section 4). Input, one case per line:
//
//     ID HEX [HEX [HEX]]       ID a decimal number; each HEX the 16 hex digits of the bits of a double (so NaN payloads, infinities and -0.0 are expressible)
//
// Output, one line per case, in input order:
//
//     ID HEX CODE              HEX the bits of the result (a refusal answers a NaN), CODE 0 or the refusal code of special.rules
//
// special-check tags prints the table of codes and rule tags. A line is never rejected: a missing argument is the bits 0, an extra token is ignored.
edition 5;

import std.io;
import std.math;
import std.vec;
import special.rules;
import check.evalfn;
import check.parrun;

fn hex16[&i](io: &!i Io, bits: int) -> [io_write] int {
    var k = 0;
    while k < 16 {
        let nib = bits >> 60 - 4 * k & 15;
        if nib < 10 {
            putchar(io, '0' + nib);
        } else {
            putchar(io, 'a' + nib - 10);
        }
        k = k + 1;
    }
    return 0;
}

fn answer[&i](io: &!i Io, f: int, id: int, b0: int, b1: int, b2: int) -> [io_write] int {
    let (v, code) = evalfn.eval(f, evalfn.decode(b0), evalfn.decode(b1), evalfn.decode(b2));
    io.print_int(io, id);
    io.space(io);
    hex16(io, bits_of(v));
    io.space(io);
    io.print_int(io, code);
    io.newline(io);
    return 0;
}

fn serve[&i](io: &!i Io, f: int) -> [io_read, io_write] int {
    var tok = 0;
    var inword = false;
    var v = 0;
    var id = 0;
    var b0 = 0;
    var b1 = 0;
    var b2 = 0;
    var c = getchar(io);
    while c >= 0 {
        if c == ' ' || c == '\n' || c == '\r' || c == '\t' {
            if inword {
                if tok == 0 {
                    id = v;
                } else if tok == 1 {
                    b0 = v;
                } else if tok == 2 {
                    b1 = v;
                } else if tok == 3 {
                    b2 = v;
                }
                tok = tok + 1;
                inword = false;
                v = 0;
            }
            if c == '\n' {
                if tok > 0 {
                    answer(io, f, id, b0, b1, b2);
                }
                tok = 0;
                id = 0;
                b0 = 0;
                b1 = 0;
                b2 = 0;
            }
        } else {
            inword = true;
            if tok == 0 {
                if v < 100000000000 {
                    v = v * 10 + (c - '0');
                }
            } else {
                v = v << 4 | evalfn.hexval(c);
            }
        }
        c = getchar(io);
    }
    return 0;
}

fn copy_vec[&v, &d](src: &v vec.Vec[int], dst: &!d [int], n: int) -> [] int {
    var j = 0;
    while j < n {
        dst[j] = vec.get(src, j);
        j = j + 1;
    }
    return 0;
}

// the threaded path (`special-check FUNCTION --threads T`): read every case, evaluate them on T threads, print in input order
fn serve_threads[&h, &i](heap: &!h Heap, io: &!i Io, f: int, t: int) -> [heap, io_read, io_write, conc] int {
    var ids = vec.empty(heap, 64, 0);
    var va = vec.empty(heap, 64, 0);
    var vb = vec.empty(heap, 64, 0);
    var vc = vec.empty(heap, 64, 0);
    var tok = 0;
    var inword = false;
    var v = 0;
    var id = 0;
    var b0 = 0;
    var b1 = 0;
    var b2 = 0;
    var c = getchar(io);
    var n = 0;
    while c >= 0 {
        if c == ' ' || c == '\n' || c == '\r' || c == '\t' {
            if inword {
                if tok == 0 {
                    id = v;
                } else if tok == 1 {
                    b0 = v;
                } else if tok == 2 {
                    b1 = v;
                } else if tok == 3 {
                    b2 = v;
                }
                tok = tok + 1;
                inword = false;
                v = 0;
            }
            if c == '\n' {
                if tok > 0 {
                    ids = vec.push(heap, ids, id);
                    va = vec.push(heap, va, b0);
                    vb = vec.push(heap, vb, b1);
                    vc = vec.push(heap, vc, b2);
                    n = n + 1;
                }
                tok = 0;
                id = 0;
                b0 = 0;
                b1 = 0;
                b2 = 0;
            }
        } else {
            inword = true;
            if tok == 0 {
                if v < 100000000000 {
                    v = v * 10 + (c - '0');
                }
            } else {
                v = v << 4 | evalfn.hexval(c);
            }
        }
        c = getchar(io);
    }
    let ab = box_slice(heap, n + 1, 0);
    let bb = box_slice(heap, n + 1, 0);
    let cb = box_slice(heap, n + 1, 0);
    let ib = box_slice(heap, n + 1, 0);
    let ob = box_slice(heap, n + 1, 0);
    let kb = box_slice(heap, n + 1, 0);
    borrow mut ab as &!aw in {
        borrow va as &vr in {
            copy_vec(vr, contents(aw), n);
        }
    }
    borrow mut bb as &!bw in {
        borrow vb as &vr in {
            copy_vec(vr, contents(bw), n);
        }
    }
    borrow mut cb as &!cw in {
        borrow vc as &vr in {
            copy_vec(vr, contents(cw), n);
        }
    }
    borrow mut ib as &!iw in {
        borrow ids as &vr in {
            copy_vec(vr, contents(iw), n);
        }
    }
    borrow ab as &ar in {
        borrow bb as &br in {
            borrow cb as &cr in {
                borrow ib as &ir in {
                    borrow mut ob as &!ow in {
                        borrow mut kb as &!kw in {
                            parrun.run(heap, t, f, n, contents(ar), contents(br), contents(cr), contents(ow), contents(kw));
                            let idv = contents(ir);
                            let outv = contents(ow);
                            let codev = contents(kw);
                            var m = 0;
                            while m < n {
                                io.print_int(io, idv[m]);
                                io.space(io);
                                hex16(io, outv[m]);
                                io.space(io);
                                io.print_int(io, codev[m]);
                                io.newline(io);
                                m = m + 1;
                            }
                        }
                    }
                }
            }
        }
    }
    unbox_slice(heap, ab);
    unbox_slice(heap, bb);
    unbox_slice(heap, cb);
    unbox_slice(heap, ib);
    unbox_slice(heap, ob);
    unbox_slice(heap, kb);
    vec.drop(heap, ids);
    vec.drop(heap, va);
    vec.drop(heap, vb);
    vec.drop(heap, vc);
    return 0;
}

fn tags[&i](io: &!i Io) -> [io_write] int {
    var k = 1;
    while k <= rules.count() {
        io.print_int(io, k);
        io.space(io);
        io.write_all(io, rules.tag(k));
        io.newline(io);
        k = k + 1;
    }
    return 0;
}

// decimal digits only, at most 3 of them; anything else answers 0
fn number_of[&s](text: &s [byte]) -> [] int {
    if len(text) == 0 || len(text) > 3 {
        return 0;
    }
    var n = 0;
    var i = 0;
    while i < len(text) {
        let c = int_of(text[i]);
        if c < '0' || c > '9' {
            return 0;
        }
        n = n * 10 + (c - '0');
        i = i + 1;
    }
    return n;
}

fn main(world: World) -> [conc] int {
    let Split { io, ffi, fs, heap, args, net, clock } = split(world);
    release(ffi);
    release(net);
    release(fs);
    release(clock);
    var f = 0;
    var show = false;
    var threads = 0;
    borrow args as &g in {
        if arg_count(g) >= 2 {
            f = evalfn.which(arg(g, 1));
            show = evalfn.same(arg(g, 1), "tags");
        }
        if arg_count(g) >= 4 && evalfn.same(arg(g, 2), "--threads") {
            threads = number_of(arg(g, 3));
        }
    }
    release(args);
    var status = 0;
    borrow mut heap as &!h in {
        borrow mut io as &!w in {
            if show {
                tags(w);
            } else if f == 0 {
                io.error_all(w, "usage: special-check FUNCTION [--threads T] | tags   (cases on standard input)\n");
                status = 2;
            } else if threads >= 1 && threads <= 64 {
                serve_threads(h, w, f, threads);
            } else {
                serve(w, f);
            }
        }
    }
    release(heap);
    release(io);
    return status;
}
