import csvx.scan;
import stest.answer2;
import stest.answer3;
import stest.answer4;
import stest.answerci;
import stest.answer8;
import stest.wilcoxon;
import stest.correct;
import stest.prop;
import stest.chisq;
import stest.fisher;
import stest.answer10;
import csvx.cat;
import csvx.boot;
import csvx.ci;
import csvx.perm;
import csvx.cross;
import csvx.run;
import metrics.rank;
import special.dist;
import flt;
import reader;
import toolbox.built;
import toolbox.cli;
import toolbox.describe;
import toolbox.fail;
import toolbox.lines;
import toolbox.out;
import toolbox.path;
import toolbox.place;
import toolbox.text;

fn flag_table() -> [] &static [byte] {
    return "root||path|root||resolve FILE relative to this directory and refuse paths outside it;delim|d|text|none|,|the one byte that separates fields (default comma);ddof||nat|none|1|the divisor of the variance is n minus this (1 is the sample variance, 0 the population variance);max-rows||nat|none|1000000|the most data rows read, one more is limit.too-many-rows (ceiling 10000000);max-cols||nat|none|256|the most columns, more is limit.too-many-columns (ceiling 4096);max-line-bytes||nat|none|1048576|the longest line read, a longer one is limit.line-too-long (ceiling 16777216);max-cells||nat|none|20000000|the most cells (rows times columns) held for the quantiles, more is limit.too-many-cells (ceiling 100000000);quantiles||text|none|0,0.25,0.5,0.75,1|the probabilities of the quantiles, comma separated decimals from 0 to 1 with at most 9 decimals (at most 99 of them);quantile-type||nat|none|7|which of the nine Hyndman-Fan definitions, 1 to 9 (7 is the default of R and numpy);bins||nat|none|10|the number of equal-width histogram bins over [min, max], 0 for none (ceiling 1000);levels||nat|none|10|how many of the most frequent levels of a text column to print, 0 for none and no second pass (ceiling 100);max-levels||nat|none|100000|the most distinct (column, level) pairs held for all text columns together, a column that would need one more is levels_capped (ceiling 1000000);by||text|none||the header name of a column: describe each group of rows that have the same value in it, one after the other;max-groups||nat|none|50|the most groups with --by, one more is limit.too-many-groups (ceiling 1000);cols||text|none||the columns to describe, correlate or test: header names separated by commas, printed in the order of the file;format||choice:json/text|none|json|json for a program, text (one line per value, path = value) for a person;method||choice:pearson/spearman/kendall/wilson/clopper-pearson/newcombe/percentile/bca|none|pearson|ci boot: percentile (default) or bca; corr: the coefficient: pearson, spearman (the Pearson coefficient of the average ranks) or kendall (tau-b); ci prop: wilson (default), clopper-pearson, or newcombe (the difference, with --group);missing||choice:pairwise/listwise|none|pairwise|corr: pairwise uses, for each pair, the rows where both cells are numbers, listwise only the rows where every chosen column has a number;max-pairs||nat|none|1000|corr: the most pairs of columns, more is limit.too-many-pairs (ceiling 32640);mu0||text|none|0|test t1: the mean under the null hypothesis, a number;level||text|none|0.95|test: the confidence level of the interval, a decimal strictly between 0 and 1 with at most 9 decimals;group||text|none||test t2, prop, anova, kruskal, mannwhitney or ks: the header name of the column that has the groups (t2, prop, mannwhitney and ks: exactly two levels, the level that is first by bytes is the group a; anova and kruskal: two or more levels, at most --max-groups);vs||text|none||test chisq and fisher: the header name of the column to test the others against (independence);expected||text|none||test chisq: the proportions the column is tested against (goodness of fit), k decimals with at most 9 decimals that add up to 1, in the order of the levels by their bytes;correct||choice:none/bonferroni/holm/bh|none|none|test: the correction of the p-values of the call as a family of tests (none, bonferroni, holm or bh), written as family.p_adjusted after the tests;max-tests||nat|none|1000|test with --correct: the most tests (columns or pairs) in the family, more is limit.too-many-tests (ceiling 32640);success||text|none||test prop: the cell value that counts as a success;p0||text|none|0.5|test prop: the proportion under the null hypothesis, a decimal strictly between 0 and 1 with at most 9 decimals (one sample; not with --group);zeros||choice:wilcox/pratt/zsplit|none|wilcox|test wilcoxon: wilcox drops the zero differences before ranking (the default of R and scipy), pratt ranks them with the others and drops them from the sums, zsplit ranks them and shares their ranks between the two sums;exact||choice:auto/yes/no|none|auto|test mannwhitney, wilcoxon or ks: auto uses the exact p-value when no two values are equal and there are at most 60 values, yes refuses (stats.exact-unavailable) where it is not available, no always uses the normal approximation;continuity||choice:auto/none|none|auto|test mannwhitney or wilcoxon: auto applies the continuity correction of 0.5 to the normal approximation, none does not;variance||choice:welch/pooled|none|welch|test t2 or anova: welch (the default, the variances may differ) or pooled (the variances are equal);pairs||text|none||test paired: the columns to compare, A:B,C:D, the differences are A minus B over the rows where both are numbers;statistic||choice:mean/median/variance/sd/skewness/kurtosis/quantile/trimmed-mean/mean-diff|none|mean|ci boot: the statistic of each resample; resample perm: mean-diff;permutations||text|none|9999|resample perm: the number of shuffles, 100 to 1000000, or all for every arrangement of the labels (at most 1048576);prob||text|none||ci boot with quantile: the probability, a decimal from 0 to 1 with at most 9 decimals (the type is --quantile-type);trim||text|none|0.1|ci boot with trimmed-mean: the fraction dropped at each end, a decimal from 0 up to but not including 0.5 with at most 9 decimals;replicates||nat|none|2000|ci boot: the number of resamples, 100 to 100000;seed||text|none||ci boot: the seed of the draws, an integer from 0 to 4611686018427387903 (required: an unseeded draw is not reproducible);max-work||nat|none|2147483648|ci boot: the most draws (replicates times rows), more is limit.too-much-work";
}

fn tool() -> [] describe.Tool {
    return describe.Tool { name: "stats", version: "0.1.0", summary: "Describe, correlate and test the columns of a CSV file: statistics from exact sums rounded once (describe), Pearson, Spearman and Kendall coefficients (corr), the t family, one-way analysis of variance, Kruskal-Wallis, Mann-Whitney, Wilcoxon, Kolmogorov-Smirnov, chi-square and proportion tests with intervals, effect sizes and corrections for several tests (test); the same bytes on every platform and at any thread count.", usage: "stats describe [--root DIR] [--delim D] [--ddof N] [--max-rows N] [--max-cols N] [--max-line-bytes N] [--max-cells N] [--quantiles P,P,..] [--quantile-type N] [--bins N] [--levels N] [--max-levels N] [--by COL] [--max-groups N] [--cols A,B,..] [--format json|text] FILE; stats corr [--cols A,B,..] [--method pearson|spearman|kendall] [--missing pairwise|listwise] [--max-pairs N] FILE; stats test t1 --cols A,B,.. [--mu0 X] [--level 0.95] FILE; stats test t2 --cols A,B,.. --group G [--variance welch|pooled] [--level 0.95] FILE; stats test paired --pairs A:B,C:D [--level 0.95] FILE; stats test anova --cols A,B,.. --group G [--variance welch|pooled] FILE; stats test kruskal --cols A,B,.. --group G FILE; stats test mannwhitney --cols A,B,.. --group G [--exact auto|yes|no] [--continuity auto|none] FILE; stats test ks --cols A,B,.. --group G [--exact auto|yes|no] FILE, stats test fisher --cols A,.. --vs G FILE; stats test wilcoxon (--pairs A:B,C:D | --cols A,B,.. [--mu0 X]) [--zeros wilcox|pratt|zsplit] [--exact auto|yes|no] [--continuity auto|none] FILE; stats test chisq --cols A,B,.. (--vs G | --expected P,P,..) FILE; stats test prop --cols A,B,.. --success LEVEL [--p0 0.5 | --group G] [--level 0.95] FILE; every stats test also takes [--correct none|bonferroni|holm|bh] [--max-tests N]", output: "document", schema: "stats.v1", flags: flag_table(), operands: "VERB|none|1|1|describe, corr or test;FILE|path-read|1|2|the CSV file (after the kind of test, t1, t2, paired, chisq, prop, anova, kruskal, mannwhitney, wilcoxon or ks, for test)", rules: "args.unknown-flag;args.missing-value;args.bad-value;args.duplicate-flag;args.missing-operand;args.too-many-operands;path.empty;path.dotdot;path.absolute;path.outside-root;path.too-long;path.symlink;io.not-found;io.not-a-directory;io.is-a-directory;io.permission-denied;io.read-failed;limit.line-too-long;stats.csv-ragged;stats.csv-multiline;stats.csv-bad-quote;stats.no-header;stats.bad-verb;limit.too-many-rows;limit.too-many-columns;limit.too-many-cells;stats.file-changed;stats.no-such-column;stats.ambiguous-column;limit.too-many-groups;stats.corr-columns;stats.non-numeric;limit.too-many-pairs;stats.test-columns;stats.group-levels;stats.expected-proportions;limit.too-many-tests;stats.exact-unavailable;limit.exact-too-large;limit.too-much-work;stats.seed-required", extra_rules: rule.extra(), limits: "max-rows|1000000|10000000;max-cols|256|4096;max-line-bytes|1048576|16777216;max-cells|20000000|100000000;bins|10|1000;levels|10|100;max-levels|100000|1000000;max-groups|50|1000;max-pairs|1000|32640", reversibility: "reversible-cheap", stdin: "never", guarantees: "deterministic;idempotent;bounded_memory" };
}

fn built() -> [] describe.Built {
    return describe.Built { authority: built.authority(), schema: built.schema(), compiler: built.compiler() };
}

fn row_ceiling() -> [] int {
    return 10000000;
}

fn col_ceiling() -> [] int {
    return 4096;
}

fn line_ceiling() -> [] int {
    return 16777216;
}

// ------------------------------------------------------------------------------------------------ the columns

// ------------------------------------------------------------------------------------------------ exact arithmetic to a double

fn float_of_bits(bits: int) -> [] float {
    var key = bits;
    if bits < 0 {
        key = bits ^ 0x7fffffffffffffff;
    }
    return flt.float_of_key(key);
}

struct Stats {
    mean: float,
    variance: float,
    sd: float,
    variance_ok: bool,
    skew: float,
    kurt: float,
    moments_ok: bool,
}

// the exact mean and variance of the numeric cells of column j
fn moments[&h, &c](heap: &!h Heap, c: &c scan.Cols, j: int, ddof: int) -> [heap] Stats {
    let n = contents(c.numeric)[j];
    let accs = contents(c.accs);
    let base = j * scan.acc_stride();
    let l1 = psum.limbs(1);
    let l2 = psum.limbs(2);
    let s1 = box_slice(heap, l1 + 1, 0);
    let s2 = box_slice(heap, l2 + 1, 0);
    let nl = box_slice(heap, 4, 0);
    var mean = 0.0;
    var variance = 0.0;
    var ok = false;
    borrow mut s1 as &!w1 in {
        borrow mut s2 as &!w2 in {
            borrow mut nl as &!wn in {
                let neg1 = psum.magnitude(accs[base..base + psum.size(1)], 1, contents(w1)) < 0;
                psum.magnitude(accs[base + psum.size(1)..base + psum.size(1) + psum.size(2)], 2, contents(w2));
                central.limbs_of(n, contents(wn));
                let (mb, mc) = central.ratio_bits(heap, contents(w1), l1, contents(wn), 3, 0 - 1074, neg1);
                mean = float_of_bits(mb);
                if n - ddof >= 1 {
                    // N = n sum(x^2) - sum(x)^2, exact, in units of 2^-2148
                    let a = box_slice(heap, l2 + 5, 0);
                    let b = box_slice(heap, 2 * l1 + 2, 0);
                    borrow mut a as &!aw in {
                        borrow mut b as &!bw in {
                            bigint.mul(contents(aw), contents(w2), l2, contents(wn), 3);
                            bigint.mul(contents(bw), contents(w1), l1, contents(w1), l1);
                            bigint.sub_in(contents(aw), l2 + 5, contents(bw), 2 * l1 + 2);
                            let dl = box_slice(heap, 4, 0);
                            borrow mut dl as &!dw in {
                                central.limbs_of(n * (n - ddof), contents(dw));
                                let (vb, vc) = central.ratio_bits(heap, contents(aw), l2 + 5, contents(dw), 3, 0 - 2148, false);
                                variance = float_of_bits(vb);
                                ok = vc == 0;
                            }
                            unbox_slice(heap, dl);
                        }
                    }
                    unbox_slice(heap, a);
                    unbox_slice(heap, b);
                }
            }
        }
    }
    unbox_slice(heap, s1);
    unbox_slice(heap, s2);
    unbox_slice(heap, nl);
    var sd = 0.0;
    if ok {
        sd = sqrt(variance);
    }
    var skew = 0.0;
    var kurt = 0.0;
    var mok = false;
    if n >= 2 {
        let (sb, sc, kb, kc, st) = central.skew_kurt(heap, accs[base..base + scan.acc_stride()], n);
        if st == 0 && sc == 0 && kc == 0 {
            skew = float_of_bits(sb);
            kurt = float_of_bits(kb);
            mok = true;
        }
    }
    return Stats { mean: mean, variance: variance, sd: sd, variance_ok: ok, skew: skew, kurt: kurt, moments_ok: mok };
}

// ------------------------------------------------------------------------------------------------ the answer

// one probability, a decimal such as 0, 1, .5 or 0.025: (digits as an integer, number of decimals, ok); at most 9 decimals, at most 12 digits, not above 1
fn valid_list[&t](text: &t [byte]) -> [] bool {
    let n = bytes.count_byte(text, ',') + 1;
    if n > 99 {
        return false;
    }
    var i = 0;
    while i < n {
        let (num, k, ok) = cat.parse_p(bytes.field(text, ',', i + 1));
        if !ok {
            return false;
        }
        i = i + 1;
    }
    return true;
}

// the quantiles of column j: its numeric cells gathered from the store, sorted, and each probability of `qtext` answered exactly
fn quantile_list[&h, &sv, &q](heap: &!h Heap, w0: json.Writer, store: &sv vec.Vec[int], rows: int, ncols: int, j: int, n: int, qtype: int, qtext: &q [byte], bins: int) -> [heap] json.Writer {
    var w = w0;
    let keys = box_slice(heap, n + 1, 0);
    let tmp = box_slice(heap, n + 1, 0);
    let cnt = box_slice(heap, 256, 0);
    w = json.put_key(heap, w, "quantiles");
    w = json.begin_array(heap, w);
    borrow mut keys as &!kw in {
        borrow mut tmp as &!tw in {
            borrow mut cnt as &!cw in {
                var r = 0;
                var m = 0;
                while r < rows {
                    let k = vec.get(store, r * ncols + j);
                    if k != rank.min_int() {
                        contents(kw)[m] = k;
                        m = m + 1;
                    }
                    r = r + 1;
                }
                rank.sort_range(contents(kw), contents(tw), contents(cw), 0, m);
                let count = bytes.count_byte(qtext, ',') + 1;
                var i = 0;
                while i < count {
                    let tok = bytes.field(qtext, ',', i + 1);
                    let (num, k, ok) = cat.parse_p(tok);
                    let (bits, code) = quantile.at(heap, contents(kw), m, qtype, num, k);
                    w = json.begin_object(heap, w);
                    w = json.put_key(heap, w, "p");
                    w = json.put_string(heap, w, tok);
                    w = json.put_key(heap, w, "value");
                    w = json.put_float(heap, w, float_of_bits(bits));
                    w = json.end_object(heap, w);
                    i = i + 1;
                }
                w = json.end_array(heap, w);
                // the distinct values: the changes of the sorted keys
                var d = 0;
                var t = 0;
                while t < m {
                    if t == 0 || contents(kw)[t] != contents(kw)[t - 1] {
                        d = d + 1;
                    }
                    t = t + 1;
                }
                w = json.put_key(heap, w, "distinct");
                w = json.put_int(heap, w, d);
                if bins > 0 {
                    let kmin = contents(kw)[0];
                    let kmax = contents(kw)[m - 1];
                    var nb = bins;
                    if kmin == kmax {
                        nb = 1;
                    }
                    w = json.put_key(heap, w, "histogram");
                    w = json.begin_object(heap, w);
                    w = json.put_key(heap, w, "bins");
                    w = json.put_int(heap, w, nb);
                    w = json.put_key(heap, w, "edges");
                    w = json.begin_array(heap, w);
                    var e = 0;
                    while e <= nb {
                        let (eb, ec) = histogram.edge_bits(heap, nb, e, kmin, kmax);
                        w = json.put_float(heap, w, float_of_bits(eb));
                        e = e + 1;
                    }
                    w = json.end_array(heap, w);
                    w = json.put_key(heap, w, "counts");
                    w = json.begin_array(heap, w);
                    var prev = 0;
                    var b = 1;
                    while b <= nb {
                        var upto = m;
                        if b < nb {
                            upto = histogram.below(heap, contents(kw), m, nb, b, kmin, kmax);
                        }
                        w = json.put_int(heap, w, upto - prev);
                        prev = upto;
                        b = b + 1;
                    }
                    w = json.end_array(heap, w);
                    w = json.end_object(heap, w);
                }
            }
        }
    }
    unbox_slice(heap, keys);
    unbox_slice(heap, tmp);
    unbox_slice(heap, cnt);
    return w;
}

// ------------------------------------------------------------------------------------------------ the levels of a text column

// The pairs (column, cell bytes) of every text column, counted: one map whose key is two bytes of column number then the cell, and whose value is the count. `top` holds, for column j and rank r, the entry
// of its r-th most frequent level (-1 when there is none); `distinct` and `capped` are per column.
res struct Levels {
    m: map.Map[int],
    distinct: Box[[int]],
    capped: Box[[int]],
    top: Box[[int]],
    cells: Box[[int]],
}

fn make_levels[&h](heap: &!h Heap, ncols: int, k: int) -> [heap] Levels {
    return Levels { m: map.empty(heap, 64, 0, 7), distinct: box_slice(heap, ncols + 1, 0), capped: box_slice(heap, ncols + 1, 0), top: box_slice(heap, ncols * k + 1, 0 - 1), cells: box_slice(heap, 3 * ncols + 4, 0) };
}

fn drop_levels[&h](heap: &!h Heap, lv: Levels) -> [heap] int {
    let Levels { m, distinct, capped, top, cells } = lv;
    map.drop(heap, m);
    unbox_slice(heap, distinct);
    unbox_slice(heap, capped);
    unbox_slice(heap, top);
    unbox_slice(heap, cells);
    return 0;
}

// Whether entry `a` goes before entry `b`: more frequent first, then the bytes (the column prefix is the same inside one column).
fn precedes[&m](m: &m map.Map[int], a: int, b: int) -> [] bool {
    let ca = map.value_at(m, a);
    let cb = map.value_at(m, b);
    if ca != cb {
        return ca > cb;
    }
    return bytes.compare(map.key_at(m, a), map.key_at(m, b)) < 0;
}

fn column_of[&m](m: &m map.Map[int], e: int) -> [] int {
    let key = map.key_at(m, e);
    return int_of(key[0]) + 256 * int_of(key[1]);
}

// The first `k` levels of every column in `k` passes over the entries: pass r keeps, per column, the entry that goes before all the others that come after the one of rank r - 1.
fn rank_levels[&m, &t, &b](m: &m map.Map[int], ncols: int, k: int, top: &!t [int], best: &!b [int]) -> [] int {
    var r = 0;
    while r < k {
        var j = 0;
        while j < ncols {
            best[j] = 0 - 1;
            j = j + 1;
        }
        var e = 0;
        while e < map.entries(m) {
            if map.is_live(m, e) {
                let col = column_of(m, e);
                var eligible = true;
                if r > 0 {
                    let prev = top[col * k + r - 1];
                    eligible = prev >= 0 && precedes(m, prev, e);
                }
                if eligible && (best[col] < 0 || precedes(m, e, best[col])) {
                    best[col] = e;
                }
            }
            e = e + 1;
        }
        j = 0;
        while j < ncols {
            top[j * k + r] = best[j];
            j = j + 1;
        }
        r = r + 1;
    }
    return 0;
}

// The second pass: the file again, and every non-missing cell of a text column counted. `expected` is the number of data rows the first pass took; a different file is `stats.file-changed`.
fn level_pass[&h, &f, &s, &c, &k, &x](heap: &!h Heap, file: &!f File, shown: &s [byte], cols: &c scan.Cols, sel: &x [int], ncols: int, by: int, key: &k [byte], by_null: bool, expected: int, delim: int, cap: int, k: int, max_levels: int, lv0: Levels, errs: fail.Errors) -> [heap, file_read] (Levels, fail.Errors) {
    let Levels { m, distinct, capped, top, cells } = lv0;
    var mm = m;
    var e = errs;
    var kb = buffer.empty(heap, 64);
    var r = lines.start(heap, cap);
    var going = true;
    var seen_header = false;
    var rows = 0;
    var changed = false;
    while going {
        let (stepped, status) = lines.next(heap, r);
        r = stepped;
        if status == lines.need() {
            r = lines.fill_file(r, file);
        } else if status == lines.done() {
            going = false;
        } else if status == lines.long() {
            changed = true;
            going = false;
        } else {
            borrow r as &rr in {
                let line = lines.text(rr);
                if !seen_header {
                    seen_header = true;
                } else if len(line) > 0 || ncols == 1 {
                    rows = rows + 1;
                    borrow mut cells as &!cw in {
                        let cs = contents(cw);
                        let (n, inside, badq) = reader.fields(line, delim, cs, ncols);
                        var mine = true;
                        if by >= 0 && !inside && !badq && n == ncols {
                            mine = scan.in_group(cs, line, by, key, by_null);
                        }
                        if !mine {
                            rows = rows - 1;
                        } else if inside || badq || n != ncols || rows > expected {
                            changed = true;
                            going = false;
                        } else {
                            let bad = contents(cols.bad);
                            var j = 0;
                            while j < ncols {
                                let from = cs[3 * j];
                                let to = cs[3 * j + 1];
                                if bad[j] == 1 && sel[j] == 1 && !(to == from && cs[3 * j + 2] == 0) {
                                    borrow mut kb as &!kw in {
                                        buffer.clear(kw);
                                    }
                                    kb = buffer.push(heap, kb, byte_of(j % 256));
                                    kb = buffer.push(heap, kb, byte_of(j / 256));
                                    kb = buffer.append(heap, kb, line[from..to]);
                                    borrow kb as &kr in {
                                        let key = buffer.bytes(kr);
                                        var known = false;
                                        var count = 0;
                                        var room = false;
                                        borrow mm as &mr in {
                                            known = map.has(mr, key);
                                            count = map.get(mr, key, 0);
                                            room = map.size(mr) < max_levels;
                                        }
                                        if known || room {
                                            if !known {
                                                borrow mut distinct as &!dw in {
                                                    contents(dw)[j] = contents(dw)[j] + 1;
                                                }
                                            }
                                            mm = map.put(heap, mm, key, count + 1);
                                        } else {
                                            borrow mut capped as &!pw in {
                                                contents(pw)[j] = 1;
                                            }
                                        }
                                    }
                                }
                                j = j + 1;
                            }
                        }
                    }
                }
            }
        }
    }
    var errno = 0;
    borrow r as &rr in {
        errno = lines.failed(rr);
    }
    lines.drop(heap, r);
    buffer.drop(heap, kb);
    if errno != 0 {
        e = fail.io_error(heap, e, errno, false, shown);
    } else if changed || rows != expected {
        e = rule.refuse(heap, e, "stats.file-changed", "the file is not the same on the second pass", "the file was changed while it was read: run the command again on a file that is not being written", "file", shown);
    } else {
        let best = box_slice(heap, ncols + 1, 0);
        borrow mm as &mr in {
            borrow mut top as &!tw in {
                borrow mut best as &!bw in {
                    rank_levels(mr, ncols, k, contents(tw), contents(bw));
                }
            }
        }
        unbox_slice(heap, best);
    }
    return (Levels { m: mm, distinct: distinct, capped: capped, top: top, cells: cells }, e);
}

// `distinct` and the first `k` `levels` of the text column j, or `levels_capped` when the bound of --max-levels stopped the count of it
fn level_list[&h, &lv](heap: &!h Heap, w0: json.Writer, lv: &lv Levels, j: int, k: int) -> [heap] json.Writer {
    var w = w0;
    if contents(lv.capped)[j] == 1 {
        w = json.put_key(heap, w, "distinct");
        w = json.put_null(heap, w);
        w = json.put_key(heap, w, "levels");
        w = json.put_null(heap, w);
        w = json.put_key(heap, w, "levels_capped");
        w = json.put_bool(heap, w, true);
        return w;
    }
    w = json.put_key(heap, w, "distinct");
    w = json.put_int(heap, w, contents(lv.distinct)[j]);
    w = json.put_key(heap, w, "levels");
    w = json.begin_array(heap, w);
    var r = 0;
    while r < k {
        let e = contents(lv.top)[j * k + r];
        if e >= 0 {
            let key = map.key_at(lv.m, e);
            w = json.begin_object(heap, w);
            w = json.put_key(heap, w, "value");
            w = text.put(heap, w, key[2..len(key)]);
            w = json.put_key(heap, w, "count");
            w = json.put_int(heap, w, map.value_at(lv.m, e));
            w = json.end_object(heap, w);
        }
        r = r + 1;
    }
    w = json.end_array(heap, w);
    w = json.put_key(heap, w, "levels_capped");
    w = json.put_bool(heap, w, false);
    return w;
}

fn report_columns[&h, &c, &x, &nm, &en, &sv, &q, &lv](heap: &!h Heap, w0: json.Writer, c: &c scan.Cols, sel: &x [int], names: &nm [byte], ends: &en vec.Vec[int], store: &sv vec.Vec[int], ncols: int, rows: int, ddof: int, qtype: int, qtext: &q [byte], bins: int, lv: &lv Levels, k: int, counted: bool) -> [heap] json.Writer {
    var w = w0;
    w = json.put_key(heap, w, "columns");
    w = json.begin_array(heap, w);
    var j = 0;
    while j < ncols {
        if sel[j] == 1 {
            var from = 0;
            if j > 0 {
                from = vec.get(ends, j - 1);
            }
            let to = vec.get(ends, j);
            w = json.begin_object(heap, w);
            w = json.put_key(heap, w, "name");
            w = json.put_string(heap, w, names[from..to]);
            let nonmiss = contents(c.nonmiss)[j];
            let numeric = contents(c.numeric)[j];
            let bad = contents(c.bad)[j];
            w = json.put_key(heap, w, "kind");
            if nonmiss == 0 {
                w = json.put_string(heap, w, "empty");
            } else if bad == 1 {
                w = json.put_string(heap, w, "text");
            } else {
                w = json.put_string(heap, w, "numeric");
            }
            w = json.put_key(heap, w, "count");
            w = json.put_int(heap, w, nonmiss);
            w = json.put_key(heap, w, "missing");
            w = json.put_int(heap, w, rows - nonmiss);
            if nonmiss > 0 && bad == 0 {
                w = json.put_key(heap, w, "min");
                w = json.put_float(heap, w, contents(c.mn)[j]);
                w = json.put_key(heap, w, "max");
                w = json.put_float(heap, w, contents(c.mx)[j]);
                let s = moments(heap, c, j, ddof);
                w = json.put_key(heap, w, "mean");
                w = json.put_float(heap, w, s.mean);
                w = json.put_key(heap, w, "variance");
                if s.variance_ok {
                    w = json.put_float(heap, w, s.variance);
                } else {
                    w = json.put_null(heap, w);
                }
                w = json.put_key(heap, w, "sd");
                if s.variance_ok {
                    w = json.put_float(heap, w, s.sd);
                } else {
                    w = json.put_null(heap, w);
                }
                w = json.put_key(heap, w, "skewness");
                if s.moments_ok {
                    w = json.put_float(heap, w, s.skew);
                } else {
                    w = json.put_null(heap, w);
                }
                w = json.put_key(heap, w, "kurtosis");
                if s.moments_ok {
                    w = json.put_float(heap, w, s.kurt);
                } else {
                    w = json.put_null(heap, w);
                }
                w = quantile_list(heap, w, store, rows, ncols, j, numeric, qtype, qtext, bins);
            } else if nonmiss > 0 && counted {
                w = level_list(heap, w, lv, j, k);
            }
            w = json.end_object(heap, w);
        }
        j = j + 1;
    }
    w = json.end_array(heap, w);
    return w;
}

// ------------------------------------------------------------------------------------------------ reading the file

// The settings every answer states.
fn put_settings[&h](heap: &!h Heap, w0: json.Writer, ddof: int, qtype: int) -> [heap] json.Writer {
    var w = w0;
    w = json.put_key(heap, w, "ddof");
    w = json.put_int(heap, w, ddof);
    w = json.put_key(heap, w, "quantile_type");
    w = json.put_int(heap, w, qtype);
    w = json.put_key(heap, w, "rounding");
    w = json.put_string(heap, w, "mean, variance, skewness, excess kurtosis, quantiles: exact, rounded once; sd: the square root of the rounded variance, two roundings");
    return w;
}

// ------------------------------------------------------------------------------------------------ the groups of --by

// One description: the file opened and read (only the records of the group when `by` >= 0), the levels of its text columns, and what is written to `w0`: with `as_group` an object of the group, without it the `rows`, the settings and the `columns` of the whole file.
fn describe_one[&h, &g, &p, &f, &r, &sh, &fu, &k](heap: &!h Heap, args: &g Args, parsed: &p cli.Parsed, fs: &f Fs(""), root: &r [byte], rel: &sh [byte], full: &fu [byte], by: int, key: &k [byte], by_null: bool, as_group: bool, w0: json.Writer, errs: fail.Errors) -> [heap, args, fs_read(""), dir_read, file_read] (json.Writer, fail.Errors) {
    let table = flag_table();
    var w = w0;
    var e = errs;
    match place.open_operand(fs, root, rel, full) {
        Opened::Failed(reason) => {
            e = fail.io_error(heap, e, reason, false, rel);
        }
        Opened::Ok(opened) => {
            var file = opened;
            borrow mut file as &!handle in {
                let (names, ends, cols, store, info, e2) = scan.read_file(heap, cli.nat(args, parsed, table, "max-line-bytes"), int_of(cli.text(args, parsed, table, "delim")[0]), cli.nat(args, parsed, table, "max-rows"), cli.nat(args, parsed, table, "max-cols"), cli.nat(args, parsed, table, "max-cells"), handle, rel, by, key, by_null, e);
                e = e2;
                var clean = false;
                borrow e as &er2 in {
                    clean = fail.count(er2) == 0;
                }
                if clean {
                    let k = cli.nat(args, parsed, table, "levels");
                    var lv = make_levels(heap, 1, 1);
                    var counted = false;
                    var any_text = false;
                    let sel = box_slice(heap, info.ncols + 1, 1);
                    var cols_ok = true;
                    if cli.has(parsed, table, "cols") {
                        var st = 0;
                        var item = 0;
                        borrow names as &nb0 in {
                            borrow ends as &eb0 in {
                                borrow mut sel as &!sw0 in {
                                    let (s1, i1) = pick.select(buffer.bytes(nb0), eb0, info.ncols, cli.text(args, parsed, table, "cols"), contents(sw0));
                                    st = s1;
                                    item = i1;
                                }
                            }
                        }
                        let one = bytes.field(cli.text(args, parsed, table, "cols"), ',', item + 1);
                        if st == 1 {
                            cols_ok = false;
                            e = rule.refuse(heap, e, "stats.no-such-column", "--cols names a column the header does not have", "the header names are the first line of the file; the match is exact", "column", one);
                        } else if st == 2 {
                            cols_ok = false;
                            e = rule.refuse(heap, e, "stats.ambiguous-column", "two or more columns have a name given to --cols", "rename the columns so that the name is unique", "column", one);
                        } else if st == 3 {
                            cols_ok = false;
                            e = rule.refuse(heap, e, "args.bad-value", "--cols has an empty item", "--cols name1,name2: no empty item, no leading or trailing comma", "flag", "--cols");
                        }
                    }
                    borrow cols as &c0 in {
                        borrow sel as &sr0 in {
                            var jt = 0;
                            while jt < info.ncols {
                                if contents(c0.nonmiss)[jt] > 0 && contents(c0.bad)[jt] == 1 && contents(sr0)[jt] == 1 {
                                    any_text = true;
                                }
                                jt = jt + 1;
                            }
                        }
                    }
                    if k > 0 && any_text && cols_ok {
                        counted = true;
                        match place.open_operand(fs, root, rel, full) {
                            Opened::Failed(reason) => {
                                e = fail.io_error(heap, e, reason, false, rel);
                            }
                            Opened::Ok(again) => {
                                var file2 = again;
                                borrow mut file2 as &!handle2 in {
                                    borrow cols as &c1 in {
                                        borrow sel as &sr1 in {
                                            let fresh = make_levels(heap, info.ncols, k);
                                            drop_levels(heap, lv);
                                            let (lv2, e4) = level_pass(heap, handle2, rel, c1, contents(sr1), info.ncols, by, key, by_null, info.rows, int_of(cli.text(args, parsed, table, "delim")[0]), cli.nat(args, parsed, table, "max-line-bytes"), k, cli.nat(args, parsed, table, "max-levels"), fresh, e);
                                            lv = lv2;
                                            e = e4;
                                        }
                                    }
                                }
                                file_close(file2);
                            }
                        }
                    }
                    var clean2 = false;
                    borrow e as &er3 in {
                        clean2 = fail.count(er3) == 0;
                    }
                    if clean2 {
                        let ddof = cli.nat(args, parsed, table, "ddof");
                        let qtype = cli.nat(args, parsed, table, "quantile-type");
                        borrow names as &nb in {
                            borrow ends as &eb in {
                                borrow cols as &cb in {
                                    borrow store as &sb in {
                                        borrow sel as &sr2 in {
                                            borrow lv as &lb in {
                                                if as_group {
                                                    w = json.begin_object(heap, w);
                                                    w = json.put_key(heap, w, "value");
                                                    if by_null {
                                                        w = json.put_null(heap, w);
                                                    } else {
                                                        w = text.put(heap, w, key);
                                                    }
                                                    w = json.put_key(heap, w, "rows");
                                                    w = json.put_int(heap, w, info.rows);
                                                } else {
                                                    w = json.put_key(heap, w, "rows");
                                                    w = json.put_int(heap, w, info.rows);
                                                    w = put_settings(heap, w, ddof, qtype);
                                                }
                                                w = report_columns(heap, w, cb, contents(sr2), buffer.bytes(nb), eb, sb, info.ncols, info.rows, ddof, qtype, cli.text(args, parsed, table, "quantiles"), cli.nat(args, parsed, table, "bins"), lb, k, counted);
                                                if as_group {
                                                    w = json.end_object(heap, w);
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    drop_levels(heap, lv);
                    unbox_slice(heap, sel);
                }
                buffer.drop(heap, names);
                vec.drop(heap, ends);
                scan.drop_cols(heap, cols);
                vec.drop(heap, store);
            }
            file_close(file);
        }
    }
    return (w, e);
}

// ------------------------------------------------------------------------------------------------ corr (docs/corr.md)

// The pairs of the numeric columns of one file (or of --cols), Pearson. The same file reader as describe: the order-preserving keys of the cells are in `store`.
fn corr_one[&h, &g, &p, &f, &r, &sh, &fu](heap: &!h Heap, args: &g Args, parsed: &p cli.Parsed, fs: &f Fs(""), root: &r [byte], rel: &sh [byte], full: &fu [byte], ci: bool, w0: json.Writer, errs: fail.Errors) -> [heap, args, fs_read(""), dir_read, file_read] (json.Writer, fail.Errors) {
    let table = flag_table();
    let (lnum, lk, lok) = cat.parse_p(cli.text(args, parsed, table, "level"));
    let level = float_of(lnum) / float_of(quantile.pow10(lk));
    var w = w0;
    var e = errs;
    match place.open_operand(fs, root, rel, full) {
        Opened::Failed(reason) => {
            e = fail.io_error(heap, e, reason, false, rel);
        }
        Opened::Ok(opened) => {
            var file = opened;
            borrow mut file as &!handle in {
                let (names, ends, cols, store, info, e2) = scan.read_file(heap, cli.nat(args, parsed, table, "max-line-bytes"), int_of(cli.text(args, parsed, table, "delim")[0]), cli.nat(args, parsed, table, "max-rows"), cli.nat(args, parsed, table, "max-cols"), cli.nat(args, parsed, table, "max-cells"), handle, rel, 0 - 1, "", false, e);
                e = e2;
                var clean = false;
                borrow e as &er2 in {
                    clean = fail.count(er2) == 0;
                }
                if clean {
                    let nc = info.ncols;
                    let sel = box_slice(heap, nc + 1, 0);
                    var cols_ok = true;
                    var named = false;
                    if cli.has(parsed, table, "cols") {
                        named = true;
                        var st = 0;
                        var item = 0;
                        borrow names as &nb0 in {
                            borrow ends as &eb0 in {
                                borrow mut sel as &!sw0 in {
                                    let (s1, i1) = pick.select(buffer.bytes(nb0), eb0, nc, cli.text(args, parsed, table, "cols"), contents(sw0));
                                    st = s1;
                                    item = i1;
                                }
                            }
                        }
                        let one = bytes.field(cli.text(args, parsed, table, "cols"), ',', item + 1);
                        if st == 1 {
                            cols_ok = false;
                            e = rule.refuse(heap, e, "stats.no-such-column", "--cols names a column the header does not have", "the header names are the first line of the file; the match is exact", "column", one);
                        } else if st == 2 {
                            cols_ok = false;
                            e = rule.refuse(heap, e, "stats.ambiguous-column", "two or more columns have a name given to --cols", "rename the columns so that the name is unique", "column", one);
                        } else if st == 3 {
                            cols_ok = false;
                            e = rule.refuse(heap, e, "args.bad-value", "--cols has an empty item", "--cols name1,name2: no empty item, no leading or trailing comma", "flag", "--cols");
                        }
                    }
                    var m = 0;
                    if cols_ok {
                        borrow cols as &c0 in {
                            borrow mut sel as &!sw1 in {
                                var j = 0;
                                while j < nc {
                                    let numeric = contents(c0.numeric)[j] > 0 && contents(c0.bad)[j] == 0;
                                    if !named {
                                        if numeric {
                                            contents(sw1)[j] = 1;
                                        }
                                    } else if contents(sw1)[j] == 1 && !numeric && cols_ok {
                                        cols_ok = false;
                                        borrow names as &nb1 in {
                                            borrow ends as &eb1 in {
                                                var from = 0;
                                                if j > 0 {
                                                    from = vec.get(eb1, j - 1);
                                                }
                                                e = rule.refuse(heap, e, "stats.non-numeric", "--cols names a column that has no numbers or has a cell that is not a number", "name numeric columns only", "column", buffer.bytes(nb1)[from..vec.get(eb1, j)]);
                                            }
                                        }
                                    }
                                    j = j + 1;
                                }
                                j = 0;
                                while j < nc {
                                    if contents(sw1)[j] == 1 {
                                        m = m + 1;
                                    }
                                    j = j + 1;
                                }
                            }
                        }
                    }
                    if cols_ok && m < 2 {
                        cols_ok = false;
                        e = rule.refuse_int(heap, e, "stats.corr-columns", "fewer than two numeric columns to correlate", "name two or more numeric columns with --cols", "columns", m, "line", 0);
                    }
                    let pairs = m * (m - 1) / 2;
                    if cols_ok && pairs > cli.nat(args, parsed, table, "max-pairs") {
                        cols_ok = false;
                        e = rule.refuse_int(heap, e, "limit.too-many-pairs", "more pairs of columns than --max-pairs", "raise --max-pairs or name fewer columns with --cols", "limit", cli.nat(args, parsed, table, "max-pairs"), "pairs", pairs);
                    }
                    if cols_ok {
                        let idx = box_slice(heap, m + 1, 0);
                        let mask = box_slice(heap, info.rows + 1, 1);
                        let listwise = bytes.equal(cli.text(args, parsed, table, "missing"), "listwise");
                        borrow sel as &sr in {
                            borrow mut idx as &!iw in {
                                var j = 0;
                                var at = 0;
                                while j < nc {
                                    if contents(sr)[j] == 1 {
                                        contents(iw)[at] = j;
                                        at = at + 1;
                                    }
                                    j = j + 1;
                                }
                            }
                        }
                        borrow store as &sb in {
                            borrow idx as &ir in {
                                borrow mut mask as &!mw in {
                                    if listwise {
                                        var i = 0;
                                        while i < info.rows {
                                            var k = 0;
                                            while k < m {
                                                if vec.get(sb, i * nc + contents(ir)[k]) == rank.min_int() {
                                                    contents(mw)[i] = 0;
                                                }
                                                k = k + 1;
                                            }
                                            i = i + 1;
                                        }
                                    }
                                }
                                borrow mask as &mr in {
                                    borrow names as &nb in {
                                        borrow ends as &eb in {
                                            if ci {
                                                w = json.put_key(heap, w, "ci");
                                                w = json.put_string(heap, w, "corr");
                                            }
                                            w = json.put_key(heap, w, "rows");
                                            w = json.put_int(heap, w, info.rows);
                                            if ci {
                                                w = json.put_key(heap, w, "level");
                                                w = json.put_float(heap, w, level);
                                            }
                                            w = json.put_key(heap, w, "method");
                                            w = json.put_string(heap, w, cli.text(args, parsed, table, "method"));
                                            w = json.put_key(heap, w, "missing");
                                            w = json.put_string(heap, w, cli.text(args, parsed, table, "missing"));
                                            if !ci {
                                                w = json.put_key(heap, w, "adjustment");
                                                w = json.put_string(heap, w, "none");
                                            }
                                            w = json.put_key(heap, w, "columns");
                                            w = json.begin_array(heap, w);
                                            var k = 0;
                                            while k < m {
                                                w = answer.put_name(heap, w, buffer.bytes(nb), eb, contents(ir)[k]);
                                                k = k + 1;
                                            }
                                            w = json.end_array(heap, w);
                                            if ci {
                                                w = json.put_key(heap, w, "intervals");
                                            } else {
                                                w = json.put_key(heap, w, "pairs");
                                            }
                                            w = json.begin_array(heap, w);
                                            var method = 0;
                                            if bytes.equal(cli.text(args, parsed, table, "method"), "spearman") {
                                                method = 1;
                                            } else if bytes.equal(cli.text(args, parsed, table, "method"), "kendall") {
                                                method = 2;
                                            }
                                            var exact_mode = 0;
                                            if bytes.equal(cli.text(args, parsed, table, "exact"), "yes") {
                                                exact_mode = 2;
                                            } else if bytes.equal(cli.text(args, parsed, table, "exact"), "auto") && cli.has(parsed, table, "exact") {
                                                exact_mode = 1;
                                            }
                                            var unavailable_pairs = 0;
                                            var ia = 0;
                                            while ia < m {
                                                var ib = ia + 1;
                                                while ib < m {
                                                    if ci {
                                                        w = answerci.put_corr(heap, w, buffer.bytes(nb), eb, sb, nc, contents(ir)[ia], contents(ir)[ib], info.rows, contents(mr), lnum, lk, level);
                                                    } else if method == 2 {
                                                        let (w3, no_exact) = answer.put_pair_kendall(heap, w, buffer.bytes(nb), eb, sb, nc, contents(ir)[ia], contents(ir)[ib], info.rows, contents(mr), exact_mode);
                                                        w = w3;
                                                        if no_exact {
                                                            unavailable_pairs = unavailable_pairs + 1;
                                                        }
                                                    } else {
                                                        w = answer.put_pair(heap, w, buffer.bytes(nb), eb, sb, nc, contents(ir)[ia], contents(ir)[ib], info.rows, contents(mr), method);
                                                    }
                                                    ib = ib + 1;
                                                }
                                                ia = ia + 1;
                                            }
                                            w = json.end_array(heap, w);
                                            if unavailable_pairs > 0 {
                                                e = rule.refuse_int(heap, e, "stats.exact-unavailable", "--exact yes, but the exact p-value of Kendall's tau is available only with no ties in either column and for at most 60 rows", "use --exact auto, or --exact no for the normal approximation", "pairs", unavailable_pairs, "limit", 60);
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        unbox_slice(heap, idx);
                        unbox_slice(heap, mask);
                    }
                    unbox_slice(heap, sel);
                }
                buffer.drop(heap, names);
                vec.drop(heap, ends);
                scan.drop_cols(heap, cols);
                vec.drop(heap, store);
            }
            file_close(file);
        }
    }
    return (w, e);
}

// ------------------------------------------------------------------------------------------------ test (docs/test.md)

// The tests of the columns named by --cols (kind t1) or of the pairs named by --pairs (kind paired) (docs/test.md). The same file reader as describe and corr.
fn test_one[&h, &g, &p, &f, &r, &sh, &fu](heap: &!h Heap, args: &g Args, parsed: &p cli.Parsed, fs: &f Fs(""), root: &r [byte], rel: &sh [byte], full: &fu [byte], paired: bool, wil: bool, ci: bool, w0: json.Writer, errs: fail.Errors) -> [heap, args, fs_read(""), dir_read, file_read] (json.Writer, fail.Errors) {
    var hkey = "test";
    var rkey = "tests";
    if ci {
        hkey = "ci";
        rkey = "intervals";
    }
    let table = flag_table();
    var w = w0;
    var e = errs;
    match place.open_operand(fs, root, rel, full) {
        Opened::Failed(reason) => {
            e = fail.io_error(heap, e, reason, false, rel);
        }
        Opened::Ok(opened) => {
            var file = opened;
            borrow mut file as &!handle in {
                let (names, ends, cols, store, info, e2) = scan.read_file(heap, cli.nat(args, parsed, table, "max-line-bytes"), int_of(cli.text(args, parsed, table, "delim")[0]), cli.nat(args, parsed, table, "max-rows"), cli.nat(args, parsed, table, "max-cols"), cli.nat(args, parsed, table, "max-cells"), handle, rel, 0 - 1, "", false, e);
                e = e2;
                var clean = false;
                borrow e as &er2 in {
                    clean = fail.count(er2) == 0;
                }
                if clean {
                    let nc = info.ncols;
                    let sel = box_slice(heap, nc + 1, 0);
                    let npairs = bytes.count_byte(cli.text(args, parsed, table, "pairs"), ',') + 1;
                    let pa = box_slice(heap, npairs + 1, 0);
                    let pb = box_slice(heap, npairs + 1, 0);
                    var cols_ok = true;
                    var st = 0;
                    var item = 0;
                    if paired && npairs > cli.nat(args, parsed, table, "max-pairs") {
                        cols_ok = false;
                        e = rule.refuse_int(heap, e, "limit.too-many-pairs", "more pairs than --max-pairs", "raise --max-pairs or name fewer pairs", "limit", cli.nat(args, parsed, table, "max-pairs"), "pairs", npairs);
                    } else {
                        borrow names as &nb0 in {
                            borrow ends as &eb0 in {
                                borrow mut sel as &!sw0 in {
                                    borrow mut pa as &!paw in {
                                        borrow mut pb as &!pbw in {
                                            if paired {
                                                let (s1, i1) = pick.pairs(buffer.bytes(nb0), eb0, nc, cli.text(args, parsed, table, "pairs"), contents(paw), contents(pbw));
                                                st = s1;
                                                item = i1;
                                                var k = 0;
                                                while st == 0 && k < npairs {
                                                    contents(sw0)[contents(paw)[k]] = 1;
                                                    contents(sw0)[contents(pbw)[k]] = 1;
                                                    k = k + 1;
                                                }
                                            } else {
                                                let (s1, i1) = pick.select(buffer.bytes(nb0), eb0, nc, cli.text(args, parsed, table, "cols"), contents(sw0));
                                                st = s1;
                                                item = i1;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    if st != 0 {
                        cols_ok = false;
                        if paired {
                            e = rule.refuse_pick(heap, e, st, bytes.field(cli.text(args, parsed, table, "pairs"), ',', item + 1), true);
                        } else {
                            e = rule.refuse_pick(heap, e, st, bytes.field(cli.text(args, parsed, table, "cols"), ',', item + 1), false);
                        }
                    }
                    if cols_ok {
                        borrow cols as &c0 in {
                            borrow sel as &sr in {
                                borrow names as &nb1 in {
                                    borrow ends as &eb1 in {
                                        e = pick.check_numeric(heap, nb1, eb1, contents(sr), nc, contents(c0.numeric), contents(c0.bad), contents(c0.numeric), contents(c0.bad), e);
                                    }
                                }
                            }
                        }
                        borrow e as &er3 in {
                            cols_ok = fail.count(er3) == 0;
                        }
                    }
                    var zmode = 0;
                    var xmode = 0;
                    var cmode = 1;
                    if bytes.equal(cli.text(args, parsed, table, "zeros"), "pratt") {
                        zmode = 1;
                    } else if bytes.equal(cli.text(args, parsed, table, "zeros"), "zsplit") {
                        zmode = 2;
                    }
                    if bytes.equal(cli.text(args, parsed, table, "exact"), "yes") {
                        xmode = 1;
                    } else if bytes.equal(cli.text(args, parsed, table, "exact"), "no") {
                        xmode = 2;
                    }
                    if bytes.equal(cli.text(args, parsed, table, "continuity"), "none") {
                        cmode = 0;
                    }
                    if cols_ok && wil && xmode == 1 {
                        let (mkey0, mst0) = flt.parse_float(cli.text(args, parsed, table, "mu0"));
                        let mu00 = flt.float_of_key(mkey0);
                        var bad_name = 0 - 1;
                        var bad_other = 0 - 1;
                        borrow store as &sb0 in {
                            borrow sel as &sr0 in {
                                borrow pa as &par0 in {
                                    borrow pb as &pbr0 in {
                                        if paired {
                                            var k = 0;
                                            while k < npairs && bad_name < 0 {
                                                if !answer8.exact_ok(heap, sb0, nc, contents(par0)[k], contents(pbr0)[k], info.rows, 0.0, zmode, cmode) {
                                                    bad_name = contents(par0)[k];
                                                    bad_other = contents(pbr0)[k];
                                                }
                                                k = k + 1;
                                            }
                                        } else {
                                            var j = 0;
                                            while j < nc && bad_name < 0 {
                                                if contents(sr0)[j] == 1 && !answer8.exact_ok(heap, sb0, nc, j, 0 - 1, info.rows, mu00, zmode, cmode) {
                                                    bad_name = j;
                                                }
                                                j = j + 1;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        if bad_name >= 0 {
                            cols_ok = false;
                            var from = 0;
                            if bad_name > 0 {
                                borrow ends as &eb10 in {
                                    from = vec.get(eb10, bad_name - 1);
                                }
                            }
                            borrow names as &nb9 in {
                                borrow ends as &eb9 in {
                                    e = rule.refuse(heap, e, "stats.exact-unavailable", "--exact yes, but the exact p-value is available only with no ties, no zero difference ranked and at most 50 nonzero differences", "use --exact auto, or --exact no for the normal approximation", "column", buffer.bytes(nb9)[from..vec.get(eb9, bad_name)]);
                                }
                            }
                        }
                    }
                    if cols_ok {
                        let (mkey, mst) = flt.parse_float(cli.text(args, parsed, table, "mu0"));
                        let mu0 = flt.float_of_key(mkey);
                        let (lnum, lk, lok) = cat.parse_p(cli.text(args, parsed, table, "level"));
                        let level = float_of(lnum) / float_of(quantile.pow10(lk));
                        borrow store as &sb in {
                            borrow sel as &sr3 in {
                                borrow pa as &par in {
                                    borrow pb as &pbr in {
                                        borrow names as &nb in {
                                            borrow ends as &eb in {
                                                w = json.put_key(heap, w, hkey);
                                                if ci {
                                                    w = json.put_string(heap, w, "mean");
                                                } else if wil {
                                                    w = json.put_string(heap, w, "wilcoxon");
                                                } else if paired {
                                                    w = json.put_string(heap, w, "paired");
                                                } else {
                                                    w = json.put_string(heap, w, "t1");
                                                }
                                                w = json.put_key(heap, w, "rows");
                                                w = json.put_int(heap, w, info.rows);
                                                if !paired && !ci {
                                                    w = json.put_key(heap, w, "mu0");
                                                    w = json.put_float(heap, w, mu0);
                                                }
                                                if !wil {
                                                    w = json.put_key(heap, w, "level");
                                                    w = json.put_float(heap, w, level);
                                                }
                                                if !ci {
                                                    w = cat.put_adjustment(heap, w, cli.text(args, parsed, table, "correct"));
                                                }
                                                w = json.put_key(heap, w, rkey);
                                                w = json.begin_array(heap, w);
                                                if paired {
                                                    var k = 0;
                                                    while k < npairs {
                                                        if wil {
                                                            w = answer8.put_wilcoxon(heap, w, buffer.bytes(nb), eb, sb, nc, contents(par)[k], contents(pbr)[k], info.rows, 0.0, zmode, xmode, cmode);
                                                        } else if ci {
                                                            w = answerci.put_mean(heap, w, buffer.bytes(nb), eb, sb, nc, contents(par)[k], contents(pbr)[k], info.rows, lnum, lk, level);
                                                        } else {
                                                            w = answer.put_t1(heap, w, buffer.bytes(nb), eb, sb, nc, contents(par)[k], contents(pbr)[k], info.rows, 0, lnum, lk, level);
                                                        }
                                                        k = k + 1;
                                                    }
                                                } else {
                                                    var j = 0;
                                                    while j < nc {
                                                        if contents(sr3)[j] == 1 {
                                                            if wil {
                                                                w = answer8.put_wilcoxon(heap, w, buffer.bytes(nb), eb, sb, nc, j, 0 - 1, info.rows, mu0, zmode, xmode, cmode);
                                                            } else if ci {
                                                                w = answerci.put_mean(heap, w, buffer.bytes(nb), eb, sb, nc, j, 0 - 1, info.rows, lnum, lk, level);
                                                            } else {
                                                                w = answer.put_t1(heap, w, buffer.bytes(nb), eb, sb, nc, j, 0 - 1, info.rows, bits_of(mu0), lnum, lk, level);
                                                            }
                                                        }
                                                        j = j + 1;
                                                    }
                                                }
                                                w = json.end_array(heap, w);
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    unbox_slice(heap, sel);
                    unbox_slice(heap, pa);
                    unbox_slice(heap, pb);
                }
                buffer.drop(heap, names);
                vec.drop(heap, ends);
                scan.drop_cols(heap, cols);
                vec.drop(heap, store);
            }
            file_close(file);
        }
    }
    return (w, e);
}

// The tests of the columns named by --cols between the two groups of the column named by --group, kind t2 (docs/test.md). Pass 0 finds the levels of the group column (exactly two, else stats.group-levels);
// then the file is read once for each, the group a being the level that is first by its bytes.
fn t2_one[&h, &g, &p, &f, &r, &sh, &fu](heap: &!h Heap, args: &g Args, parsed: &p cli.Parsed, fs: &f Fs(""), root: &r [byte], rel: &sh [byte], full: &fu [byte], ci: bool, w0: json.Writer, errs: fail.Errors) -> [heap, args, fs_read(""), dir_read, file_read] (json.Writer, fail.Errors) {
    var hkey = "test";
    var rkey = "tests";
    if ci {
        hkey = "ci";
        rkey = "intervals";
    }
    var tname = "t2";
    if ci {
        tname = "diff";
    }
    let table = flag_table();
    var w = w0;
    var e = errs;
    match place.open_operand(fs, root, rel, full) {
        Opened::Failed(reason) => {
            e = fail.io_error(heap, e, reason, false, rel);
        }
        Opened::Ok(opened) => {
            var file = opened;
            borrow mut file as &!handle in {
                let (groups, by, e1) = scan.discover(heap, handle, rel, cli.text(args, parsed, table, "group"), int_of(cli.text(args, parsed, table, "delim")[0]), cli.nat(args, parsed, table, "max-line-bytes"), cli.nat(args, parsed, table, "max-rows"), cli.nat(args, parsed, table, "max-cols"), cli.nat(args, parsed, table, "max-groups"), e);
                e = e1;
                var clean = false;
                borrow e as &er1 in {
                    clean = fail.count(er1) == 0;
                }
                borrow groups as &gr in {
                    let nlevels = map.size(gr.m);
                    if clean && nlevels != 2 {
                        clean = false;
                        e = rule.refuse_int(heap, e, "stats.group-levels", "--group names a column that does not have exactly two levels", "give --group a column with two levels, or filter the file to two of them", "levels", nlevels, "missing", gr.nulls);
                    }
                    if clean {
                        let key_a = map.key_at(gr.m, contents(gr.order)[0]);
                        let key_b = map.key_at(gr.m, contents(gr.order)[1]);
                        let (names, ends, cols_a, store_a, info_a, e2) = run.read_group(heap, args, parsed, fs, root, rel, full, table, by, key_a, e);
                        let (names_b, ends_b, cols_b, store_b, info_b, e3) = run.read_group(heap, args, parsed, fs, root, rel, full, table, by, key_b, e2);
                        e = e3;
                        borrow e as &er2 in {
                            clean = fail.count(er2) == 0;
                        }
                        if clean {
                            let nc = info_a.ncols;
                            let sel = box_slice(heap, nc + 1, 0);
                            var st = 0;
                            var item = 0;
                            borrow names as &nb0 in {
                                borrow ends as &eb0 in {
                                    borrow mut sel as &!sw0 in {
                                        let (s1, i1) = pick.select(buffer.bytes(nb0), eb0, nc, cli.text(args, parsed, table, "cols"), contents(sw0));
                                        st = s1;
                                        item = i1;
                                    }
                                }
                            }
                            if st != 0 {
                                clean = false;
                                e = rule.refuse_pick(heap, e, st, bytes.field(cli.text(args, parsed, table, "cols"), ',', item + 1), false);
                            }
                            if clean {
                                borrow cols_a as &ca in {
                                    borrow cols_b as &cb in {
                                        borrow sel as &sr in {
                                            borrow names as &nb1 in {
                                                borrow ends as &eb1 in {
                                                    e = pick.check_numeric(heap, nb1, eb1, contents(sr), nc, contents(ca.numeric), contents(ca.bad), contents(cb.numeric), contents(cb.bad), e);
                                                }
                                            }
                                        }
                                    }
                                }
                                borrow e as &er3 in {
                                    clean = fail.count(er3) == 0;
                                }
                            }
                            if clean {
                                let (lnum, lk, lok) = cat.parse_p(cli.text(args, parsed, table, "level"));
                                let level = float_of(lnum) / float_of(quantile.pow10(lk));
                                let pooled = bytes.equal(cli.text(args, parsed, table, "variance"), "pooled");
                                borrow store_a as &sa in {
                                    borrow store_b as &sb in {
                                        borrow sel as &sr3 in {
                                            borrow names as &nb in {
                                                borrow ends as &eb in {
                                                    w = json.put_key(heap, w, hkey);
                                                    w = json.put_string(heap, w, tname);
                                                    w = json.put_key(heap, w, "group");
                                                    w = json.put_string(heap, w, cli.text(args, parsed, table, "group"));
                                                    w = json.put_key(heap, w, "levels");
                                                    w = json.begin_object(heap, w);
                                                    w = json.put_key(heap, w, "a");
                                                    w = json.put_string(heap, w, key_a);
                                                    w = json.put_key(heap, w, "b");
                                                    w = json.put_string(heap, w, key_b);
                                                    w = json.end_object(heap, w);
                                                    w = json.put_key(heap, w, "rows");
                                                    w = json.put_int(heap, w, info_a.rows + info_b.rows + gr.nulls);
                                                    w = json.put_key(heap, w, "level");
                                                    w = json.put_float(heap, w, level);
                                                    w = json.put_key(heap, w, "variance");
                                                    if pooled {
                                                        w = json.put_string(heap, w, "pooled");
                                                    } else {
                                                        w = json.put_string(heap, w, "welch");
                                                    }
                                                    if !ci {
                                                        w = cat.put_adjustment(heap, w, cli.text(args, parsed, table, "correct"));
                                                    }
                                                    w = json.put_key(heap, w, rkey);
                                                    w = json.begin_array(heap, w);
                                                    var j = 0;
                                                    while j < nc {
                                                        if contents(sr3)[j] == 1 {
                                                            if ci {
                                                                w = answerci.put_diff(heap, w, buffer.bytes(nb), eb, sa, info_a.rows, sb, info_b.rows, nc, j, pooled, lnum, lk, level);
                                                            } else {
                                                                w = answer2.put_t2(heap, w, buffer.bytes(nb), eb, sa, info_a.rows, sb, info_b.rows, nc, j, pooled, lnum, lk, level);
                                                            }
                                                        }
                                                        j = j + 1;
                                                    }
                                                    w = json.end_array(heap, w);
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                            unbox_slice(heap, sel);
                        }
                        buffer.drop(heap, names);
                        vec.drop(heap, ends);
                        scan.drop_cols(heap, cols_a);
                        vec.drop(heap, store_a);
                        buffer.drop(heap, names_b);
                        vec.drop(heap, ends_b);
                        scan.drop_cols(heap, cols_b);
                        vec.drop(heap, store_b);
                    }
                }
                scan.drop_groups(heap, groups);
            }
            file_close(file);
        }
    }
    return (w, e);
}

// the header's "adjustment": the correction that was asked for (none, bonferroni, holm or bh)
fn body[&h, &g, &p, &f, &i](heap: &!h Heap, args: &g Args, parsed: &p cli.Parsed, fs: &f Fs(""), io: &!i Io, errs: fail.Errors) -> [heap, args, fs_read(""), dir_read, file_read, io_write, err_write] int {
    let table = flag_table();
    var e = errs;
    var is_test = false;
    var is_ci = false;
    var is_resample = false;
    var fidx = 1;
    if cli.operand_count(parsed) == 0 {
        e = rule.refuse(heap, e, "args.missing-operand", "no verb: the first operand names what to do", "stats describe FILE", "", "");
    } else if !bytes.equal(cli.operand(args, parsed, 0), "describe") && !bytes.equal(cli.operand(args, parsed, 0), "corr") && !bytes.equal(cli.operand(args, parsed, 0), "test") && !bytes.equal(cli.operand(args, parsed, 0), "ci") && !bytes.equal(cli.operand(args, parsed, 0), "resample") {
        e = rule.refuse(heap, e, "stats.bad-verb", "the first operand is not a verb this tool has", "the verbs are: describe, corr, test, ci, resample", "verb", cli.operand(args, parsed, 0));
    } else if bytes.equal(cli.operand(args, parsed, 0), "ci") {
        is_ci = true;
        fidx = 2;
        if cli.operand_count(parsed) < 2 {
            e = rule.refuse(heap, e, "args.missing-operand", "no kind of interval: the second operand names it", "stats ci prop --cols A --success yes FILE", "", "");
        } else if !bytes.equal(cli.operand(args, parsed, 1), "prop") && !bytes.equal(cli.operand(args, parsed, 1), "mean") && !bytes.equal(cli.operand(args, parsed, 1), "diff") && !bytes.equal(cli.operand(args, parsed, 1), "corr") && !bytes.equal(cli.operand(args, parsed, 1), "boot") {
            e = rule.refuse(heap, e, "args.bad-value", "the kind of interval is not one this tool has", "the kinds so far are: prop, mean, diff, corr, boot", "kind", cli.operand(args, parsed, 1));
        } else if cli.operand_count(parsed) != 3 {
            e = rule.refuse(heap, e, "args.missing-operand", "ci names one kind and one FILE", "stats ci prop --cols A --success yes FILE", "", "");
        }
        if cli.operand_count(parsed) >= 2 && bytes.equal(cli.operand(args, parsed, 1), "prop") && (!cli.has(parsed, table, "cols") || !cli.has(parsed, table, "success")) {
            e = rule.refuse(heap, e, "stats.test-columns", "ci prop needs --cols and --success", "stats ci prop --cols A --success yes FILE", "flag", "--cols");
        } else if cli.operand_count(parsed) >= 2 && bytes.equal(cli.operand(args, parsed, 1), "mean") && !cli.has(parsed, table, "cols") && !cli.has(parsed, table, "pairs") {
            e = rule.refuse(heap, e, "stats.test-columns", "ci mean needs --cols (the mean of each) or --pairs (the mean of the differences)", "stats ci mean --cols A,B FILE, or --pairs A:B", "flag", "--cols");
        } else if cli.operand_count(parsed) >= 2 && bytes.equal(cli.operand(args, parsed, 1), "diff") && (!cli.has(parsed, table, "cols") || !cli.has(parsed, table, "group")) {
            e = rule.refuse(heap, e, "stats.test-columns", "ci diff needs --cols and --group", "stats ci diff --cols A,B --group G FILE", "flag", "--cols");
        } else if cli.operand_count(parsed) >= 2 && bytes.equal(cli.operand(args, parsed, 1), "boot") && !cli.has(parsed, table, "cols") {
            e = rule.refuse(heap, e, "stats.test-columns", "ci boot needs --cols and --seed", "stats ci boot --cols A,B --seed 1 FILE", "flag", "--cols");
        }
    } else if bytes.equal(cli.operand(args, parsed, 0), "resample") {
        is_resample = true;
        fidx = 2;
        if cli.operand_count(parsed) < 2 {
            e = rule.refuse(heap, e, "args.missing-operand", "no kind of resampling: the second operand names it", "stats resample perm --cols A --group G --seed 1 FILE", "", "");
        } else if !bytes.equal(cli.operand(args, parsed, 1), "perm") {
            e = rule.refuse(heap, e, "args.bad-value", "the kind of resampling is not one this tool has", "the kinds so far are: perm", "kind", cli.operand(args, parsed, 1));
        } else if cli.operand_count(parsed) != 3 {
            e = rule.refuse(heap, e, "args.missing-operand", "resample names one kind and one FILE", "stats resample perm --cols A --group G --seed 1 FILE", "", "");
        } else if !cli.has(parsed, table, "cols") || !cli.has(parsed, table, "group") {
            e = rule.refuse(heap, e, "stats.test-columns", "resample perm needs --cols and --group", "stats resample perm --cols A,B --group G --seed 1 FILE", "flag", "--cols");
        }
    } else if bytes.equal(cli.operand(args, parsed, 0), "test") {
        is_test = true;
        fidx = 2;
        if cli.operand_count(parsed) < 2 {
            e = rule.refuse(heap, e, "args.missing-operand", "no kind of test: the second operand names it", "stats test t1 --cols A,B FILE", "", "");
        } else if !bytes.equal(cli.operand(args, parsed, 1), "t1") && !bytes.equal(cli.operand(args, parsed, 1), "t2") && !bytes.equal(cli.operand(args, parsed, 1), "paired") && !bytes.equal(cli.operand(args, parsed, 1), "chisq") && !bytes.equal(cli.operand(args, parsed, 1), "prop") && !bytes.equal(cli.operand(args, parsed, 1), "anova") && !bytes.equal(cli.operand(args, parsed, 1), "kruskal") && !bytes.equal(cli.operand(args, parsed, 1), "mannwhitney") && !bytes.equal(cli.operand(args, parsed, 1), "wilcoxon") && !bytes.equal(cli.operand(args, parsed, 1), "ks") && !bytes.equal(cli.operand(args, parsed, 1), "fisher") {
            e = rule.refuse(heap, e, "args.bad-value", "the kind of test is not one this tool has", "the kinds so far are: t1, t2, paired, chisq, prop, anova, kruskal, mannwhitney, wilcoxon, ks, fisher", "kind", cli.operand(args, parsed, 1));
        } else if cli.operand_count(parsed) < 3 {
            e = rule.refuse(heap, e, "args.missing-operand", "no FILE to test", "stats test t1 --cols A,B FILE", "", "");
        } else if cli.operand_count(parsed) > 3 {
            e = rule.refuse(heap, e, "args.too-many-operands", "one FILE only", "test one file per call", "", "");
        }
        if cli.operand_count(parsed) >= 2 && bytes.equal(cli.operand(args, parsed, 1), "wilcoxon") {
            if cli.has(parsed, table, "pairs") == cli.has(parsed, table, "cols") {
                e = rule.refuse(heap, e, "stats.test-columns", "wilcoxon needs exactly one of --pairs (the differences of two columns) and --cols (the differences from --mu0)", "stats test wilcoxon --pairs A:B FILE, or --cols A --mu0 0 FILE", "flag", "--pairs");
            }
        } else if cli.operand_count(parsed) >= 2 && bytes.equal(cli.operand(args, parsed, 1), "paired") {
            if !cli.has(parsed, table, "pairs") {
                e = rule.refuse(heap, e, "stats.test-columns", "paired names no pair of columns: --pairs is required", "stats test paired --pairs A:B,C:D FILE", "flag", "--pairs");
            }
        } else if !cli.has(parsed, table, "cols") {
            e = rule.refuse(heap, e, "stats.test-columns", "test names no column: --cols is required", "stats test t1 --cols A,B FILE", "flag", "--cols");
        }
        if cli.operand_count(parsed) >= 2 && bytes.equal(cli.operand(args, parsed, 1), "chisq") && cli.has(parsed, table, "vs") == cli.has(parsed, table, "expected") {
            e = rule.refuse(heap, e, "stats.test-columns", "chisq needs exactly one of --vs (independence) and --expected (goodness of fit)", "stats test chisq --cols A --vs G FILE, or --cols A --expected 0.5,0.5 FILE", "flag", "--vs");
        }
        if cli.operand_count(parsed) >= 2 && bytes.equal(cli.operand(args, parsed, 1), "fisher") && !cli.has(parsed, table, "vs") {
            e = rule.refuse(heap, e, "stats.test-columns", "fisher names no second column: --vs is required", "stats test fisher --cols A --vs G FILE", "flag", "--vs");
        }
        if cli.operand_count(parsed) >= 2 && bytes.equal(cli.operand(args, parsed, 1), "prop") {
            if !cli.has(parsed, table, "success") {
                e = rule.refuse(heap, e, "stats.test-columns", "prop names no success value: --success is required", "stats test prop --cols A --success yes FILE", "flag", "--success");
            }
            let (p0n, p0k, p0ok) = cat.parse_p(cli.text(args, parsed, table, "p0"));
            if !p0ok || p0n == 0 || p0n >= quantile.pow10(p0k) {
                e = rule.refuse(heap, e, "args.bad-value", "--p0 is a decimal strictly between 0 and 1 with at most 9 decimals", "--p0 0.5", "flag", "--p0");
            }
            if cli.has(parsed, table, "group") && cli.has(parsed, table, "p0") {
                e = rule.refuse(heap, e, "args.bad-value", "--p0 and --group do not go together: the two-sample test has no null value", "drop --p0, or drop --group", "flag", "--p0");
            }
        }
        if cli.operand_count(parsed) >= 2 && bytes.equal(cli.operand(args, parsed, 1), "t2") && !cli.has(parsed, table, "group") {
            e = rule.refuse(heap, e, "stats.test-columns", "t2 names no group column: --group is required", "stats test t2 --cols A,B --group G FILE", "flag", "--group");
        }
        if cli.operand_count(parsed) >= 2 && bytes.equal(cli.operand(args, parsed, 1), "anova") && !cli.has(parsed, table, "group") {
            e = rule.refuse(heap, e, "stats.test-columns", "anova names no group column: --group is required", "stats test anova --cols A,B --group G FILE", "flag", "--group");
        }
        if cli.operand_count(parsed) >= 2 && bytes.equal(cli.operand(args, parsed, 1), "mannwhitney") && !cli.has(parsed, table, "group") {
            e = rule.refuse(heap, e, "stats.test-columns", "mannwhitney names no group column: --group is required", "stats test mannwhitney --cols A,B --group G FILE", "flag", "--group");
        }
        if cli.operand_count(parsed) >= 2 && bytes.equal(cli.operand(args, parsed, 1), "ks") && !cli.has(parsed, table, "group") {
            e = rule.refuse(heap, e, "stats.test-columns", "ks names no group column: --group is required", "stats test ks --cols A,B --group G FILE", "flag", "--group");
        }
        if cli.operand_count(parsed) >= 2 && bytes.equal(cli.operand(args, parsed, 1), "kruskal") && !cli.has(parsed, table, "group") {
            e = rule.refuse(heap, e, "stats.test-columns", "kruskal names no group column: --group is required", "stats test kruskal --cols A,B --group G FILE", "flag", "--group");
        }
    } else if cli.operand_count(parsed) < 2 {
        e = rule.refuse(heap, e, "args.missing-operand", "no FILE to describe", "stats describe FILE", "", "");
    } else if cli.operand_count(parsed) > 2 {
        e = rule.refuse(heap, e, "args.too-many-operands", "one FILE only", "describe one file per call", "", "");
    }
    let (mu_key, mu_status) = flt.parse_float(cli.text(args, parsed, table, "mu0"));
    if mu_status != 0 {
        e = rule.refuse(heap, e, "args.bad-value", "--mu0 is a number", "--mu0 0 or --mu0 21.5", "flag", "--mu0");
    }
    var perm_seed = 0;
    var perm_n = 0;
    if is_resample && cli.operand_count(parsed) >= 2 && bytes.equal(cli.operand(args, parsed, 1), "perm") {
        let (e6, sd6, pn6) = perm.check_flags(heap, args, parsed, table, e);
        e = e6;
        perm_seed = sd6;
        perm_n = pn6;
    }
    var boot_seed = 0;
    var boot_reps = 0;
    var boot_stat = 0;
    var boot_qt = 0;
    var boot_pn = 0;
    var boot_pk = 0;
    var boot_meth = 0;
    if is_ci && cli.operand_count(parsed) >= 2 && bytes.equal(cli.operand(args, parsed, 1), "boot") {
        let (e5, sd5, rp5, st5, qt5, pn5, pk5, mt5) = boot.check_flags(heap, args, parsed, table, e);
        e = e5;
        boot_seed = sd5;
        boot_reps = rp5;
        boot_stat = st5;
        boot_qt = qt5;
        boot_pn = pn5;
        boot_pk = pk5;
        boot_meth = mt5;
    }
    let (lv_num, lv_k, lv_ok) = cat.parse_p(cli.text(args, parsed, table, "level"));
    if !lv_ok || lv_num == 0 || lv_num >= quantile.pow10(lv_k) {
        e = rule.refuse(heap, e, "args.bad-value", "--level is a decimal strictly between 0 and 1 with at most 9 decimals", "--level 0.95", "flag", "--level");
    }
    if len(cli.text(args, parsed, table, "delim")) != 1 {
        e = rule.refuse(heap, e, "args.bad-value", "--delim is one byte", "--delim , or --delim ';'", "flag", "--delim");
    }
    if cli.nat(args, parsed, table, "max-rows") > row_ceiling() {
        e = rule.refuse(heap, e, "args.bad-value", "--max-rows is above the ceiling", "10000000 is the most this tool reads", "flag", "--max-rows");
    }
    if cli.nat(args, parsed, table, "max-cols") > col_ceiling() || cli.nat(args, parsed, table, "max-cols") < 1 {
        e = rule.refuse(heap, e, "args.bad-value", "--max-cols is outside 1 to 4096", "4096 is the most this tool holds", "flag", "--max-cols");
    }
    if cli.nat(args, parsed, table, "max-line-bytes") > line_ceiling() {
        e = rule.refuse(heap, e, "args.bad-value", "--max-line-bytes is above the ceiling", "16777216 is the most this tool holds", "flag", "--max-line-bytes");
    }
    if cli.nat(args, parsed, table, "max-cells") > 100000000 || cli.nat(args, parsed, table, "max-cells") < 1 {
        e = rule.refuse(heap, e, "args.bad-value", "--max-cells is outside 1 to 100000000", "100000000 is the most this tool holds", "flag", "--max-cells");
    }
    if cli.nat(args, parsed, table, "quantile-type") < 1 || cli.nat(args, parsed, table, "quantile-type") > 9 {
        e = rule.refuse(heap, e, "args.bad-value", "--quantile-type is 1 to 9", "type 7 is the default of R and numpy", "flag", "--quantile-type");
    }
    if cli.nat(args, parsed, table, "bins") > 1000 {
        e = rule.refuse(heap, e, "args.bad-value", "--bins is above the ceiling", "1000 is the most bins this tool counts", "flag", "--bins");
    }
    if cli.nat(args, parsed, table, "levels") > 100 {
        e = rule.refuse(heap, e, "args.bad-value", "--levels is above the ceiling", "100 is the most levels this tool prints", "flag", "--levels");
    }
    if cli.nat(args, parsed, table, "max-levels") > 1000000 || cli.nat(args, parsed, table, "max-levels") < 1 {
        e = rule.refuse(heap, e, "args.bad-value", "--max-levels is outside 1 to 1000000", "1000000 is the most pairs this tool holds", "flag", "--max-levels");
    }
    if cli.nat(args, parsed, table, "max-groups") > 1000 || cli.nat(args, parsed, table, "max-groups") < 1 {
        e = rule.refuse(heap, e, "args.bad-value", "--max-groups is outside 1 to 1000", "1000 is the most groups this tool describes", "flag", "--max-groups");
    }
    if !valid_list(cli.text(args, parsed, table, "quantiles")) {
        e = rule.refuse(heap, e, "args.bad-value", "--quantiles takes at most 99 comma separated decimals from 0 to 1 with at most 9 decimals", "--quantiles 0.25,0.5,0.75", "flag", "--quantiles");
    }
    if is_ci && bytes.equal(cli.operand(args, parsed, 1), "corr") && cli.has(parsed, table, "method") && !bytes.equal(cli.text(args, parsed, table, "method"), "pearson") {
        e = rule.refuse(heap, e, "args.bad-value", "ci corr is Pearson's r only: Fisher's z interval has no Spearman or Kendall version in this tool", "drop --method, or use --method pearson", "method", cli.text(args, parsed, table, "method"));
    }
    if cli.operand_count(parsed) >= 1 && bytes.equal(cli.operand(args, parsed, 0), "corr") && cli.has(parsed, table, "method") && !bytes.equal(cli.text(args, parsed, table, "method"), "pearson") && !bytes.equal(cli.text(args, parsed, table, "method"), "spearman") && !bytes.equal(cli.text(args, parsed, table, "method"), "kendall") {
        e = rule.refuse(heap, e, "args.bad-value", "corr takes --method pearson, spearman or kendall", "the other methods are for stats ci", "method", cli.text(args, parsed, table, "method"));
    }
    if is_ci && cli.operand_count(parsed) >= 2 && (bytes.equal(cli.operand(args, parsed, 1), "mean") || bytes.equal(cli.operand(args, parsed, 1), "diff")) && cli.has(parsed, table, "method") {
        e = rule.refuse(heap, e, "args.bad-value", "ci mean and ci diff have one interval, the t interval: --method is for ci boot, ci prop and ci corr", "drop --method", "method", cli.text(args, parsed, table, "method"));
    }
    if cli.nat(args, parsed, table, "max-pairs") > 32640 || cli.nat(args, parsed, table, "max-pairs") < 1 {
        e = rule.refuse(heap, e, "args.bad-value", "--max-pairs is outside 1 to 32640", "32640 is the pairs of 256 columns", "flag", "--max-pairs");
    }
    if cli.has(parsed, table, "correct") && !is_test {
        e = rule.refuse(heap, e, "args.bad-value", "--correct is for stats test: the p-values of describe and corr are not a family of tests of one question", "drop --correct", "flag", "--correct");
    }
    if cli.operand_count(parsed) >= 1 && bytes.equal(cli.operand(args, parsed, 0), "corr") && bytes.equal(cli.text(args, parsed, table, "exact"), "yes") && !bytes.equal(cli.text(args, parsed, table, "method"), "kendall") {
        e = rule.refuse(heap, e, "stats.exact-unavailable", "--exact yes, but corr has an exact p-value only for --method kendall", "use --method kendall, or drop --exact", "method", cli.text(args, parsed, table, "method"));
    }
    if cli.nat(args, parsed, table, "max-tests") > 32640 || cli.nat(args, parsed, table, "max-tests") < 1 {
        e = rule.refuse(heap, e, "args.bad-value", "--max-tests is outside 1 to 32640", "32640 is the pairs of 256 columns", "flag", "--max-tests");
    }
    if is_test && !bytes.equal(cli.text(args, parsed, table, "correct"), "none") {
        var named = bytes.count_byte(cli.text(args, parsed, table, "cols"), ',') + 1;
        if cli.operand_count(parsed) >= 2 && bytes.equal(cli.operand(args, parsed, 1), "paired") {
            named = bytes.count_byte(cli.text(args, parsed, table, "pairs"), ',') + 1;
        }
        if named > cli.nat(args, parsed, table, "max-tests") {
            e = rule.refuse_int(heap, e, "limit.too-many-tests", "more tests than --max-tests in one family", "raise --max-tests or test fewer columns", "limit", cli.nat(args, parsed, table, "max-tests"), "tests", named);
        }
    }
    if cli.nat(args, parsed, table, "ddof") > 1 {
        e = rule.refuse(heap, e, "args.bad-value", "--ddof is 0 or 1", "0 divides by n, 1 by n - 1", "flag", "--ddof");
    }
    let (root, after_root) = path.root(heap, args, cli.text(args, parsed, table, "root"), cli.value_index(parsed, table, "root"), e);
    e = after_root;
    var refused = false;
    borrow e as &er in {
        refused = fail.count(er) > 0;
    }
    var data = buffer.empty(heap, 1);
    var plain = buffer.empty(heap, 1);
    let text_mode = bytes.equal(cli.text(args, parsed, table, "format"), "text");
    if !refused {
        borrow root as &rr in {
            let (target, checked) = path.operand(heap, args, buffer.bytes(rr), cli.operand_index(parsed, fidx), e);
            e = checked;
            borrow target as &tp in {
                if path.ok(tp) {
                    var w = json.writer(heap, 1024);
                    w = json.begin_object(heap, w);
                    let ddof = cli.nat(args, parsed, table, "ddof");
                    let qtype = cli.nat(args, parsed, table, "quantile-type");
                    if is_ci && bytes.equal(cli.operand(args, parsed, 1), "mean") {
                        let (w2, e2) = test_one(heap, args, parsed, fs, buffer.bytes(rr), path.shown(tp), path.full(tp), cli.has(parsed, table, "pairs"), false, true, w, e);
                        w = w2;
                        e = e2;
                    } else if is_ci && bytes.equal(cli.operand(args, parsed, 1), "corr") {
                        let (w2, e2) = corr_one(heap, args, parsed, fs, buffer.bytes(rr), path.shown(tp), path.full(tp), true, w, e);
                        w = w2;
                        e = e2;
                    } else if is_ci && bytes.equal(cli.operand(args, parsed, 1), "diff") {
                        let (w2, e2) = t2_one(heap, args, parsed, fs, buffer.bytes(rr), path.shown(tp), path.full(tp), true, w, e);
                        w = w2;
                        e = e2;
                    } else if is_resample {
                        let (w2, e2) = perm.perm(heap, args, parsed, fs, buffer.bytes(rr), path.shown(tp), path.full(tp), table, perm_seed, perm_n, w, e);
                        w = w2;
                        e = e2;
                    } else if is_ci && bytes.equal(cli.operand(args, parsed, 1), "boot") {
                        let (w2, e2) = boot.boot(heap, args, parsed, fs, buffer.bytes(rr), path.shown(tp), path.full(tp), table, boot_seed, boot_reps, boot_stat, boot_qt, boot_pn, boot_pk, boot_meth, lv_num, lv_k, float_of(lv_num) / float_of(quantile.pow10(lv_k)), w, e);
                        w = w2;
                        e = e2;
                    } else if is_ci {
                        let (cn, ck, cok) = cat.parse_p(cli.text(args, parsed, table, "level"));
                        let (w2, e2) = ci.prop(heap, args, parsed, fs, buffer.bytes(rr), path.shown(tp), path.full(tp), table, cn, ck, float_of(cn) / float_of(quantile.pow10(ck)), w, e);
                        w = w2;
                        e = e2;
                    } else if is_test && bytes.equal(cli.operand(args, parsed, 1), "prop") {
                        let (w2, e2) = cat.prop_one(heap, args, parsed, fs, buffer.bytes(rr), path.shown(tp), path.full(tp), table, w, e);
                        w = w2;
                        e = e2;
                    } else if is_test && bytes.equal(cli.operand(args, parsed, 1), "fisher") {
                        let (w2, e2) = cat.fisher_one(heap, args, parsed, fs, buffer.bytes(rr), path.shown(tp), path.full(tp), table, w, e);
                        w = w2;
                        e = e2;
                    } else if is_test && bytes.equal(cli.operand(args, parsed, 1), "chisq") {
                        let (w2, e2) = cat.chisq_one(heap, args, parsed, fs, buffer.bytes(rr), path.shown(tp), path.full(tp), table, w, e);
                        w = w2;
                        e = e2;
                    } else if is_test && (bytes.equal(cli.operand(args, parsed, 1), "anova") || bytes.equal(cli.operand(args, parsed, 1), "kruskal") || bytes.equal(cli.operand(args, parsed, 1), "mannwhitney") || bytes.equal(cli.operand(args, parsed, 1), "ks")) {
                        var kind_of_groups = 0;
                        if bytes.equal(cli.operand(args, parsed, 1), "kruskal") {
                            kind_of_groups = 1;
                        } else if bytes.equal(cli.operand(args, parsed, 1), "mannwhitney") {
                            kind_of_groups = 2;
                        } else if bytes.equal(cli.operand(args, parsed, 1), "ks") {
                            kind_of_groups = 3;
                        }
                        let (w2, e2) = run.groups_one(heap, args, parsed, fs, buffer.bytes(rr), path.shown(tp), path.full(tp), table, kind_of_groups, w, e);
                        w = w2;
                        e = e2;
                    } else if is_test && bytes.equal(cli.operand(args, parsed, 1), "t2") {
                        let (w2, e2) = t2_one(heap, args, parsed, fs, buffer.bytes(rr), path.shown(tp), path.full(tp), false, w, e);
                        w = w2;
                        e = e2;
                    } else if is_test {
                        let (w2, e2) = test_one(heap, args, parsed, fs, buffer.bytes(rr), path.shown(tp), path.full(tp), bytes.equal(cli.operand(args, parsed, 1), "paired") || (bytes.equal(cli.operand(args, parsed, 1), "wilcoxon") && cli.has(parsed, table, "pairs")), bytes.equal(cli.operand(args, parsed, 1), "wilcoxon"), false, w, e);
                        w = w2;
                        e = e2;
                    } else if bytes.equal(cli.operand(args, parsed, 0), "corr") {
                        let (w2, e2) = corr_one(heap, args, parsed, fs, buffer.bytes(rr), path.shown(tp), path.full(tp), false, w, e);
                        w = w2;
                        e = e2;
                    } else if !cli.has(parsed, table, "by") {
                        let (w2, e2) = describe_one(heap, args, parsed, fs, buffer.bytes(rr), path.shown(tp), path.full(tp), 0 - 1, "", false, false, w, e);
                        w = w2;
                        e = e2;
                    } else {
                        w = put_settings(heap, w, ddof, qtype);
                        w = json.put_key(heap, w, "by");
                        w = json.put_string(heap, w, cli.text(args, parsed, table, "by"));
                        w = json.put_key(heap, w, "groups");
                        w = json.begin_array(heap, w);
                        match place.open_operand(fs, buffer.bytes(rr), path.shown(tp), path.full(tp)) {
                            Opened::Failed(reason) => {
                                e = fail.io_error(heap, e, reason, false, path.shown(tp));
                            }
                            Opened::Ok(opened) => {
                                var file = opened;
                                borrow mut file as &!handle in {
                                    let (groups, by, e5) = scan.discover(heap, handle, path.shown(tp), cli.text(args, parsed, table, "by"), int_of(cli.text(args, parsed, table, "delim")[0]), cli.nat(args, parsed, table, "max-line-bytes"), cli.nat(args, parsed, table, "max-rows"), cli.nat(args, parsed, table, "max-cols"), cli.nat(args, parsed, table, "max-groups"), e);
                                    e = e5;
                                    borrow groups as &gr in {
                                        let ng = map.size(gr.m);
                                        var gi = 0;
                                        while gi < ng {
                                            var clean = false;
                                            borrow e as &er4 in {
                                                clean = fail.count(er4) == 0;
                                            }
                                            if clean {
                                                let (w3, e3) = describe_one(heap, args, parsed, fs, buffer.bytes(rr), path.shown(tp), path.full(tp), by, map.key_at(gr.m, contents(gr.order)[gi]), false, true, w, e);
                                                w = w3;
                                                e = e3;
                                            }
                                            gi = gi + 1;
                                        }
                                        var clean_null = false;
                                        borrow e as &er5 in {
                                            clean_null = fail.count(er5) == 0;
                                        }
                                        if clean_null && gr.nulls > 0 {
                                            let (w4, e4) = describe_one(heap, args, parsed, fs, buffer.bytes(rr), path.shown(tp), path.full(tp), by, "", true, true, w, e);
                                            w = w4;
                                            e = e4;
                                        }
                                    }
                                    scan.drop_groups(heap, groups);
                                }
                                file_close(file);
                            }
                        }
                        w = json.end_array(heap, w);
                    }
                    if is_test && !bytes.equal(cli.text(args, parsed, table, "correct"), "none") {
                        // (when an error was recorded the document is dropped, the family on it too)
                        w = correct.put_family(heap, w, cli.text(args, parsed, table, "correct"));
                    }
                    w = json.end_object(heap, w);
                    let doc = json.finish(w);
                    var ok = false;
                    borrow e as &er6 in {
                        ok = fail.count(er6) == 0;
                    }
                    if ok {
                        buffer.drop(heap, data);
                        data = doc;
                        if text_mode {
                            buffer.drop(heap, plain);
                            borrow data as &dd in {
                                plain = flat.flatten(heap, buffer.bytes(dd));
                            }
                        }
                    } else {
                        buffer.drop(heap, doc);
                    }
                }
            }
            path.drop(heap, target);
        }
    }
    buffer.drop(heap, root);
    var status = 0;
    borrow e as &er in {
        borrow data as &d in {
            borrow plain as &pl in {
                status = out.respond(heap, io, "stats", "stats.v1", "0.1.0", buffer.bytes(d), "", er, text_mode, buffer.bytes(pl), 0);
            }
        }
    }
    buffer.drop(heap, data);
    buffer.drop(heap, plain);
    fail.drop(heap, e);
    return status;
}

fn run[&h, &g, &f, &i](heap: &!h Heap, args: &g Args, fs: &f Fs(""), io: &!i Io) -> [heap, args, fs_read(""), dir_read, file_read, io_write, err_write] int {
    let which = cli.subcommand(args);
    if which != 0 {
        return describe.answer(heap, io, which, tool(), built());
    }
    let (parsed, e) = cli.parse(heap, args, flag_table(), fail.empty_in(heap, rule.extra()));
    var status = 0;
    borrow parsed as &p in {
        status = body(heap, args, p, fs, io, e);
    }
    cli.drop(heap, parsed);
    return status;
}

fn main(world: World) -> [] int {
    let Split { io, ffi, fs, heap, args, net, clock } = split(world);
    // No foreign code, no network, no clock.
    release(ffi);
    release(net);
    release(clock);
    var status = 0;
    borrow mut heap as &!h in {
        borrow args as &g in {
            borrow fs as &f in {
                borrow mut io as &!i in {
                    status = run(h, g, f, i);
                }
            }
        }
    }
    release(heap);
    release(args);
    release(fs);
    release(io);
    return status;
}
