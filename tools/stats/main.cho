edition 5;

// `stats` -- statistics on a CSV file whose last digit can be checked (docs/describe.md). One verb so far:
//
//     stats describe [flags] FILE      (the flags are the table of flag_table(); `stats introspect` prints it)
//
// Per column: how many cells are numbers, how many are empty, the minimum and maximum, the mean and the variance computed from EXACT sums (acc.psum, acc.bigint) and rounded once, and the standard
// deviation (the square root of the rounded variance: two roundings, said in the answer). A column with a cell that is not a number is reported as text. One JSON document, the contract of cancho-tools'
// `toolbox` package: errors are data with a rule tag, introspect and skill come from the table the parser runs on.

import std.buffer;
import std.bytes;
import std.json;
import std.map;
import std.vec;
import acc.bigint;
import acc.central;
import acc.psum;
import acc.histogram;
import acc.quantile;
import stest.answer;
import csvx.flat;
import csvx.pick;
import metrics.rank;
import special.dist;
import flt;
import reader;
import toolbox.built;
import toolbox.cli;
import toolbox.describe;
import toolbox.fail;
import toolbox.lines;
import toolbox.out;
import toolbox.path;
import toolbox.place;
import toolbox.text;

fn flag_table() -> [] &static [byte] {
    return "root||path|root||resolve FILE relative to this directory and refuse paths outside it;delim|d|text|none|,|the one byte that separates fields (default comma);ddof||nat|none|1|the divisor of the variance is n minus this (1 is the sample variance, 0 the population variance);max-rows||nat|none|1000000|the most data rows read, one more is limit.too-many-rows (ceiling 10000000);max-cols||nat|none|256|the most columns, more is limit.too-many-columns (ceiling 4096);max-line-bytes||nat|none|1048576|the longest line read, a longer one is limit.line-too-long (ceiling 16777216);max-cells||nat|none|20000000|the most cells (rows times columns) held for the quantiles, more is limit.too-many-cells (ceiling 100000000);quantiles||text|none|0,0.25,0.5,0.75,1|the probabilities of the quantiles, comma separated decimals from 0 to 1 with at most 9 decimals (at most 99 of them);quantile-type||nat|none|7|which of the nine Hyndman-Fan definitions, 1 to 9 (7 is the default of R and numpy);bins||nat|none|10|the number of equal-width histogram bins over [min, max], 0 for none (ceiling 1000);levels||nat|none|10|how many of the most frequent levels of a text column to print, 0 for none and no second pass (ceiling 100);max-levels||nat|none|100000|the most distinct (column, level) pairs held for all text columns together, a column that would need one more is levels_capped (ceiling 1000000);by||text|none||the header name of a column: describe each group of rows that have the same value in it, one after the other;max-groups||nat|none|50|the most groups with --by, one more is limit.too-many-groups (ceiling 1000);cols||text|none||the columns to describe, correlate or test: header names separated by commas, printed in the order of the file;format||choice:json/text|none|json|json for a program, text (one line per value, path = value) for a person;method||choice:pearson/spearman/kendall|none|pearson|corr: the coefficient: pearson, spearman (the Pearson coefficient of the average ranks) or kendall (tau-b);missing||choice:pairwise/listwise|none|pairwise|corr: pairwise uses, for each pair, the rows where both cells are numbers, listwise only the rows where every chosen column has a number;max-pairs||nat|none|1000|corr: the most pairs of columns, more is limit.too-many-pairs (ceiling 32640);mu0||text|none|0|test t1: the mean under the null hypothesis, a number;level||text|none|0.95|test: the confidence level of the interval, a decimal strictly between 0 and 1 with at most 9 decimals";
}

fn extra() -> [] &static [byte] {
    return "stats.csv-ragged|8|never|a record with a different number of fields than the header;stats.csv-multiline|8|never|a record that continues on the next line, which this version does not read;stats.csv-bad-quote|8|never|a quote that opens or closes where it may not;stats.no-header|8|never|a file with no header line;stats.bad-verb|2|never|the first operand is not a verb this tool has;limit.too-many-rows|8|never|more data rows than --max-rows;limit.too-many-columns|8|never|more columns than --max-cols;limit.too-many-cells|8|never|more cells than --max-cells;stats.file-changed|8|never|the file is not the same on the second pass that counts the levels of a text column;stats.no-such-column|2|never|--by names no column of the header;stats.ambiguous-column|2|never|--by names a header that two or more columns have;limit.too-many-groups|8|never|more groups than --max-groups;stats.corr-columns|2|never|fewer than two numeric columns to correlate;stats.non-numeric|2|never|--cols names a column that has no numbers or has a cell that is not a number;limit.too-many-pairs|8|never|more pairs of columns than --max-pairs;stats.test-columns|2|never|test without --cols";
}

fn tool() -> [] describe.Tool {
    return describe.Tool { name: "stats", version: "0.1.0", summary: "Describe the columns of a CSV file: counts, minimum, maximum, mean, variance and standard deviation from exact sums rounded once; the same bytes on every platform and at any thread count.", usage: "stats describe [--root DIR] [--delim D] [--ddof N] [--max-rows N] [--max-cols N] [--max-line-bytes N] [--max-cells N] [--quantiles P,P,..] [--quantile-type N] [--bins N] [--levels N] [--max-levels N] [--by COL] [--max-groups N] [--cols A,B,..] [--format json|text] FILE; stats corr [--cols A,B,..] [--method pearson|spearman|kendall] [--missing pairwise|listwise] [--max-pairs N] FILE; stats test t1 --cols A,B,.. [--mu0 X] [--level 0.95] FILE", output: "document", schema: "stats.v1", flags: flag_table(), operands: "VERB|none|1|1|describe, corr or test;FILE|path-read|1|2|the CSV file (after the kind of test, t1, for test)", rules: "args.unknown-flag;args.missing-value;args.bad-value;args.duplicate-flag;args.missing-operand;args.too-many-operands;path.empty;path.dotdot;path.absolute;path.outside-root;path.too-long;path.symlink;io.not-found;io.not-a-directory;io.is-a-directory;io.permission-denied;io.read-failed;limit.line-too-long;stats.csv-ragged;stats.csv-multiline;stats.csv-bad-quote;stats.no-header;stats.bad-verb;limit.too-many-rows;limit.too-many-columns;limit.too-many-cells;stats.file-changed;stats.no-such-column;stats.ambiguous-column;limit.too-many-groups;stats.corr-columns;stats.non-numeric;limit.too-many-pairs;stats.test-columns", extra_rules: extra(), limits: "max-rows|1000000|10000000;max-cols|256|4096;max-line-bytes|1048576|16777216;max-cells|20000000|100000000;bins|10|1000;levels|10|100;max-levels|100000|1000000;max-groups|50|1000;max-pairs|1000|32640", reversibility: "reversible-cheap", stdin: "never", guarantees: "deterministic;idempotent;bounded_memory" };
}

fn built() -> [] describe.Built {
    return describe.Built { authority: built.authority(), schema: built.schema(), compiler: built.compiler() };
}

fn row_ceiling() -> [] int {
    return 10000000;
}

fn col_ceiling() -> [] int {
    return 4096;
}

fn line_ceiling() -> [] int {
    return 16777216;
}

// an error of this tool's own (or a standard one) with one string detail
fn refuse[&h, &m, &n, &k, &v](heap: &!h Heap, e: fail.Errors, rule: &static [byte], message: &m [byte], hint: &n [byte], key: &k [byte], value: &v [byte]) -> [heap] fail.Errors {
    var w = fail.open_in(heap, extra(), rule, message, hint);
    w = fail.no_repair(heap, w);
    w = fail.detail_open(heap, w);
    if len(key) > 0 {
        w = json.put_key(heap, w, key);
        w = json.put_string(heap, w, value);
    }
    return fail.add(heap, e, w);
}

fn refuse_int[&h, &m, &n, &k](heap: &!h Heap, e: fail.Errors, rule: &static [byte], message: &m [byte], hint: &n [byte], key: &k [byte], value: int, key2: &k [byte], value2: int) -> [heap] fail.Errors {
    var w = fail.open_in(heap, extra(), rule, message, hint);
    w = fail.no_repair(heap, w);
    w = fail.detail_open(heap, w);
    w = json.put_key(heap, w, key);
    w = json.put_int(heap, w, value);
    w = json.put_key(heap, w, key2);
    w = json.put_int(heap, w, value2);
    return fail.add(heap, e, w);
}

// ------------------------------------------------------------------------------------------------ the columns

res struct Cols {
    nonmiss: Box[[int]],
    numeric: Box[[int]],
    bad: Box[[int]],
    mn: Box[[float]],
    mx: Box[[float]],
    accs: Box[[int]],
    work: Box[[int]],
    cells: Box[[int]],
    rowkeys: Box[[int]],
}

fn acc_stride() -> [] int {
    return psum.size(1) + psum.size(2) + psum.size(3) + psum.size(4);
}

fn make_cols[&h](heap: &!h Heap, n: int) -> [heap] Cols {
    return Cols { nonmiss: box_slice(heap, n + 1, 0), numeric: box_slice(heap, n + 1, 0), bad: box_slice(heap, n + 1, 0), mn: box_slice(heap, n + 1, 0.0), mx: box_slice(heap, n + 1, 0.0), accs: box_slice(heap, n * acc_stride() + 1, 0), work: box_slice(heap, psum.scratch() + 1, 0), cells: box_slice(heap, 3 * n + 4, 0), rowkeys: box_slice(heap, n + 1, 0) };
}

fn drop_cols[&h](heap: &!h Heap, c: Cols) -> [heap] int {
    let Cols { nonmiss, numeric, bad, mn, mx, accs, work, cells, rowkeys } = c;
    unbox_slice(heap, nonmiss);
    unbox_slice(heap, numeric);
    unbox_slice(heap, bad);
    unbox_slice(heap, mn);
    unbox_slice(heap, mx);
    unbox_slice(heap, accs);
    unbox_slice(heap, work);
    unbox_slice(heap, cells);
    unbox_slice(heap, rowkeys);
    return 0;
}

// Whether the record whose cells are in `cs` belongs to the group: its cell `by` is missing (the group `null`) or has the bytes of `key`.
fn in_group[&c, &l, &k](cs: &c [int], line: &l [byte], by: int, key: &k [byte], by_null: bool) -> [] bool {
    let from = cs[3 * by];
    let to = cs[3 * by + 1];
    let missing = to == from && cs[3 * by + 2] == 0;
    if by_null {
        return missing;
    }
    if missing {
        return false;
    }
    return bytes.equal(line[from..to], key);
}

// One data record. 0 when it was taken, 1 ragged, 2 continues on the next line, 3 a bad quote, 4 not in the group (`by` < 0 means no group), 5 or 6 in the group but `room` says the rows (1) or the cells (2) are full.
fn take_row[&c, &l, &k](c: &!c Cols, line: &l [byte], delim: int, ncols: int, by: int, key: &k [byte], by_null: bool, room: int) -> [] int {
    let cells = contents(c.cells);
    let (n, inside, badq) = reader.fields(line, delim, cells, ncols);
    if inside {
        return 2;
    }
    if badq {
        return 3;
    }
    if n != ncols {
        return 1;
    }
    if by >= 0 && !in_group(cells, line, by, key, by_null) {
        return 4;
    }
    if room != 0 {
        return 4 + room;
    }
    let nonmiss = contents(c.nonmiss);
    let numeric = contents(c.numeric);
    let bad = contents(c.bad);
    let mn = contents(c.mn);
    let mx = contents(c.mx);
    let accs = contents(c.accs);
    let work = contents(c.work);
    let rowkeys = contents(c.rowkeys);
    var j = 0;
    while j < ncols {
        rowkeys[j] = rank.min_int();
        j = j + 1;
    }
    j = 0;
    while j < ncols {
        let s = cells[3 * j];
        let e = cells[3 * j + 1];
        let quoted = cells[3 * j + 2];
        if e == s && quoted == 0 {
            // an empty cell is a missing value: counted by the difference of rows and nonmiss
            j = j + 1;
        } else {
            nonmiss[j] = nonmiss[j] + 1;
            if quoted == 1 {
                bad[j] = 1;
            } else if bad[j] == 0 {
                let (key, status) = flt.parse_float(line[s..e]);
                if status != 0 {
                    bad[j] = 1;
                } else {
                    let x = flt.float_of_key(key);
                    if numeric[j] == 0 || x < mn[j] {
                        mn[j] = x;
                    }
                    if numeric[j] == 0 || x > mx[j] {
                        mx[j] = x;
                    }
                    numeric[j] = numeric[j] + 1;
                    rowkeys[j] = rank.key_of(x);
                    let base = j * acc_stride();
                    psum.add(accs[base..base + psum.size(1)], 1, bits_of(x), work);
                    psum.add(accs[base + psum.size(1)..base + psum.size(1) + psum.size(2)], 2, bits_of(x), work);
                    psum.add(accs[base + psum.size(1) + psum.size(2)..base + psum.size(1) + psum.size(2) + psum.size(3)], 3, bits_of(x), work);
                    psum.add(accs[base + psum.size(1) + psum.size(2) + psum.size(3)..base + acc_stride()], 4, bits_of(x), work);
                }
            }
            j = j + 1;
        }
    }
    return 0;
}

// ------------------------------------------------------------------------------------------------ exact arithmetic to a double

fn float_of_bits(bits: int) -> [] float {
    var key = bits;
    if bits < 0 {
        key = bits ^ 0x7fffffffffffffff;
    }
    return flt.float_of_key(key);
}

struct Stats {
    mean: float,
    variance: float,
    sd: float,
    variance_ok: bool,
    skew: float,
    kurt: float,
    moments_ok: bool,
}

// the exact mean and variance of the numeric cells of column j
fn moments[&h, &c](heap: &!h Heap, c: &c Cols, j: int, ddof: int) -> [heap] Stats {
    let n = contents(c.numeric)[j];
    let accs = contents(c.accs);
    let base = j * acc_stride();
    let l1 = psum.limbs(1);
    let l2 = psum.limbs(2);
    let s1 = box_slice(heap, l1 + 1, 0);
    let s2 = box_slice(heap, l2 + 1, 0);
    let nl = box_slice(heap, 4, 0);
    var mean = 0.0;
    var variance = 0.0;
    var ok = false;
    borrow mut s1 as &!w1 in {
        borrow mut s2 as &!w2 in {
            borrow mut nl as &!wn in {
                let neg1 = psum.magnitude(accs[base..base + psum.size(1)], 1, contents(w1)) < 0;
                psum.magnitude(accs[base + psum.size(1)..base + psum.size(1) + psum.size(2)], 2, contents(w2));
                central.limbs_of(n, contents(wn));
                let (mb, mc) = central.ratio_bits(heap, contents(w1), l1, contents(wn), 3, 0 - 1074, neg1);
                mean = float_of_bits(mb);
                if n - ddof >= 1 {
                    // N = n sum(x^2) - sum(x)^2, exact, in units of 2^-2148
                    let a = box_slice(heap, l2 + 5, 0);
                    let b = box_slice(heap, 2 * l1 + 2, 0);
                    borrow mut a as &!aw in {
                        borrow mut b as &!bw in {
                            bigint.mul(contents(aw), contents(w2), l2, contents(wn), 3);
                            bigint.mul(contents(bw), contents(w1), l1, contents(w1), l1);
                            bigint.sub_in(contents(aw), l2 + 5, contents(bw), 2 * l1 + 2);
                            let dl = box_slice(heap, 4, 0);
                            borrow mut dl as &!dw in {
                                central.limbs_of(n * (n - ddof), contents(dw));
                                let (vb, vc) = central.ratio_bits(heap, contents(aw), l2 + 5, contents(dw), 3, 0 - 2148, false);
                                variance = float_of_bits(vb);
                                ok = vc == 0;
                            }
                            unbox_slice(heap, dl);
                        }
                    }
                    unbox_slice(heap, a);
                    unbox_slice(heap, b);
                }
            }
        }
    }
    unbox_slice(heap, s1);
    unbox_slice(heap, s2);
    unbox_slice(heap, nl);
    var sd = 0.0;
    if ok {
        sd = sqrt(variance);
    }
    var skew = 0.0;
    var kurt = 0.0;
    var mok = false;
    if n >= 2 {
        let (sb, sc, kb, kc, st) = central.skew_kurt(heap, accs[base..base + acc_stride()], n);
        if st == 0 && sc == 0 && kc == 0 {
            skew = float_of_bits(sb);
            kurt = float_of_bits(kb);
            mok = true;
        }
    }
    return Stats { mean: mean, variance: variance, sd: sd, variance_ok: ok, skew: skew, kurt: kurt, moments_ok: mok };
}

// ------------------------------------------------------------------------------------------------ the answer

// one probability, a decimal such as 0, 1, .5 or 0.025: (digits as an integer, number of decimals, ok); at most 9 decimals, at most 12 digits, not above 1
fn parse_p[&t](tok: &t [byte]) -> [] (int, int, bool) {
    var num = 0;
    var k = 0;
    var dot = false;
    var digits = 0;
    var i = 0;
    while i < len(tok) {
        let c = int_of(tok[i]);
        if c == '.' {
            if dot {
                return (0, 0, false);
            }
            dot = true;
        } else if c >= '0' && c <= '9' {
            digits = digits + 1;
            if dot {
                k = k + 1;
            }
            if k > 9 || digits > 12 {
                return (0, 0, false);
            }
            num = num * 10 + (c - '0');
        } else {
            return (0, 0, false);
        }
        i = i + 1;
    }
    if digits == 0 || num > quantile.pow10(k) {
        return (0, 0, false);
    }
    return (num, k, true);
}

// the list of probabilities is valid: 1 to 99 tokens, each a probability
fn valid_list[&t](text: &t [byte]) -> [] bool {
    let n = bytes.count_byte(text, ',') + 1;
    if n > 99 {
        return false;
    }
    var i = 0;
    while i < n {
        let (num, k, ok) = parse_p(bytes.field(text, ',', i + 1));
        if !ok {
            return false;
        }
        i = i + 1;
    }
    return true;
}

// the quantiles of column j: its numeric cells gathered from the store, sorted, and each probability of `qtext` answered exactly
fn quantile_list[&h, &sv, &q](heap: &!h Heap, w0: json.Writer, store: &sv vec.Vec[int], rows: int, ncols: int, j: int, n: int, qtype: int, qtext: &q [byte], bins: int) -> [heap] json.Writer {
    var w = w0;
    let keys = box_slice(heap, n + 1, 0);
    let tmp = box_slice(heap, n + 1, 0);
    let cnt = box_slice(heap, 256, 0);
    w = json.put_key(heap, w, "quantiles");
    w = json.begin_array(heap, w);
    borrow mut keys as &!kw in {
        borrow mut tmp as &!tw in {
            borrow mut cnt as &!cw in {
                var r = 0;
                var m = 0;
                while r < rows {
                    let k = vec.get(store, r * ncols + j);
                    if k != rank.min_int() {
                        contents(kw)[m] = k;
                        m = m + 1;
                    }
                    r = r + 1;
                }
                rank.sort_range(contents(kw), contents(tw), contents(cw), 0, m);
                let count = bytes.count_byte(qtext, ',') + 1;
                var i = 0;
                while i < count {
                    let tok = bytes.field(qtext, ',', i + 1);
                    let (num, k, ok) = parse_p(tok);
                    let (bits, code) = quantile.at(heap, contents(kw), m, qtype, num, k);
                    w = json.begin_object(heap, w);
                    w = json.put_key(heap, w, "p");
                    w = json.put_string(heap, w, tok);
                    w = json.put_key(heap, w, "value");
                    w = json.put_float(heap, w, float_of_bits(bits));
                    w = json.end_object(heap, w);
                    i = i + 1;
                }
                w = json.end_array(heap, w);
                // the distinct values: the changes of the sorted keys
                var d = 0;
                var t = 0;
                while t < m {
                    if t == 0 || contents(kw)[t] != contents(kw)[t - 1] {
                        d = d + 1;
                    }
                    t = t + 1;
                }
                w = json.put_key(heap, w, "distinct");
                w = json.put_int(heap, w, d);
                if bins > 0 {
                    let kmin = contents(kw)[0];
                    let kmax = contents(kw)[m - 1];
                    var nb = bins;
                    if kmin == kmax {
                        nb = 1;
                    }
                    w = json.put_key(heap, w, "histogram");
                    w = json.begin_object(heap, w);
                    w = json.put_key(heap, w, "bins");
                    w = json.put_int(heap, w, nb);
                    w = json.put_key(heap, w, "edges");
                    w = json.begin_array(heap, w);
                    var e = 0;
                    while e <= nb {
                        let (eb, ec) = histogram.edge_bits(heap, nb, e, kmin, kmax);
                        w = json.put_float(heap, w, float_of_bits(eb));
                        e = e + 1;
                    }
                    w = json.end_array(heap, w);
                    w = json.put_key(heap, w, "counts");
                    w = json.begin_array(heap, w);
                    var prev = 0;
                    var b = 1;
                    while b <= nb {
                        var upto = m;
                        if b < nb {
                            upto = histogram.below(heap, contents(kw), m, nb, b, kmin, kmax);
                        }
                        w = json.put_int(heap, w, upto - prev);
                        prev = upto;
                        b = b + 1;
                    }
                    w = json.end_array(heap, w);
                    w = json.end_object(heap, w);
                }
            }
        }
    }
    unbox_slice(heap, keys);
    unbox_slice(heap, tmp);
    unbox_slice(heap, cnt);
    return w;
}

// ------------------------------------------------------------------------------------------------ the levels of a text column

// The pairs (column, cell bytes) of every text column, counted: one map whose key is two bytes of column number then the cell, and whose value is the count. `top` holds, for column j and rank r, the entry
// of its r-th most frequent level (-1 when there is none); `distinct` and `capped` are per column.
res struct Levels {
    m: map.Map[int],
    distinct: Box[[int]],
    capped: Box[[int]],
    top: Box[[int]],
    cells: Box[[int]],
}

fn make_levels[&h](heap: &!h Heap, ncols: int, k: int) -> [heap] Levels {
    return Levels { m: map.empty(heap, 64, 0, 7), distinct: box_slice(heap, ncols + 1, 0), capped: box_slice(heap, ncols + 1, 0), top: box_slice(heap, ncols * k + 1, 0 - 1), cells: box_slice(heap, 3 * ncols + 4, 0) };
}

fn drop_levels[&h](heap: &!h Heap, lv: Levels) -> [heap] int {
    let Levels { m, distinct, capped, top, cells } = lv;
    map.drop(heap, m);
    unbox_slice(heap, distinct);
    unbox_slice(heap, capped);
    unbox_slice(heap, top);
    unbox_slice(heap, cells);
    return 0;
}

// Whether entry `a` goes before entry `b`: more frequent first, then the bytes (the column prefix is the same inside one column).
fn precedes[&m](m: &m map.Map[int], a: int, b: int) -> [] bool {
    let ca = map.value_at(m, a);
    let cb = map.value_at(m, b);
    if ca != cb {
        return ca > cb;
    }
    return bytes.compare(map.key_at(m, a), map.key_at(m, b)) < 0;
}

fn column_of[&m](m: &m map.Map[int], e: int) -> [] int {
    let key = map.key_at(m, e);
    return int_of(key[0]) + 256 * int_of(key[1]);
}

// The first `k` levels of every column in `k` passes over the entries: pass r keeps, per column, the entry that goes before all the others that come after the one of rank r - 1.
fn rank_levels[&m, &t, &b](m: &m map.Map[int], ncols: int, k: int, top: &!t [int], best: &!b [int]) -> [] int {
    var r = 0;
    while r < k {
        var j = 0;
        while j < ncols {
            best[j] = 0 - 1;
            j = j + 1;
        }
        var e = 0;
        while e < map.entries(m) {
            if map.is_live(m, e) {
                let col = column_of(m, e);
                var eligible = true;
                if r > 0 {
                    let prev = top[col * k + r - 1];
                    eligible = prev >= 0 && precedes(m, prev, e);
                }
                if eligible && (best[col] < 0 || precedes(m, e, best[col])) {
                    best[col] = e;
                }
            }
            e = e + 1;
        }
        j = 0;
        while j < ncols {
            top[j * k + r] = best[j];
            j = j + 1;
        }
        r = r + 1;
    }
    return 0;
}

// The second pass: the file again, and every non-missing cell of a text column counted. `expected` is the number of data rows the first pass took; a different file is `stats.file-changed`.
fn level_pass[&h, &f, &s, &c, &k, &x](heap: &!h Heap, file: &!f File, shown: &s [byte], cols: &c Cols, sel: &x [int], ncols: int, by: int, key: &k [byte], by_null: bool, expected: int, delim: int, cap: int, k: int, max_levels: int, lv0: Levels, errs: fail.Errors) -> [heap, file_read] (Levels, fail.Errors) {
    let Levels { m, distinct, capped, top, cells } = lv0;
    var mm = m;
    var e = errs;
    var kb = buffer.empty(heap, 64);
    var r = lines.start(heap, cap);
    var going = true;
    var seen_header = false;
    var rows = 0;
    var changed = false;
    while going {
        let (stepped, status) = lines.next(heap, r);
        r = stepped;
        if status == lines.need() {
            r = lines.fill_file(r, file);
        } else if status == lines.done() {
            going = false;
        } else if status == lines.long() {
            changed = true;
            going = false;
        } else {
            borrow r as &rr in {
                let line = lines.text(rr);
                if !seen_header {
                    seen_header = true;
                } else if len(line) > 0 || ncols == 1 {
                    rows = rows + 1;
                    borrow mut cells as &!cw in {
                        let cs = contents(cw);
                        let (n, inside, badq) = reader.fields(line, delim, cs, ncols);
                        var mine = true;
                        if by >= 0 && !inside && !badq && n == ncols {
                            mine = in_group(cs, line, by, key, by_null);
                        }
                        if !mine {
                            rows = rows - 1;
                        } else if inside || badq || n != ncols || rows > expected {
                            changed = true;
                            going = false;
                        } else {
                            let bad = contents(cols.bad);
                            var j = 0;
                            while j < ncols {
                                let from = cs[3 * j];
                                let to = cs[3 * j + 1];
                                if bad[j] == 1 && sel[j] == 1 && !(to == from && cs[3 * j + 2] == 0) {
                                    borrow mut kb as &!kw in {
                                        buffer.clear(kw);
                                    }
                                    kb = buffer.push(heap, kb, byte_of(j % 256));
                                    kb = buffer.push(heap, kb, byte_of(j / 256));
                                    kb = buffer.append(heap, kb, line[from..to]);
                                    borrow kb as &kr in {
                                        let key = buffer.bytes(kr);
                                        var known = false;
                                        var count = 0;
                                        var room = false;
                                        borrow mm as &mr in {
                                            known = map.has(mr, key);
                                            count = map.get(mr, key, 0);
                                            room = map.size(mr) < max_levels;
                                        }
                                        if known || room {
                                            if !known {
                                                borrow mut distinct as &!dw in {
                                                    contents(dw)[j] = contents(dw)[j] + 1;
                                                }
                                            }
                                            mm = map.put(heap, mm, key, count + 1);
                                        } else {
                                            borrow mut capped as &!pw in {
                                                contents(pw)[j] = 1;
                                            }
                                        }
                                    }
                                }
                                j = j + 1;
                            }
                        }
                    }
                }
            }
        }
    }
    var errno = 0;
    borrow r as &rr in {
        errno = lines.failed(rr);
    }
    lines.drop(heap, r);
    buffer.drop(heap, kb);
    if errno != 0 {
        e = fail.io_error(heap, e, errno, false, shown);
    } else if changed || rows != expected {
        e = refuse(heap, e, "stats.file-changed", "the file is not the same on the second pass", "the file was changed while it was read: run the command again on a file that is not being written", "file", shown);
    } else {
        let best = box_slice(heap, ncols + 1, 0);
        borrow mm as &mr in {
            borrow mut top as &!tw in {
                borrow mut best as &!bw in {
                    rank_levels(mr, ncols, k, contents(tw), contents(bw));
                }
            }
        }
        unbox_slice(heap, best);
    }
    return (Levels { m: mm, distinct: distinct, capped: capped, top: top, cells: cells }, e);
}

// `distinct` and the first `k` `levels` of the text column j, or `levels_capped` when the bound of --max-levels stopped the count of it
fn level_list[&h, &lv](heap: &!h Heap, w0: json.Writer, lv: &lv Levels, j: int, k: int) -> [heap] json.Writer {
    var w = w0;
    if contents(lv.capped)[j] == 1 {
        w = json.put_key(heap, w, "distinct");
        w = json.put_null(heap, w);
        w = json.put_key(heap, w, "levels");
        w = json.put_null(heap, w);
        w = json.put_key(heap, w, "levels_capped");
        w = json.put_bool(heap, w, true);
        return w;
    }
    w = json.put_key(heap, w, "distinct");
    w = json.put_int(heap, w, contents(lv.distinct)[j]);
    w = json.put_key(heap, w, "levels");
    w = json.begin_array(heap, w);
    var r = 0;
    while r < k {
        let e = contents(lv.top)[j * k + r];
        if e >= 0 {
            let key = map.key_at(lv.m, e);
            w = json.begin_object(heap, w);
            w = json.put_key(heap, w, "value");
            w = text.put(heap, w, key[2..len(key)]);
            w = json.put_key(heap, w, "count");
            w = json.put_int(heap, w, map.value_at(lv.m, e));
            w = json.end_object(heap, w);
        }
        r = r + 1;
    }
    w = json.end_array(heap, w);
    w = json.put_key(heap, w, "levels_capped");
    w = json.put_bool(heap, w, false);
    return w;
}

fn report_columns[&h, &c, &x, &nm, &en, &sv, &q, &lv](heap: &!h Heap, w0: json.Writer, c: &c Cols, sel: &x [int], names: &nm [byte], ends: &en vec.Vec[int], store: &sv vec.Vec[int], ncols: int, rows: int, ddof: int, qtype: int, qtext: &q [byte], bins: int, lv: &lv Levels, k: int, counted: bool) -> [heap] json.Writer {
    var w = w0;
    w = json.put_key(heap, w, "columns");
    w = json.begin_array(heap, w);
    var j = 0;
    while j < ncols {
        if sel[j] == 1 {
            var from = 0;
            if j > 0 {
                from = vec.get(ends, j - 1);
            }
            let to = vec.get(ends, j);
            w = json.begin_object(heap, w);
            w = json.put_key(heap, w, "name");
            w = json.put_string(heap, w, names[from..to]);
            let nonmiss = contents(c.nonmiss)[j];
            let numeric = contents(c.numeric)[j];
            let bad = contents(c.bad)[j];
            w = json.put_key(heap, w, "kind");
            if nonmiss == 0 {
                w = json.put_string(heap, w, "empty");
            } else if bad == 1 {
                w = json.put_string(heap, w, "text");
            } else {
                w = json.put_string(heap, w, "numeric");
            }
            w = json.put_key(heap, w, "count");
            w = json.put_int(heap, w, nonmiss);
            w = json.put_key(heap, w, "missing");
            w = json.put_int(heap, w, rows - nonmiss);
            if nonmiss > 0 && bad == 0 {
                w = json.put_key(heap, w, "min");
                w = json.put_float(heap, w, contents(c.mn)[j]);
                w = json.put_key(heap, w, "max");
                w = json.put_float(heap, w, contents(c.mx)[j]);
                let s = moments(heap, c, j, ddof);
                w = json.put_key(heap, w, "mean");
                w = json.put_float(heap, w, s.mean);
                w = json.put_key(heap, w, "variance");
                if s.variance_ok {
                    w = json.put_float(heap, w, s.variance);
                } else {
                    w = json.put_null(heap, w);
                }
                w = json.put_key(heap, w, "sd");
                if s.variance_ok {
                    w = json.put_float(heap, w, s.sd);
                } else {
                    w = json.put_null(heap, w);
                }
                w = json.put_key(heap, w, "skewness");
                if s.moments_ok {
                    w = json.put_float(heap, w, s.skew);
                } else {
                    w = json.put_null(heap, w);
                }
                w = json.put_key(heap, w, "kurtosis");
                if s.moments_ok {
                    w = json.put_float(heap, w, s.kurt);
                } else {
                    w = json.put_null(heap, w);
                }
                w = quantile_list(heap, w, store, rows, ncols, j, numeric, qtype, qtext, bins);
            } else if nonmiss > 0 && counted {
                w = level_list(heap, w, lv, j, k);
            }
            w = json.end_object(heap, w);
        }
        j = j + 1;
    }
    w = json.end_array(heap, w);
    return w;
}

// ------------------------------------------------------------------------------------------------ reading the file

// The settings every answer states.
fn put_settings[&h](heap: &!h Heap, w0: json.Writer, ddof: int, qtype: int) -> [heap] json.Writer {
    var w = w0;
    w = json.put_key(heap, w, "ddof");
    w = json.put_int(heap, w, ddof);
    w = json.put_key(heap, w, "quantile_type");
    w = json.put_int(heap, w, qtype);
    w = json.put_key(heap, w, "rounding");
    w = json.put_string(heap, w, "mean, variance, skewness, excess kurtosis, quantiles: exact, rounded once; sd: the square root of the rounded variance, two roundings");
    return w;
}

// ------------------------------------------------------------------------------------------------ the groups of --by

// The distinct values of the `by` column, as a map (key the bytes of the cell), `order` the entries by their bytes ascending, `nulls` how many records have the cell missing.
res struct Groups {
    m: map.Map[int],
    order: Box[[int]],
    nulls: int,
}

fn drop_groups[&h](heap: &!h Heap, g: Groups) -> [heap] int {
    let Groups { m, order, nulls } = g;
    map.drop(heap, m);
    unbox_slice(heap, order);
    return nulls;
}

// Pass 0 of --by: the header names the column (exactly one match), then every record is read and its value noted. The answer is the groups, the index of the column (-1 when refused) and the errors.
fn discover[&h, &f, &s, &n](heap: &!h Heap, file: &!f File, shown: &s [byte], byname: &n [byte], delim: int, cap: int, max_rows: int, max_cols: int, max_groups: int, errs: fail.Errors) -> [heap, file_read] (Groups, int, fail.Errors) {
    var m = map.empty(heap, 64, 0, 11);
    var e = errs;
    var by = 0 - 1;
    var ncols = 0;
    var nulls = 0;
    var cells = box_slice(heap, 4, 0);
    var r = lines.start(heap, cap);
    var going = true;
    var have_header = false;
    var number = 0;
    var rows = 0;
    while going {
        let (stepped, status) = lines.next(heap, r);
        r = stepped;
        if status == lines.need() {
            r = lines.fill_file(r, file);
        } else if status == lines.done() {
            going = false;
        } else if status == lines.long() {
            e = refuse(heap, e, "limit.line-too-long", "a line is longer than --max-line-bytes", "raise --max-line-bytes", "file", shown);
            going = false;
        } else {
            number = number + 1;
            var stop = false;
            borrow r as &rr in {
                let line = lines.text(rr);
                if !have_header {
                    let (open, seps, badq) = reader.scan(line, delim, false, 0);
                    if open {
                        e = refuse(heap, e, "stats.csv-multiline", "the header continues on the next line", "put the header on one line", "file", shown);
                        stop = true;
                    } else if badq {
                        e = refuse(heap, e, "stats.csv-bad-quote", "a quote in the header opens or closes where it may not", "write the header as RFC 4180", "file", shown);
                        stop = true;
                    } else if seps + 1 > max_cols {
                        e = refuse_int(heap, e, "limit.too-many-columns", "more columns than --max-cols", "raise --max-cols", "limit", max_cols, "columns", seps + 1);
                        stop = true;
                    } else {
                        let (nb, ne) = reader.split_header(heap, line, delim);
                        var matches = 0;
                        borrow nb as &nbr in {
                            borrow ne as &ner in {
                                var j = 0;
                                while j < seps + 1 {
                                    var from = 0;
                                    if j > 0 {
                                        from = vec.get(ner, j - 1);
                                    }
                                    if bytes.equal(buffer.bytes(nbr)[from..vec.get(ner, j)], byname) {
                                        if matches == 0 {
                                            by = j;
                                        }
                                        matches = matches + 1;
                                    }
                                    j = j + 1;
                                }
                            }
                        }
                        buffer.drop(heap, nb);
                        vec.drop(heap, ne);
                        if matches == 0 {
                            e = refuse(heap, e, "stats.no-such-column", "--by names no column of the header", "the header names are the first line of the file; the match is exact", "by", byname);
                            by = 0 - 1;
                            stop = true;
                        } else if matches > 1 {
                            e = refuse(heap, e, "stats.ambiguous-column", "two or more columns have the name given to --by", "rename the columns so that the name is unique", "by", byname);
                            by = 0 - 1;
                            stop = true;
                        } else {
                            ncols = seps + 1;
                            unbox_slice(heap, cells);
                            cells = box_slice(heap, 3 * ncols + 4, 0);
                            have_header = true;
                        }
                    }
                } else if len(line) > 0 || ncols == 1 {
                    if rows >= max_rows {
                        e = refuse_int(heap, e, "limit.too-many-rows", "more data rows than --max-rows", "raise --max-rows", "limit", max_rows, "line", number);
                        stop = true;
                    } else {
                        rows = rows + 1;
                        borrow mut cells as &!cw in {
                            let cs = contents(cw);
                            let (n, inside, badq) = reader.fields(line, delim, cs, ncols);
                            if inside {
                                e = record_refusal(heap, e, 2, number, ncols, max_rows, 0);
                                stop = true;
                            } else if badq {
                                e = record_refusal(heap, e, 3, number, ncols, max_rows, 0);
                                stop = true;
                            } else if n != ncols {
                                e = record_refusal(heap, e, 1, number, ncols, max_rows, 0);
                                stop = true;
                            } else {
                                let from = cs[3 * by];
                                let to = cs[3 * by + 1];
                                if to == from && cs[3 * by + 2] == 0 {
                                    nulls = nulls + 1;
                                } else {
                                    var known = false;
                                    var room = false;
                                    borrow m as &mr in {
                                        known = map.has(mr, line[from..to]);
                                        room = map.size(mr) < max_groups;
                                    }
                                    if known {
                                    } else if room {
                                        m = map.put(heap, m, line[from..to], 1);
                                    } else {
                                        e = refuse_int(heap, e, "limit.too-many-groups", "more groups than --max-groups", "raise --max-groups or group by a column with fewer values", "limit", max_groups, "line", number);
                                        stop = true;
                                    }
                                }
                            }
                        }
                    }
                }
            }
            if stop {
                going = false;
            }
        }
    }
    var errno = 0;
    borrow r as &rr in {
        errno = lines.failed(rr);
    }
    lines.drop(heap, r);
    unbox_slice(heap, cells);
    if errno != 0 {
        e = fail.io_error(heap, e, errno, false, shown);
    }
    if !have_header {
        by = 0 - 1;
        var refused = false;
        borrow e as &er in {
            refused = fail.count(er) > 0;
        }
        if !refused {
            e = refuse(heap, e, "stats.no-header", "the file has no header line", "give a CSV file whose first line names the columns", "file", shown);
        }
    }
    // the groups in the order of their bytes: an insertion sort of the entry numbers (at most --max-groups of them)
    var ng = 0;
    borrow m as &mr0 in {
        ng = map.size(mr0);
    }
    let order = box_slice(heap, ng + 1, 0);
    borrow m as &mr1 in {
        borrow mut order as &!ow in {
            let o = contents(ow);
            var k = 0;
            var en = 0;
            while en < map.entries(mr1) {
                if map.is_live(mr1, en) {
                    var pos = k;
                    while pos > 0 && bytes.compare(map.key_at(mr1, o[pos - 1]), map.key_at(mr1, en)) > 0 {
                        o[pos] = o[pos - 1];
                        pos = pos - 1;
                    }
                    o[pos] = en;
                    k = k + 1;
                }
                en = en + 1;
            }
        }
    }
    return (Groups { m: m, order: order, nulls: nulls }, by, e);
}

// The refusal for a record `take_row` did not take: 1 ragged, 2 continues on the next line, 3 a bad quote, 5 the rows limit, 6 the cells limit.
fn record_refusal[&h](heap: &!h Heap, e: fail.Errors, st: int, number: int, ncols: int, max_rows: int, max_cells: int) -> [heap] fail.Errors {
    if st == 1 {
        return refuse_int(heap, e, "stats.csv-ragged", "a record has a different number of fields than the header", "check the delimiter and the quoting of that line", "line", number, "columns", ncols);
    }
    if st == 2 {
        return refuse_int(heap, e, "stats.csv-multiline", "a record continues on the next line, which this version does not read", "join the record onto one line", "line", number, "columns", ncols);
    }
    if st == 3 {
        return refuse_int(heap, e, "stats.csv-bad-quote", "a quote opens or closes where it may not", "write the line as RFC 4180", "line", number, "columns", ncols);
    }
    if st == 5 {
        return refuse_int(heap, e, "limit.too-many-rows", "more data rows than --max-rows", "raise --max-rows", "limit", max_rows, "line", number);
    }
    return refuse_int(heap, e, "limit.too-many-cells", "more cells than --max-cells are needed to hold the columns for the quantiles", "raise --max-cells or describe fewer rows", "limit", max_cells, "line", number);
}

struct Scanned {
    rows: int,
    ncols: int,
}

// the file, line by line: the header, then the records
fn read_file[&h, &g, &p, &f, &s, &k](heap: &!h Heap, args: &g Args, parsed: &p cli.Parsed, file: &!f File, shown: &s [byte], by: int, key: &k [byte], by_null: bool, errs: fail.Errors) -> [heap, args, file_read] (buffer.Buffer, vec.Vec[int], Cols, vec.Vec[int], Scanned, fail.Errors) {
    let table = flag_table();
    let cap = cli.nat(args, parsed, table, "max-line-bytes");
    let delim = int_of(cli.text(args, parsed, table, "delim")[0]);
    let max_rows = cli.nat(args, parsed, table, "max-rows");
    let max_cols = cli.nat(args, parsed, table, "max-cols");
    let max_cells = cli.nat(args, parsed, table, "max-cells");
    var store = vec.empty(heap, 1024, 0);
    var e = errs;
    var names = buffer.empty(heap, 1);
    var ends = vec.empty(heap, 1, 0);
    var cols = make_cols(heap, 1);
    var info = Scanned { rows: 0, ncols: 0 };
    var r = lines.start(heap, cap);
    var going = true;
    var have_header = false;
    var number = 0;
    while going {
        let (stepped, status) = lines.next(heap, r);
        r = stepped;
        if status == lines.need() {
            r = lines.fill_file(r, file);
        } else if status == lines.done() {
            going = false;
        } else if status == lines.long() {
            var n = 0;
            borrow r as &rr in {
                n = lines.number(rr);
            }
            e = refuse(heap, e, "limit.line-too-long", "a line is longer than --max-line-bytes", "raise --max-line-bytes", "file", shown);
            going = false;
        } else {
            number = number + 1;
            var stop = false;
            borrow r as &rr in {
                let line = lines.text(rr);
                if !have_header {
                    let (open, seps, badq) = reader.scan(line, delim, false, 0);
                    if open {
                        e = refuse(heap, e, "stats.csv-multiline", "the header continues on the next line", "put the header on one line", "file", shown);
                        stop = true;
                    } else if badq {
                        e = refuse(heap, e, "stats.csv-bad-quote", "a quote in the header opens or closes where it may not", "write the header as RFC 4180", "file", shown);
                        stop = true;
                    } else if seps + 1 > max_cols {
                        e = refuse_int(heap, e, "limit.too-many-columns", "more columns than --max-cols", "raise --max-cols", "limit", max_cols, "columns", seps + 1);
                        stop = true;
                    } else {
                        let (nb, ne) = reader.split_header(heap, line, delim);
                        buffer.drop(heap, names);
                        vec.drop(heap, ends);
                        names = nb;
                        ends = ne;
                        drop_cols(heap, cols);
                        cols = make_cols(heap, seps + 1);
                        info = Scanned { rows: 0, ncols: seps + 1 };
                        have_header = true;
                    }
                } else if len(line) > 0 || info.ncols == 1 {
                    // a blank line is skipped, except in a file of one column, where it is one empty cell
                    var room = 0;
                    if info.rows >= max_rows {
                        room = 1;
                    } else if (info.rows + 1) * info.ncols > max_cells {
                        room = 2;
                    }
                    borrow mut cols as &!cw in {
                        let st = take_row(cw, line, delim, info.ncols, by, key, by_null, room);
                        if st == 0 {
                            info = Scanned { rows: info.rows + 1, ncols: info.ncols };
                            var jj = 0;
                            while jj < info.ncols {
                                store = vec.push(heap, store, contents(cw.rowkeys)[jj]);
                                jj = jj + 1;
                            }
                        } else if st != 4 {
                            e = record_refusal(heap, e, st, number, info.ncols, max_rows, max_cells);
                            stop = true;
                        }
                    }
                }
            }
            if stop {
                going = false;
            }
        }
    }
    var errno = 0;
    borrow r as &rr in {
        errno = lines.failed(rr);
    }
    lines.drop(heap, r);
    if errno != 0 {
        e = fail.io_error(heap, e, errno, false, shown);
    }
    if !have_header {
        e = refuse(heap, e, "stats.no-header", "the file has no header line", "give a CSV file whose first line names the columns", "file", shown);
    }
    return (names, ends, cols, store, info, e);
}

// One description: the file opened and read (only the records of the group when `by` >= 0), the levels of its text columns, and what is written to `w0`: with `as_group` an object of the group, without it the `rows`, the settings and the `columns` of the whole file.
fn describe_one[&h, &g, &p, &f, &r, &sh, &fu, &k](heap: &!h Heap, args: &g Args, parsed: &p cli.Parsed, fs: &f Fs(""), root: &r [byte], rel: &sh [byte], full: &fu [byte], by: int, key: &k [byte], by_null: bool, as_group: bool, w0: json.Writer, errs: fail.Errors) -> [heap, args, fs_read(""), dir_read, file_read] (json.Writer, fail.Errors) {
    let table = flag_table();
    var w = w0;
    var e = errs;
    match place.open_operand(fs, root, rel, full) {
        Opened::Failed(reason) => {
            e = fail.io_error(heap, e, reason, false, rel);
        }
        Opened::Ok(opened) => {
            var file = opened;
            borrow mut file as &!handle in {
                let (names, ends, cols, store, info, e2) = read_file(heap, args, parsed, handle, rel, by, key, by_null, e);
                e = e2;
                var clean = false;
                borrow e as &er2 in {
                    clean = fail.count(er2) == 0;
                }
                if clean {
                    let k = cli.nat(args, parsed, table, "levels");
                    var lv = make_levels(heap, 1, 1);
                    var counted = false;
                    var any_text = false;
                    let sel = box_slice(heap, info.ncols + 1, 1);
                    var cols_ok = true;
                    if cli.has(parsed, table, "cols") {
                        var st = 0;
                        var item = 0;
                        borrow names as &nb0 in {
                            borrow ends as &eb0 in {
                                borrow mut sel as &!sw0 in {
                                    let (s1, i1) = pick.select(buffer.bytes(nb0), eb0, info.ncols, cli.text(args, parsed, table, "cols"), contents(sw0));
                                    st = s1;
                                    item = i1;
                                }
                            }
                        }
                        let one = bytes.field(cli.text(args, parsed, table, "cols"), ',', item + 1);
                        if st == 1 {
                            cols_ok = false;
                            e = refuse(heap, e, "stats.no-such-column", "--cols names a column the header does not have", "the header names are the first line of the file; the match is exact", "column", one);
                        } else if st == 2 {
                            cols_ok = false;
                            e = refuse(heap, e, "stats.ambiguous-column", "two or more columns have a name given to --cols", "rename the columns so that the name is unique", "column", one);
                        } else if st == 3 {
                            cols_ok = false;
                            e = refuse(heap, e, "args.bad-value", "--cols has an empty item", "--cols name1,name2: no empty item, no leading or trailing comma", "flag", "--cols");
                        }
                    }
                    borrow cols as &c0 in {
                        borrow sel as &sr0 in {
                            var jt = 0;
                            while jt < info.ncols {
                                if contents(c0.nonmiss)[jt] > 0 && contents(c0.bad)[jt] == 1 && contents(sr0)[jt] == 1 {
                                    any_text = true;
                                }
                                jt = jt + 1;
                            }
                        }
                    }
                    if k > 0 && any_text && cols_ok {
                        counted = true;
                        match place.open_operand(fs, root, rel, full) {
                            Opened::Failed(reason) => {
                                e = fail.io_error(heap, e, reason, false, rel);
                            }
                            Opened::Ok(again) => {
                                var file2 = again;
                                borrow mut file2 as &!handle2 in {
                                    borrow cols as &c1 in {
                                        borrow sel as &sr1 in {
                                            let fresh = make_levels(heap, info.ncols, k);
                                            drop_levels(heap, lv);
                                            let (lv2, e4) = level_pass(heap, handle2, rel, c1, contents(sr1), info.ncols, by, key, by_null, info.rows, int_of(cli.text(args, parsed, table, "delim")[0]), cli.nat(args, parsed, table, "max-line-bytes"), k, cli.nat(args, parsed, table, "max-levels"), fresh, e);
                                            lv = lv2;
                                            e = e4;
                                        }
                                    }
                                }
                                file_close(file2);
                            }
                        }
                    }
                    var clean2 = false;
                    borrow e as &er3 in {
                        clean2 = fail.count(er3) == 0;
                    }
                    if clean2 {
                        let ddof = cli.nat(args, parsed, table, "ddof");
                        let qtype = cli.nat(args, parsed, table, "quantile-type");
                        borrow names as &nb in {
                            borrow ends as &eb in {
                                borrow cols as &cb in {
                                    borrow store as &sb in {
                                        borrow sel as &sr2 in {
                                            borrow lv as &lb in {
                                                if as_group {
                                                    w = json.begin_object(heap, w);
                                                    w = json.put_key(heap, w, "value");
                                                    if by_null {
                                                        w = json.put_null(heap, w);
                                                    } else {
                                                        w = text.put(heap, w, key);
                                                    }
                                                    w = json.put_key(heap, w, "rows");
                                                    w = json.put_int(heap, w, info.rows);
                                                } else {
                                                    w = json.put_key(heap, w, "rows");
                                                    w = json.put_int(heap, w, info.rows);
                                                    w = put_settings(heap, w, ddof, qtype);
                                                }
                                                w = report_columns(heap, w, cb, contents(sr2), buffer.bytes(nb), eb, sb, info.ncols, info.rows, ddof, qtype, cli.text(args, parsed, table, "quantiles"), cli.nat(args, parsed, table, "bins"), lb, k, counted);
                                                if as_group {
                                                    w = json.end_object(heap, w);
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    drop_levels(heap, lv);
                    unbox_slice(heap, sel);
                }
                buffer.drop(heap, names);
                vec.drop(heap, ends);
                drop_cols(heap, cols);
                vec.drop(heap, store);
            }
            file_close(file);
        }
    }
    return (w, e);
}

// ------------------------------------------------------------------------------------------------ corr (docs/corr.md)

// The pairs of the numeric columns of one file (or of --cols), Pearson. The same file reader as describe: the order-preserving keys of the cells are in `store`.
fn corr_one[&h, &g, &p, &f, &r, &sh, &fu](heap: &!h Heap, args: &g Args, parsed: &p cli.Parsed, fs: &f Fs(""), root: &r [byte], rel: &sh [byte], full: &fu [byte], w0: json.Writer, errs: fail.Errors) -> [heap, args, fs_read(""), dir_read, file_read] (json.Writer, fail.Errors) {
    let table = flag_table();
    var w = w0;
    var e = errs;
    match place.open_operand(fs, root, rel, full) {
        Opened::Failed(reason) => {
            e = fail.io_error(heap, e, reason, false, rel);
        }
        Opened::Ok(opened) => {
            var file = opened;
            borrow mut file as &!handle in {
                let (names, ends, cols, store, info, e2) = read_file(heap, args, parsed, handle, rel, 0 - 1, "", false, e);
                e = e2;
                var clean = false;
                borrow e as &er2 in {
                    clean = fail.count(er2) == 0;
                }
                if clean {
                    let nc = info.ncols;
                    let sel = box_slice(heap, nc + 1, 0);
                    var cols_ok = true;
                    var named = false;
                    if cli.has(parsed, table, "cols") {
                        named = true;
                        var st = 0;
                        var item = 0;
                        borrow names as &nb0 in {
                            borrow ends as &eb0 in {
                                borrow mut sel as &!sw0 in {
                                    let (s1, i1) = pick.select(buffer.bytes(nb0), eb0, nc, cli.text(args, parsed, table, "cols"), contents(sw0));
                                    st = s1;
                                    item = i1;
                                }
                            }
                        }
                        let one = bytes.field(cli.text(args, parsed, table, "cols"), ',', item + 1);
                        if st == 1 {
                            cols_ok = false;
                            e = refuse(heap, e, "stats.no-such-column", "--cols names a column the header does not have", "the header names are the first line of the file; the match is exact", "column", one);
                        } else if st == 2 {
                            cols_ok = false;
                            e = refuse(heap, e, "stats.ambiguous-column", "two or more columns have a name given to --cols", "rename the columns so that the name is unique", "column", one);
                        } else if st == 3 {
                            cols_ok = false;
                            e = refuse(heap, e, "args.bad-value", "--cols has an empty item", "--cols name1,name2: no empty item, no leading or trailing comma", "flag", "--cols");
                        }
                    }
                    var m = 0;
                    if cols_ok {
                        borrow cols as &c0 in {
                            borrow mut sel as &!sw1 in {
                                var j = 0;
                                while j < nc {
                                    let numeric = contents(c0.numeric)[j] > 0 && contents(c0.bad)[j] == 0;
                                    if !named {
                                        if numeric {
                                            contents(sw1)[j] = 1;
                                        }
                                    } else if contents(sw1)[j] == 1 && !numeric && cols_ok {
                                        cols_ok = false;
                                        borrow names as &nb1 in {
                                            borrow ends as &eb1 in {
                                                var from = 0;
                                                if j > 0 {
                                                    from = vec.get(eb1, j - 1);
                                                }
                                                e = refuse(heap, e, "stats.non-numeric", "--cols names a column that has no numbers or has a cell that is not a number", "name numeric columns only", "column", buffer.bytes(nb1)[from..vec.get(eb1, j)]);
                                            }
                                        }
                                    }
                                    j = j + 1;
                                }
                                j = 0;
                                while j < nc {
                                    if contents(sw1)[j] == 1 {
                                        m = m + 1;
                                    }
                                    j = j + 1;
                                }
                            }
                        }
                    }
                    if cols_ok && m < 2 {
                        cols_ok = false;
                        e = refuse_int(heap, e, "stats.corr-columns", "fewer than two numeric columns to correlate", "name two or more numeric columns with --cols", "columns", m, "line", 0);
                    }
                    let pairs = m * (m - 1) / 2;
                    if cols_ok && pairs > cli.nat(args, parsed, table, "max-pairs") {
                        cols_ok = false;
                        e = refuse_int(heap, e, "limit.too-many-pairs", "more pairs of columns than --max-pairs", "raise --max-pairs or name fewer columns with --cols", "limit", cli.nat(args, parsed, table, "max-pairs"), "pairs", pairs);
                    }
                    if cols_ok {
                        let idx = box_slice(heap, m + 1, 0);
                        let mask = box_slice(heap, info.rows + 1, 1);
                        let listwise = bytes.equal(cli.text(args, parsed, table, "missing"), "listwise");
                        borrow sel as &sr in {
                            borrow mut idx as &!iw in {
                                var j = 0;
                                var at = 0;
                                while j < nc {
                                    if contents(sr)[j] == 1 {
                                        contents(iw)[at] = j;
                                        at = at + 1;
                                    }
                                    j = j + 1;
                                }
                            }
                        }
                        borrow store as &sb in {
                            borrow idx as &ir in {
                                borrow mut mask as &!mw in {
                                    if listwise {
                                        var i = 0;
                                        while i < info.rows {
                                            var k = 0;
                                            while k < m {
                                                if vec.get(sb, i * nc + contents(ir)[k]) == rank.min_int() {
                                                    contents(mw)[i] = 0;
                                                }
                                                k = k + 1;
                                            }
                                            i = i + 1;
                                        }
                                    }
                                }
                                borrow mask as &mr in {
                                    borrow names as &nb in {
                                        borrow ends as &eb in {
                                            w = json.put_key(heap, w, "rows");
                                            w = json.put_int(heap, w, info.rows);
                                            w = json.put_key(heap, w, "method");
                                            w = json.put_string(heap, w, cli.text(args, parsed, table, "method"));
                                            w = json.put_key(heap, w, "missing");
                                            w = json.put_string(heap, w, cli.text(args, parsed, table, "missing"));
                                            w = json.put_key(heap, w, "adjustment");
                                            w = json.put_string(heap, w, "none");
                                            w = json.put_key(heap, w, "columns");
                                            w = json.begin_array(heap, w);
                                            var k = 0;
                                            while k < m {
                                                w = answer.put_name(heap, w, buffer.bytes(nb), eb, contents(ir)[k]);
                                                k = k + 1;
                                            }
                                            w = json.end_array(heap, w);
                                            w = json.put_key(heap, w, "pairs");
                                            w = json.begin_array(heap, w);
                                            var method = 0;
                                            if bytes.equal(cli.text(args, parsed, table, "method"), "spearman") {
                                                method = 1;
                                            } else if bytes.equal(cli.text(args, parsed, table, "method"), "kendall") {
                                                method = 2;
                                            }
                                            var ia = 0;
                                            while ia < m {
                                                var ib = ia + 1;
                                                while ib < m {
                                                    if method == 2 {
                                                        w = answer.put_pair_kendall(heap, w, buffer.bytes(nb), eb, sb, nc, contents(ir)[ia], contents(ir)[ib], info.rows, contents(mr));
                                                    } else {
                                                        w = answer.put_pair(heap, w, buffer.bytes(nb), eb, sb, nc, contents(ir)[ia], contents(ir)[ib], info.rows, contents(mr), method);
                                                    }
                                                    ib = ib + 1;
                                                }
                                                ia = ia + 1;
                                            }
                                            w = json.end_array(heap, w);
                                        }
                                    }
                                }
                            }
                        }
                        unbox_slice(heap, idx);
                        unbox_slice(heap, mask);
                    }
                    unbox_slice(heap, sel);
                }
                buffer.drop(heap, names);
                vec.drop(heap, ends);
                drop_cols(heap, cols);
                vec.drop(heap, store);
            }
            file_close(file);
        }
    }
    return (w, e);
}

// ------------------------------------------------------------------------------------------------ test (docs/test.md)

// The tests of the columns named by --cols, kind t1 (docs/test.md). The same file reader as describe and corr.
fn test_one[&h, &g, &p, &f, &r, &sh, &fu](heap: &!h Heap, args: &g Args, parsed: &p cli.Parsed, fs: &f Fs(""), root: &r [byte], rel: &sh [byte], full: &fu [byte], w0: json.Writer, errs: fail.Errors) -> [heap, args, fs_read(""), dir_read, file_read] (json.Writer, fail.Errors) {
    let table = flag_table();
    var w = w0;
    var e = errs;
    match place.open_operand(fs, root, rel, full) {
        Opened::Failed(reason) => {
            e = fail.io_error(heap, e, reason, false, rel);
        }
        Opened::Ok(opened) => {
            var file = opened;
            borrow mut file as &!handle in {
                let (names, ends, cols, store, info, e2) = read_file(heap, args, parsed, handle, rel, 0 - 1, "", false, e);
                e = e2;
                var clean = false;
                borrow e as &er2 in {
                    clean = fail.count(er2) == 0;
                }
                if clean {
                    let nc = info.ncols;
                    let sel = box_slice(heap, nc + 1, 0);
                    var cols_ok = true;
                    var st = 0;
                    var item = 0;
                    borrow names as &nb0 in {
                        borrow ends as &eb0 in {
                            borrow mut sel as &!sw0 in {
                                let (s1, i1) = pick.select(buffer.bytes(nb0), eb0, nc, cli.text(args, parsed, table, "cols"), contents(sw0));
                                st = s1;
                                item = i1;
                            }
                        }
                    }
                    let one = bytes.field(cli.text(args, parsed, table, "cols"), ',', item + 1);
                    if st == 1 {
                        cols_ok = false;
                        e = refuse(heap, e, "stats.no-such-column", "--cols names a column the header does not have", "the header names are the first line of the file; the match is exact", "column", one);
                    } else if st == 2 {
                        cols_ok = false;
                        e = refuse(heap, e, "stats.ambiguous-column", "two or more columns have a name given to --cols", "rename the columns so that the name is unique", "column", one);
                    } else if st == 3 {
                        cols_ok = false;
                        e = refuse(heap, e, "args.bad-value", "--cols has an empty item", "--cols name1,name2: no empty item, no leading or trailing comma", "flag", "--cols");
                    }
                    if cols_ok {
                        borrow cols as &c0 in {
                            borrow sel as &sr in {
                                var j = 0;
                                while j < nc {
                                    let numeric = contents(c0.numeric)[j] > 0 && contents(c0.bad)[j] == 0;
                                    if contents(sr)[j] == 1 && !numeric && cols_ok {
                                        cols_ok = false;
                                        borrow names as &nb1 in {
                                            borrow ends as &eb1 in {
                                                var from = 0;
                                                if j > 0 {
                                                    from = vec.get(eb1, j - 1);
                                                }
                                                e = refuse(heap, e, "stats.non-numeric", "--cols names a column that has no numbers or has a cell that is not a number", "name numeric columns only", "column", buffer.bytes(nb1)[from..vec.get(eb1, j)]);
                                            }
                                        }
                                    }
                                    j = j + 1;
                                }
                            }
                        }
                    }
                    if cols_ok {
                        let (mkey, mst) = flt.parse_float(cli.text(args, parsed, table, "mu0"));
                        let mu0 = flt.float_of_key(mkey);
                        let (lnum, lk, lok) = parse_p(cli.text(args, parsed, table, "level"));
                        let level = float_of(lnum) / float_of(quantile.pow10(lk));
                        borrow store as &sb in {
                            borrow sel as &sr3 in {
                                borrow names as &nb in {
                                    borrow ends as &eb in {
                                        w = json.put_key(heap, w, "test");
                                        w = json.put_string(heap, w, "t1");
                                        w = json.put_key(heap, w, "rows");
                                        w = json.put_int(heap, w, info.rows);
                                        w = json.put_key(heap, w, "mu0");
                                        w = json.put_float(heap, w, mu0);
                                        w = json.put_key(heap, w, "level");
                                        w = json.put_float(heap, w, level);
                                        w = json.put_key(heap, w, "adjustment");
                                        w = json.put_string(heap, w, "none");
                                        w = json.put_key(heap, w, "tests");
                                        w = json.begin_array(heap, w);
                                        var j = 0;
                                        while j < nc {
                                            if contents(sr3)[j] == 1 {
                                                w = answer.put_t1(heap, w, buffer.bytes(nb), eb, sb, nc, j, info.rows, bits_of(mu0), lnum, lk, level);
                                            }
                                            j = j + 1;
                                        }
                                        w = json.end_array(heap, w);
                                    }
                                }
                            }
                        }
                    }
                    unbox_slice(heap, sel);
                }
                buffer.drop(heap, names);
                vec.drop(heap, ends);
                drop_cols(heap, cols);
                vec.drop(heap, store);
            }
            file_close(file);
        }
    }
    return (w, e);
}

fn body[&h, &g, &p, &f, &i](heap: &!h Heap, args: &g Args, parsed: &p cli.Parsed, fs: &f Fs(""), io: &!i Io, errs: fail.Errors) -> [heap, args, fs_read(""), dir_read, file_read, io_write, err_write] int {
    let table = flag_table();
    var e = errs;
    var is_test = false;
    var fidx = 1;
    if cli.operand_count(parsed) == 0 {
        e = refuse(heap, e, "args.missing-operand", "no verb: the first operand names what to do", "stats describe FILE", "", "");
    } else if !bytes.equal(cli.operand(args, parsed, 0), "describe") && !bytes.equal(cli.operand(args, parsed, 0), "corr") && !bytes.equal(cli.operand(args, parsed, 0), "test") {
        e = refuse(heap, e, "stats.bad-verb", "the first operand is not a verb this tool has", "the verbs are: describe, corr, test", "verb", cli.operand(args, parsed, 0));
    } else if bytes.equal(cli.operand(args, parsed, 0), "test") {
        is_test = true;
        fidx = 2;
        if cli.operand_count(parsed) < 2 {
            e = refuse(heap, e, "args.missing-operand", "no kind of test: the second operand names it", "stats test t1 --cols A,B FILE", "", "");
        } else if !bytes.equal(cli.operand(args, parsed, 1), "t1") {
            e = refuse(heap, e, "args.bad-value", "the kind of test is not one this tool has", "the kinds so far are: t1", "kind", cli.operand(args, parsed, 1));
        } else if cli.operand_count(parsed) < 3 {
            e = refuse(heap, e, "args.missing-operand", "no FILE to test", "stats test t1 --cols A,B FILE", "", "");
        } else if cli.operand_count(parsed) > 3 {
            e = refuse(heap, e, "args.too-many-operands", "one FILE only", "test one file per call", "", "");
        }
        if !cli.has(parsed, table, "cols") {
            e = refuse(heap, e, "stats.test-columns", "test names no column: --cols is required", "stats test t1 --cols A,B FILE", "flag", "--cols");
        }
    } else if cli.operand_count(parsed) < 2 {
        e = refuse(heap, e, "args.missing-operand", "no FILE to describe", "stats describe FILE", "", "");
    } else if cli.operand_count(parsed) > 2 {
        e = refuse(heap, e, "args.too-many-operands", "one FILE only", "describe one file per call", "", "");
    }
    let (mu_key, mu_status) = flt.parse_float(cli.text(args, parsed, table, "mu0"));
    if mu_status != 0 {
        e = refuse(heap, e, "args.bad-value", "--mu0 is a number", "--mu0 0 or --mu0 21.5", "flag", "--mu0");
    }
    let (lv_num, lv_k, lv_ok) = parse_p(cli.text(args, parsed, table, "level"));
    if !lv_ok || lv_num == 0 || lv_num >= quantile.pow10(lv_k) {
        e = refuse(heap, e, "args.bad-value", "--level is a decimal strictly between 0 and 1 with at most 9 decimals", "--level 0.95", "flag", "--level");
    }
    if len(cli.text(args, parsed, table, "delim")) != 1 {
        e = refuse(heap, e, "args.bad-value", "--delim is one byte", "--delim , or --delim ';'", "flag", "--delim");
    }
    if cli.nat(args, parsed, table, "max-rows") > row_ceiling() {
        e = refuse(heap, e, "args.bad-value", "--max-rows is above the ceiling", "10000000 is the most this tool reads", "flag", "--max-rows");
    }
    if cli.nat(args, parsed, table, "max-cols") > col_ceiling() || cli.nat(args, parsed, table, "max-cols") < 1 {
        e = refuse(heap, e, "args.bad-value", "--max-cols is outside 1 to 4096", "4096 is the most this tool holds", "flag", "--max-cols");
    }
    if cli.nat(args, parsed, table, "max-line-bytes") > line_ceiling() {
        e = refuse(heap, e, "args.bad-value", "--max-line-bytes is above the ceiling", "16777216 is the most this tool holds", "flag", "--max-line-bytes");
    }
    if cli.nat(args, parsed, table, "max-cells") > 100000000 || cli.nat(args, parsed, table, "max-cells") < 1 {
        e = refuse(heap, e, "args.bad-value", "--max-cells is outside 1 to 100000000", "100000000 is the most this tool holds", "flag", "--max-cells");
    }
    if cli.nat(args, parsed, table, "quantile-type") < 1 || cli.nat(args, parsed, table, "quantile-type") > 9 {
        e = refuse(heap, e, "args.bad-value", "--quantile-type is 1 to 9", "type 7 is the default of R and numpy", "flag", "--quantile-type");
    }
    if cli.nat(args, parsed, table, "bins") > 1000 {
        e = refuse(heap, e, "args.bad-value", "--bins is above the ceiling", "1000 is the most bins this tool counts", "flag", "--bins");
    }
    if cli.nat(args, parsed, table, "levels") > 100 {
        e = refuse(heap, e, "args.bad-value", "--levels is above the ceiling", "100 is the most levels this tool prints", "flag", "--levels");
    }
    if cli.nat(args, parsed, table, "max-levels") > 1000000 || cli.nat(args, parsed, table, "max-levels") < 1 {
        e = refuse(heap, e, "args.bad-value", "--max-levels is outside 1 to 1000000", "1000000 is the most pairs this tool holds", "flag", "--max-levels");
    }
    if cli.nat(args, parsed, table, "max-groups") > 1000 || cli.nat(args, parsed, table, "max-groups") < 1 {
        e = refuse(heap, e, "args.bad-value", "--max-groups is outside 1 to 1000", "1000 is the most groups this tool describes", "flag", "--max-groups");
    }
    if !valid_list(cli.text(args, parsed, table, "quantiles")) {
        e = refuse(heap, e, "args.bad-value", "--quantiles takes at most 99 comma separated decimals from 0 to 1 with at most 9 decimals", "--quantiles 0.25,0.5,0.75", "flag", "--quantiles");
    }
    if cli.nat(args, parsed, table, "max-pairs") > 32640 || cli.nat(args, parsed, table, "max-pairs") < 1 {
        e = refuse(heap, e, "args.bad-value", "--max-pairs is outside 1 to 32640", "32640 is the pairs of 256 columns", "flag", "--max-pairs");
    }
    if cli.nat(args, parsed, table, "ddof") > 1 {
        e = refuse(heap, e, "args.bad-value", "--ddof is 0 or 1", "0 divides by n, 1 by n - 1", "flag", "--ddof");
    }
    let (root, after_root) = path.root(heap, args, cli.text(args, parsed, table, "root"), cli.value_index(parsed, table, "root"), e);
    e = after_root;
    var refused = false;
    borrow e as &er in {
        refused = fail.count(er) > 0;
    }
    var data = buffer.empty(heap, 1);
    var plain = buffer.empty(heap, 1);
    let text_mode = bytes.equal(cli.text(args, parsed, table, "format"), "text");
    if !refused {
        borrow root as &rr in {
            let (target, checked) = path.operand(heap, args, buffer.bytes(rr), cli.operand_index(parsed, fidx), e);
            e = checked;
            borrow target as &tp in {
                if path.ok(tp) {
                    var w = json.writer(heap, 1024);
                    w = json.begin_object(heap, w);
                    let ddof = cli.nat(args, parsed, table, "ddof");
                    let qtype = cli.nat(args, parsed, table, "quantile-type");
                    if is_test {
                        let (w2, e2) = test_one(heap, args, parsed, fs, buffer.bytes(rr), path.shown(tp), path.full(tp), w, e);
                        w = w2;
                        e = e2;
                    } else if bytes.equal(cli.operand(args, parsed, 0), "corr") {
                        let (w2, e2) = corr_one(heap, args, parsed, fs, buffer.bytes(rr), path.shown(tp), path.full(tp), w, e);
                        w = w2;
                        e = e2;
                    } else if !cli.has(parsed, table, "by") {
                        let (w2, e2) = describe_one(heap, args, parsed, fs, buffer.bytes(rr), path.shown(tp), path.full(tp), 0 - 1, "", false, false, w, e);
                        w = w2;
                        e = e2;
                    } else {
                        w = put_settings(heap, w, ddof, qtype);
                        w = json.put_key(heap, w, "by");
                        w = json.put_string(heap, w, cli.text(args, parsed, table, "by"));
                        w = json.put_key(heap, w, "groups");
                        w = json.begin_array(heap, w);
                        match place.open_operand(fs, buffer.bytes(rr), path.shown(tp), path.full(tp)) {
                            Opened::Failed(reason) => {
                                e = fail.io_error(heap, e, reason, false, path.shown(tp));
                            }
                            Opened::Ok(opened) => {
                                var file = opened;
                                borrow mut file as &!handle in {
                                    let (groups, by, e5) = discover(heap, handle, path.shown(tp), cli.text(args, parsed, table, "by"), int_of(cli.text(args, parsed, table, "delim")[0]), cli.nat(args, parsed, table, "max-line-bytes"), cli.nat(args, parsed, table, "max-rows"), cli.nat(args, parsed, table, "max-cols"), cli.nat(args, parsed, table, "max-groups"), e);
                                    e = e5;
                                    borrow groups as &gr in {
                                        let ng = map.size(gr.m);
                                        var gi = 0;
                                        while gi < ng {
                                            var clean = false;
                                            borrow e as &er4 in {
                                                clean = fail.count(er4) == 0;
                                            }
                                            if clean {
                                                let (w3, e3) = describe_one(heap, args, parsed, fs, buffer.bytes(rr), path.shown(tp), path.full(tp), by, map.key_at(gr.m, contents(gr.order)[gi]), false, true, w, e);
                                                w = w3;
                                                e = e3;
                                            }
                                            gi = gi + 1;
                                        }
                                        var clean_null = false;
                                        borrow e as &er5 in {
                                            clean_null = fail.count(er5) == 0;
                                        }
                                        if clean_null && gr.nulls > 0 {
                                            let (w4, e4) = describe_one(heap, args, parsed, fs, buffer.bytes(rr), path.shown(tp), path.full(tp), by, "", true, true, w, e);
                                            w = w4;
                                            e = e4;
                                        }
                                    }
                                    drop_groups(heap, groups);
                                }
                                file_close(file);
                            }
                        }
                        w = json.end_array(heap, w);
                    }
                    w = json.end_object(heap, w);
                    let doc = json.finish(w);
                    var ok = false;
                    borrow e as &er6 in {
                        ok = fail.count(er6) == 0;
                    }
                    if ok {
                        buffer.drop(heap, data);
                        data = doc;
                        if text_mode {
                            buffer.drop(heap, plain);
                            borrow data as &dd in {
                                plain = flat.flatten(heap, buffer.bytes(dd));
                            }
                        }
                    } else {
                        buffer.drop(heap, doc);
                    }
                }
            }
            path.drop(heap, target);
        }
    }
    buffer.drop(heap, root);
    var status = 0;
    borrow e as &er in {
        borrow data as &d in {
            borrow plain as &pl in {
                status = out.respond(heap, io, "stats", "stats.v1", "0.1.0", buffer.bytes(d), "", er, text_mode, buffer.bytes(pl), 0);
            }
        }
    }
    buffer.drop(heap, data);
    buffer.drop(heap, plain);
    fail.drop(heap, e);
    return status;
}

fn run[&h, &g, &f, &i](heap: &!h Heap, args: &g Args, fs: &f Fs(""), io: &!i Io) -> [heap, args, fs_read(""), dir_read, file_read, io_write, err_write] int {
    let which = cli.subcommand(args);
    if which != 0 {
        return describe.answer(heap, io, which, tool(), built());
    }
    let (parsed, e) = cli.parse(heap, args, flag_table(), fail.empty_in(heap, extra()));
    var status = 0;
    borrow parsed as &p in {
        status = body(heap, args, p, fs, io, e);
    }
    cli.drop(heap, parsed);
    return status;
}

fn main(world: World) -> [] int {
    let Split { io, ffi, fs, heap, args, net, clock } = split(world);
    // No foreign code, no network, no clock.
    release(ffi);
    release(net);
    release(clock);
    var status = 0;
    borrow mut heap as &!h in {
        borrow args as &g in {
            borrow fs as &f in {
                borrow mut io as &!i in {
                    status = run(h, g, f, i);
                }
            }
        }
    }
    release(heap);
    release(args);
    release(fs);
    release(io);
    return status;
}
