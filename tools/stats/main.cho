edition 5;

// `stats` -- statistics on a CSV file whose last digit can be checked (docs/describe.md). One verb so far:
//
//     stats describe [--root DIR] [--delim D] [--ddof N] [--max-rows N] [--max-cols N] [--max-line-bytes N] FILE
//
// Per column: how many cells are numbers, how many are empty, the minimum and maximum, the mean and the variance computed from EXACT sums (acc.psum, acc.bigint) and rounded once, and the standard
// deviation (the square root of the rounded variance: two roundings, said in the answer). A column with a cell that is not a number is reported as text. One JSON document, the contract of cancho-tools'
// `toolbox` package: errors are data with a rule tag, introspect and skill come from the table the parser runs on.

import std.buffer;
import std.bytes;
import std.json;
import std.vec;
import acc.bigint;
import acc.central;
import acc.psum;
import acc.quantile;
import metrics.rank;
import flt;
import reader;
import toolbox.built;
import toolbox.cli;
import toolbox.describe;
import toolbox.fail;
import toolbox.lines;
import toolbox.out;
import toolbox.path;
import toolbox.place;

fn flag_table() -> [] &static [byte] {
    return "root||path|root||resolve FILE relative to this directory and refuse paths outside it;delim|d|text|none|,|the one byte that separates fields (default comma);ddof||nat|none|1|the divisor of the variance is n minus this (1 is the sample variance, 0 the population variance);max-rows||nat|none|1000000|the most data rows read, one more is limit.too-many-rows (ceiling 10000000);max-cols||nat|none|256|the most columns, more is limit.too-many-columns (ceiling 4096);max-line-bytes||nat|none|1048576|the longest line read, a longer one is limit.line-too-long (ceiling 16777216);max-cells||nat|none|20000000|the most cells (rows times columns) held for the quantiles, more is limit.too-many-cells (ceiling 100000000);quantiles||text|none|0,0.25,0.5,0.75,1|the probabilities of the quantiles, comma separated decimals from 0 to 1 with at most 9 decimals (at most 99 of them);quantile-type||nat|none|7|which of the nine Hyndman-Fan definitions, 1 to 9 (7 is the default of R and numpy)";
}

fn extra() -> [] &static [byte] {
    return "stats.csv-ragged|8|never|a record with a different number of fields than the header;stats.csv-multiline|8|never|a record that continues on the next line, which this version does not read;stats.csv-bad-quote|8|never|a quote that opens or closes where it may not;stats.no-header|8|never|a file with no header line;stats.bad-verb|2|never|the first operand is not a verb this tool has;limit.too-many-rows|8|never|more data rows than --max-rows;limit.too-many-columns|8|never|more columns than --max-cols;limit.too-many-cells|8|never|more cells than --max-cells";
}

fn tool() -> [] describe.Tool {
    return describe.Tool { name: "stats", version: "0.1.0", summary: "Describe the columns of a CSV file: counts, minimum, maximum, mean, variance and standard deviation from exact sums rounded once; the same bytes on every platform and at any thread count.", usage: "stats describe [--root DIR] [--delim D] [--ddof N] [--max-rows N] [--max-cols N] [--max-line-bytes N] [--max-cells N] [--quantiles P,P,..] [--quantile-type N] FILE", output: "document", schema: "stats.v1", flags: flag_table(), operands: "VERB|none|1|1|describe;FILE|path-read|1|1|the CSV file to describe", rules: "args.unknown-flag;args.missing-value;args.bad-value;args.duplicate-flag;args.missing-operand;args.too-many-operands;path.empty;path.dotdot;path.absolute;path.outside-root;path.too-long;path.symlink;io.not-found;io.not-a-directory;io.is-a-directory;io.permission-denied;io.read-failed;limit.line-too-long;stats.csv-ragged;stats.csv-multiline;stats.csv-bad-quote;stats.no-header;stats.bad-verb;limit.too-many-rows;limit.too-many-columns;limit.too-many-cells", extra_rules: extra(), limits: "max-rows|1000000|10000000;max-cols|256|4096;max-line-bytes|1048576|16777216;max-cells|20000000|100000000", reversibility: "reversible-cheap", stdin: "never", guarantees: "deterministic;idempotent;bounded_memory" };
}

fn built() -> [] describe.Built {
    return describe.Built { authority: built.authority(), schema: built.schema(), compiler: built.compiler() };
}

fn row_ceiling() -> [] int {
    return 10000000;
}

fn col_ceiling() -> [] int {
    return 4096;
}

fn line_ceiling() -> [] int {
    return 16777216;
}

// an error of this tool's own (or a standard one) with one string detail
fn refuse[&h, &m, &n, &k, &v](heap: &!h Heap, e: fail.Errors, rule: &static [byte], message: &m [byte], hint: &n [byte], key: &k [byte], value: &v [byte]) -> [heap] fail.Errors {
    var w = fail.open_in(heap, extra(), rule, message, hint);
    w = fail.no_repair(heap, w);
    w = fail.detail_open(heap, w);
    if len(key) > 0 {
        w = json.put_key(heap, w, key);
        w = json.put_string(heap, w, value);
    }
    return fail.add(heap, e, w);
}

fn refuse_int[&h, &m, &n, &k](heap: &!h Heap, e: fail.Errors, rule: &static [byte], message: &m [byte], hint: &n [byte], key: &k [byte], value: int, key2: &k [byte], value2: int) -> [heap] fail.Errors {
    var w = fail.open_in(heap, extra(), rule, message, hint);
    w = fail.no_repair(heap, w);
    w = fail.detail_open(heap, w);
    w = json.put_key(heap, w, key);
    w = json.put_int(heap, w, value);
    w = json.put_key(heap, w, key2);
    w = json.put_int(heap, w, value2);
    return fail.add(heap, e, w);
}

// ------------------------------------------------------------------------------------------------ the columns

res struct Cols {
    nonmiss: Box[[int]],
    numeric: Box[[int]],
    bad: Box[[int]],
    mn: Box[[float]],
    mx: Box[[float]],
    accs: Box[[int]],
    work: Box[[int]],
    cells: Box[[int]],
    rowkeys: Box[[int]],
}

fn acc_stride() -> [] int {
    return psum.size(1) + psum.size(2) + psum.size(3) + psum.size(4);
}

fn make_cols[&h](heap: &!h Heap, n: int) -> [heap] Cols {
    return Cols { nonmiss: box_slice(heap, n + 1, 0), numeric: box_slice(heap, n + 1, 0), bad: box_slice(heap, n + 1, 0), mn: box_slice(heap, n + 1, 0.0), mx: box_slice(heap, n + 1, 0.0), accs: box_slice(heap, n * acc_stride() + 1, 0), work: box_slice(heap, psum.scratch() + 1, 0), cells: box_slice(heap, 3 * n + 4, 0), rowkeys: box_slice(heap, n + 1, 0) };
}

fn drop_cols[&h](heap: &!h Heap, c: Cols) -> [heap] int {
    let Cols { nonmiss, numeric, bad, mn, mx, accs, work, cells, rowkeys } = c;
    unbox_slice(heap, nonmiss);
    unbox_slice(heap, numeric);
    unbox_slice(heap, bad);
    unbox_slice(heap, mn);
    unbox_slice(heap, mx);
    unbox_slice(heap, accs);
    unbox_slice(heap, work);
    unbox_slice(heap, cells);
    unbox_slice(heap, rowkeys);
    return 0;
}

// One data record. 0 when it was taken, 1 ragged, 2 continues on the next line, 3 a bad quote.
fn take_row[&c, &l](c: &!c Cols, line: &l [byte], delim: int, ncols: int) -> [] int {
    let cells = contents(c.cells);
    let (n, inside, badq) = reader.fields(line, delim, cells, ncols);
    if inside {
        return 2;
    }
    if badq {
        return 3;
    }
    if n != ncols {
        return 1;
    }
    let nonmiss = contents(c.nonmiss);
    let numeric = contents(c.numeric);
    let bad = contents(c.bad);
    let mn = contents(c.mn);
    let mx = contents(c.mx);
    let accs = contents(c.accs);
    let work = contents(c.work);
    let rowkeys = contents(c.rowkeys);
    var j = 0;
    while j < ncols {
        rowkeys[j] = rank.min_int();
        j = j + 1;
    }
    j = 0;
    while j < ncols {
        let s = cells[3 * j];
        let e = cells[3 * j + 1];
        let quoted = cells[3 * j + 2];
        if e == s && quoted == 0 {
            // an empty cell is a missing value: counted by the difference of rows and nonmiss
            j = j + 1;
        } else {
            nonmiss[j] = nonmiss[j] + 1;
            if quoted == 1 {
                bad[j] = 1;
            } else if bad[j] == 0 {
                let (key, status) = flt.parse_float(line[s..e]);
                if status != 0 {
                    bad[j] = 1;
                } else {
                    let x = flt.float_of_key(key);
                    if numeric[j] == 0 || x < mn[j] {
                        mn[j] = x;
                    }
                    if numeric[j] == 0 || x > mx[j] {
                        mx[j] = x;
                    }
                    numeric[j] = numeric[j] + 1;
                    rowkeys[j] = rank.key_of(x);
                    let base = j * acc_stride();
                    psum.add(accs[base..base + psum.size(1)], 1, bits_of(x), work);
                    psum.add(accs[base + psum.size(1)..base + psum.size(1) + psum.size(2)], 2, bits_of(x), work);
                    psum.add(accs[base + psum.size(1) + psum.size(2)..base + psum.size(1) + psum.size(2) + psum.size(3)], 3, bits_of(x), work);
                    psum.add(accs[base + psum.size(1) + psum.size(2) + psum.size(3)..base + acc_stride()], 4, bits_of(x), work);
                }
            }
            j = j + 1;
        }
    }
    return 0;
}

// ------------------------------------------------------------------------------------------------ exact arithmetic to a double

fn float_of_bits(bits: int) -> [] float {
    var key = bits;
    if bits < 0 {
        key = bits ^ 0x7fffffffffffffff;
    }
    return flt.float_of_key(key);
}

struct Stats {
    mean: float,
    variance: float,
    sd: float,
    variance_ok: bool,
    skew: float,
    kurt: float,
    moments_ok: bool,
}

// the exact mean and variance of the numeric cells of column j
fn moments[&h, &c](heap: &!h Heap, c: &c Cols, j: int, ddof: int) -> [heap] Stats {
    let n = contents(c.numeric)[j];
    let accs = contents(c.accs);
    let base = j * acc_stride();
    let l1 = psum.limbs(1);
    let l2 = psum.limbs(2);
    let s1 = box_slice(heap, l1 + 1, 0);
    let s2 = box_slice(heap, l2 + 1, 0);
    let nl = box_slice(heap, 4, 0);
    var mean = 0.0;
    var variance = 0.0;
    var ok = false;
    borrow mut s1 as &!w1 in {
        borrow mut s2 as &!w2 in {
            borrow mut nl as &!wn in {
                let neg1 = psum.magnitude(accs[base..base + psum.size(1)], 1, contents(w1)) < 0;
                psum.magnitude(accs[base + psum.size(1)..base + psum.size(1) + psum.size(2)], 2, contents(w2));
                central.limbs_of(n, contents(wn));
                let (mb, mc) = central.ratio_bits(heap, contents(w1), l1, contents(wn), 3, 0 - 1074, neg1);
                mean = float_of_bits(mb);
                if n - ddof >= 1 {
                    // N = n sum(x^2) - sum(x)^2, exact, in units of 2^-2148
                    let a = box_slice(heap, l2 + 5, 0);
                    let b = box_slice(heap, 2 * l1 + 2, 0);
                    borrow mut a as &!aw in {
                        borrow mut b as &!bw in {
                            bigint.mul(contents(aw), contents(w2), l2, contents(wn), 3);
                            bigint.mul(contents(bw), contents(w1), l1, contents(w1), l1);
                            bigint.sub_in(contents(aw), l2 + 5, contents(bw), 2 * l1 + 2);
                            let dl = box_slice(heap, 4, 0);
                            borrow mut dl as &!dw in {
                                central.limbs_of(n * (n - ddof), contents(dw));
                                let (vb, vc) = central.ratio_bits(heap, contents(aw), l2 + 5, contents(dw), 3, 0 - 2148, false);
                                variance = float_of_bits(vb);
                                ok = vc == 0;
                            }
                            unbox_slice(heap, dl);
                        }
                    }
                    unbox_slice(heap, a);
                    unbox_slice(heap, b);
                }
            }
        }
    }
    unbox_slice(heap, s1);
    unbox_slice(heap, s2);
    unbox_slice(heap, nl);
    var sd = 0.0;
    if ok {
        sd = sqrt(variance);
    }
    var skew = 0.0;
    var kurt = 0.0;
    var mok = false;
    if n >= 2 {
        let (sb, sc, kb, kc, st) = central.skew_kurt(heap, accs[base..base + acc_stride()], n);
        if st == 0 && sc == 0 && kc == 0 {
            skew = float_of_bits(sb);
            kurt = float_of_bits(kb);
            mok = true;
        }
    }
    return Stats { mean: mean, variance: variance, sd: sd, variance_ok: ok, skew: skew, kurt: kurt, moments_ok: mok };
}

// ------------------------------------------------------------------------------------------------ the answer

// one probability, a decimal such as 0, 1, .5 or 0.025: (digits as an integer, number of decimals, ok); at most 9 decimals, at most 12 digits, not above 1
fn parse_p[&t](tok: &t [byte]) -> [] (int, int, bool) {
    var num = 0;
    var k = 0;
    var dot = false;
    var digits = 0;
    var i = 0;
    while i < len(tok) {
        let c = int_of(tok[i]);
        if c == '.' {
            if dot {
                return (0, 0, false);
            }
            dot = true;
        } else if c >= '0' && c <= '9' {
            digits = digits + 1;
            if dot {
                k = k + 1;
            }
            if k > 9 || digits > 12 {
                return (0, 0, false);
            }
            num = num * 10 + (c - '0');
        } else {
            return (0, 0, false);
        }
        i = i + 1;
    }
    if digits == 0 || num > quantile.pow10(k) {
        return (0, 0, false);
    }
    return (num, k, true);
}

// the list of probabilities is valid: 1 to 99 tokens, each a probability
fn valid_list[&t](text: &t [byte]) -> [] bool {
    let n = bytes.count_byte(text, ',') + 1;
    if n > 99 {
        return false;
    }
    var i = 0;
    while i < n {
        let (num, k, ok) = parse_p(bytes.field(text, ',', i + 1));
        if !ok {
            return false;
        }
        i = i + 1;
    }
    return true;
}

// the quantiles of column j: its numeric cells gathered from the store, sorted, and each probability of `qtext` answered exactly
fn quantile_list[&h, &sv, &q](heap: &!h Heap, w0: json.Writer, store: &sv vec.Vec[int], rows: int, ncols: int, j: int, n: int, qtype: int, qtext: &q [byte]) -> [heap] json.Writer {
    var w = w0;
    let keys = box_slice(heap, n + 1, 0);
    let tmp = box_slice(heap, n + 1, 0);
    let cnt = box_slice(heap, 256, 0);
    w = json.put_key(heap, w, "quantiles");
    w = json.begin_array(heap, w);
    borrow mut keys as &!kw in {
        borrow mut tmp as &!tw in {
            borrow mut cnt as &!cw in {
                var r = 0;
                var m = 0;
                while r < rows {
                    let k = vec.get(store, r * ncols + j);
                    if k != rank.min_int() {
                        contents(kw)[m] = k;
                        m = m + 1;
                    }
                    r = r + 1;
                }
                rank.sort_range(contents(kw), contents(tw), contents(cw), 0, m);
                let count = bytes.count_byte(qtext, ',') + 1;
                var i = 0;
                while i < count {
                    let tok = bytes.field(qtext, ',', i + 1);
                    let (num, k, ok) = parse_p(tok);
                    let (bits, code) = quantile.at(heap, contents(kw), m, qtype, num, k);
                    w = json.begin_object(heap, w);
                    w = json.put_key(heap, w, "p");
                    w = json.put_string(heap, w, tok);
                    w = json.put_key(heap, w, "value");
                    w = json.put_float(heap, w, float_of_bits(bits));
                    w = json.end_object(heap, w);
                    i = i + 1;
                }
            }
        }
    }
    unbox_slice(heap, keys);
    unbox_slice(heap, tmp);
    unbox_slice(heap, cnt);
    w = json.end_array(heap, w);
    return w;
}

fn report[&h, &c, &nm, &en, &sv, &q](heap: &!h Heap, c: &c Cols, names: &nm [byte], ends: &en vec.Vec[int], store: &sv vec.Vec[int], ncols: int, rows: int, ddof: int, qtype: int, qtext: &q [byte]) -> [heap] buffer.Buffer {
    var w = json.writer(heap, 1024);
    w = json.begin_object(heap, w);
    w = json.put_key(heap, w, "rows");
    w = json.put_int(heap, w, rows);
    w = json.put_key(heap, w, "ddof");
    w = json.put_int(heap, w, ddof);
    w = json.put_key(heap, w, "quantile_type");
    w = json.put_int(heap, w, qtype);
    w = json.put_key(heap, w, "rounding");
    w = json.put_string(heap, w, "mean, variance, skewness, excess kurtosis, quantiles: exact, rounded once; sd: the square root of the rounded variance, two roundings");
    w = json.put_key(heap, w, "columns");
    w = json.begin_array(heap, w);
    var j = 0;
    while j < ncols {
        var from = 0;
        if j > 0 {
            from = vec.get(ends, j - 1);
        }
        let to = vec.get(ends, j);
        w = json.begin_object(heap, w);
        w = json.put_key(heap, w, "name");
        w = json.put_string(heap, w, names[from..to]);
        let nonmiss = contents(c.nonmiss)[j];
        let numeric = contents(c.numeric)[j];
        let bad = contents(c.bad)[j];
        w = json.put_key(heap, w, "kind");
        if nonmiss == 0 {
            w = json.put_string(heap, w, "empty");
        } else if bad == 1 {
            w = json.put_string(heap, w, "text");
        } else {
            w = json.put_string(heap, w, "numeric");
        }
        w = json.put_key(heap, w, "count");
        w = json.put_int(heap, w, nonmiss);
        w = json.put_key(heap, w, "missing");
        w = json.put_int(heap, w, rows - nonmiss);
        if nonmiss > 0 && bad == 0 {
            w = json.put_key(heap, w, "min");
            w = json.put_float(heap, w, contents(c.mn)[j]);
            w = json.put_key(heap, w, "max");
            w = json.put_float(heap, w, contents(c.mx)[j]);
            let s = moments(heap, c, j, ddof);
            w = json.put_key(heap, w, "mean");
            w = json.put_float(heap, w, s.mean);
            w = json.put_key(heap, w, "variance");
            if s.variance_ok {
                w = json.put_float(heap, w, s.variance);
            } else {
                w = json.put_null(heap, w);
            }
            w = json.put_key(heap, w, "sd");
            if s.variance_ok {
                w = json.put_float(heap, w, s.sd);
            } else {
                w = json.put_null(heap, w);
            }
            w = json.put_key(heap, w, "skewness");
            if s.moments_ok {
                w = json.put_float(heap, w, s.skew);
            } else {
                w = json.put_null(heap, w);
            }
            w = json.put_key(heap, w, "kurtosis");
            if s.moments_ok {
                w = json.put_float(heap, w, s.kurt);
            } else {
                w = json.put_null(heap, w);
            }
            w = quantile_list(heap, w, store, rows, ncols, j, numeric, qtype, qtext);
        }
        w = json.end_object(heap, w);
        j = j + 1;
    }
    w = json.end_array(heap, w);
    w = json.end_object(heap, w);
    return json.finish(w);
}

// ------------------------------------------------------------------------------------------------ reading the file

struct Scanned {
    rows: int,
    ncols: int,
}

// the file, line by line: the header, then the records
fn read_file[&h, &g, &p, &f, &s](heap: &!h Heap, args: &g Args, parsed: &p cli.Parsed, file: &!f File, shown: &s [byte], errs: fail.Errors) -> [heap, args, file_read] (buffer.Buffer, vec.Vec[int], Cols, vec.Vec[int], Scanned, fail.Errors) {
    let table = flag_table();
    let cap = cli.nat(args, parsed, table, "max-line-bytes");
    let delim = int_of(cli.text(args, parsed, table, "delim")[0]);
    let max_rows = cli.nat(args, parsed, table, "max-rows");
    let max_cols = cli.nat(args, parsed, table, "max-cols");
    let max_cells = cli.nat(args, parsed, table, "max-cells");
    var store = vec.empty(heap, 1024, 0);
    var e = errs;
    var names = buffer.empty(heap, 1);
    var ends = vec.empty(heap, 1, 0);
    var cols = make_cols(heap, 1);
    var info = Scanned { rows: 0, ncols: 0 };
    var r = lines.start(heap, cap);
    var going = true;
    var have_header = false;
    var number = 0;
    while going {
        let (stepped, status) = lines.next(heap, r);
        r = stepped;
        if status == lines.need() {
            r = lines.fill_file(r, file);
        } else if status == lines.done() {
            going = false;
        } else if status == lines.long() {
            var n = 0;
            borrow r as &rr in {
                n = lines.number(rr);
            }
            e = refuse(heap, e, "limit.line-too-long", "a line is longer than --max-line-bytes", "raise --max-line-bytes", "file", shown);
            going = false;
        } else {
            number = number + 1;
            var stop = false;
            borrow r as &rr in {
                let line = lines.text(rr);
                if !have_header {
                    let (open, seps, badq) = reader.scan(line, delim, false, 0);
                    if open {
                        e = refuse(heap, e, "stats.csv-multiline", "the header continues on the next line", "put the header on one line", "file", shown);
                        stop = true;
                    } else if badq {
                        e = refuse(heap, e, "stats.csv-bad-quote", "a quote in the header opens or closes where it may not", "write the header as RFC 4180", "file", shown);
                        stop = true;
                    } else if seps + 1 > max_cols {
                        e = refuse_int(heap, e, "limit.too-many-columns", "more columns than --max-cols", "raise --max-cols", "limit", max_cols, "columns", seps + 1);
                        stop = true;
                    } else {
                        let (nb, ne) = reader.split_header(heap, line, delim);
                        buffer.drop(heap, names);
                        vec.drop(heap, ends);
                        names = nb;
                        ends = ne;
                        drop_cols(heap, cols);
                        cols = make_cols(heap, seps + 1);
                        info = Scanned { rows: 0, ncols: seps + 1 };
                        have_header = true;
                    }
                } else if len(line) > 0 || info.ncols == 1 {
                    // a blank line is skipped, except in a file of one column, where it is one empty cell
                    if info.rows >= max_rows {
                        e = refuse_int(heap, e, "limit.too-many-rows", "more data rows than --max-rows", "raise --max-rows", "limit", max_rows, "line", number);
                        stop = true;
                    } else if (info.rows + 1) * info.ncols > max_cells {
                        e = refuse_int(heap, e, "limit.too-many-cells", "more cells than --max-cells are needed to hold the columns for the quantiles", "raise --max-cells or describe fewer rows", "limit", max_cells, "line", number);
                        stop = true;
                    } else {
                        borrow mut cols as &!cw in {
                            let st = take_row(cw, line, delim, info.ncols);
                            if st == 0 {
                                info = Scanned { rows: info.rows + 1, ncols: info.ncols };
                                var jj = 0;
                                while jj < info.ncols {
                                    store = vec.push(heap, store, contents(cw.rowkeys)[jj]);
                                    jj = jj + 1;
                                }
                            } else if st == 1 {
                                e = refuse_int(heap, e, "stats.csv-ragged", "a record has a different number of fields than the header", "check the delimiter and the quoting of that line", "line", number, "columns", info.ncols);
                                stop = true;
                            } else if st == 2 {
                                e = refuse_int(heap, e, "stats.csv-multiline", "a record continues on the next line, which this version does not read", "join the record onto one line", "line", number, "columns", info.ncols);
                                stop = true;
                            } else {
                                e = refuse_int(heap, e, "stats.csv-bad-quote", "a quote opens or closes where it may not", "write the line as RFC 4180", "line", number, "columns", info.ncols);
                                stop = true;
                            }
                        }
                    }
                }
            }
            if stop {
                going = false;
            }
        }
    }
    var errno = 0;
    borrow r as &rr in {
        errno = lines.failed(rr);
    }
    lines.drop(heap, r);
    if errno != 0 {
        e = fail.io_error(heap, e, errno, false, shown);
    }
    if !have_header {
        e = refuse(heap, e, "stats.no-header", "the file has no header line", "give a CSV file whose first line names the columns", "file", shown);
    }
    return (names, ends, cols, store, info, e);
}

fn body[&h, &g, &p, &f, &i](heap: &!h Heap, args: &g Args, parsed: &p cli.Parsed, fs: &f Fs(""), io: &!i Io, errs: fail.Errors) -> [heap, args, fs_read(""), dir_read, file_read, io_write, err_write] int {
    let table = flag_table();
    var e = errs;
    if cli.operand_count(parsed) == 0 {
        e = refuse(heap, e, "args.missing-operand", "no verb: the first operand names what to do", "stats describe FILE", "", "");
    } else if !bytes.equal(cli.operand(args, parsed, 0), "describe") {
        e = refuse(heap, e, "stats.bad-verb", "the first operand is not a verb this tool has", "the verb so far is: describe", "verb", cli.operand(args, parsed, 0));
    } else if cli.operand_count(parsed) < 2 {
        e = refuse(heap, e, "args.missing-operand", "no FILE to describe", "stats describe FILE", "", "");
    } else if cli.operand_count(parsed) > 2 {
        e = refuse(heap, e, "args.too-many-operands", "one FILE only", "describe one file per call", "", "");
    }
    if len(cli.text(args, parsed, table, "delim")) != 1 {
        e = refuse(heap, e, "args.bad-value", "--delim is one byte", "--delim , or --delim ';'", "flag", "--delim");
    }
    if cli.nat(args, parsed, table, "max-rows") > row_ceiling() {
        e = refuse(heap, e, "args.bad-value", "--max-rows is above the ceiling", "10000000 is the most this tool reads", "flag", "--max-rows");
    }
    if cli.nat(args, parsed, table, "max-cols") > col_ceiling() || cli.nat(args, parsed, table, "max-cols") < 1 {
        e = refuse(heap, e, "args.bad-value", "--max-cols is outside 1 to 4096", "4096 is the most this tool holds", "flag", "--max-cols");
    }
    if cli.nat(args, parsed, table, "max-line-bytes") > line_ceiling() {
        e = refuse(heap, e, "args.bad-value", "--max-line-bytes is above the ceiling", "16777216 is the most this tool holds", "flag", "--max-line-bytes");
    }
    if cli.nat(args, parsed, table, "max-cells") > 100000000 || cli.nat(args, parsed, table, "max-cells") < 1 {
        e = refuse(heap, e, "args.bad-value", "--max-cells is outside 1 to 100000000", "100000000 is the most this tool holds", "flag", "--max-cells");
    }
    if cli.nat(args, parsed, table, "quantile-type") < 1 || cli.nat(args, parsed, table, "quantile-type") > 9 {
        e = refuse(heap, e, "args.bad-value", "--quantile-type is 1 to 9", "type 7 is the default of R and numpy", "flag", "--quantile-type");
    }
    if !valid_list(cli.text(args, parsed, table, "quantiles")) {
        e = refuse(heap, e, "args.bad-value", "--quantiles takes at most 99 comma separated decimals from 0 to 1 with at most 9 decimals", "--quantiles 0.25,0.5,0.75", "flag", "--quantiles");
    }
    if cli.nat(args, parsed, table, "ddof") > 1 {
        e = refuse(heap, e, "args.bad-value", "--ddof is 0 or 1", "0 divides by n, 1 by n - 1", "flag", "--ddof");
    }
    let (root, after_root) = path.root(heap, args, cli.text(args, parsed, table, "root"), cli.value_index(parsed, table, "root"), e);
    e = after_root;
    var refused = false;
    borrow e as &er in {
        refused = fail.count(er) > 0;
    }
    var data = buffer.empty(heap, 1);
    if !refused {
        borrow root as &rr in {
            let (target, checked) = path.operand(heap, args, buffer.bytes(rr), cli.operand_index(parsed, 1), e);
            e = checked;
            borrow target as &tp in {
                if path.ok(tp) {
                    match place.open_operand(fs, buffer.bytes(rr), path.shown(tp), path.full(tp)) {
                        Opened::Failed(reason) => {
                            e = fail.io_error(heap, e, reason, false, path.shown(tp));
                        }
                        Opened::Ok(opened) => {
                            var file = opened;
                            borrow mut file as &!handle in {
                                let (names, ends, cols, store, info, e2) = read_file(heap, args, parsed, handle, path.shown(tp), e);
                                e = e2;
                                var clean = false;
                                borrow e as &er2 in {
                                    clean = fail.count(er2) == 0;
                                }
                                if clean {
                                    borrow names as &nb in {
                                        borrow ends as &eb in {
                                            borrow cols as &cb in {
                                                buffer.drop(heap, data);
                                                borrow store as &sb in {
                                                    data = report(heap, cb, buffer.bytes(nb), eb, sb, info.ncols, info.rows, cli.nat(args, parsed, table, "ddof"), cli.nat(args, parsed, table, "quantile-type"), cli.text(args, parsed, table, "quantiles"));
                                                }
                                            }
                                        }
                                    }
                                }
                                buffer.drop(heap, names);
                                vec.drop(heap, ends);
                                drop_cols(heap, cols);
                                vec.drop(heap, store);
                            }
                            file_close(file);
                        }
                    }
                }
            }
            path.drop(heap, target);
        }
    }
    buffer.drop(heap, root);
    var status = 0;
    borrow e as &er in {
        borrow data as &d in {
            status = out.respond(heap, io, "stats", "stats.v1", "0.1.0", buffer.bytes(d), "", er, false, "", 0);
        }
    }
    buffer.drop(heap, data);
    fail.drop(heap, e);
    return status;
}

fn run[&h, &g, &f, &i](heap: &!h Heap, args: &g Args, fs: &f Fs(""), io: &!i Io) -> [heap, args, fs_read(""), dir_read, file_read, io_write, err_write] int {
    let which = cli.subcommand(args);
    if which != 0 {
        return describe.answer(heap, io, which, tool(), built());
    }
    let (parsed, e) = cli.parse(heap, args, flag_table(), fail.empty_in(heap, extra()));
    var status = 0;
    borrow parsed as &p in {
        status = body(heap, args, p, fs, io, e);
    }
    cli.drop(heap, parsed);
    return status;
}

fn main(world: World) -> [] int {
    let Split { io, ffi, fs, heap, args, net, clock } = split(world);
    // No foreign code, no network, no clock.
    release(ffi);
    release(net);
    release(clock);
    var status = 0;
    borrow mut heap as &!h in {
        borrow args as &g in {
            borrow fs as &f in {
                borrow mut io as &!i in {
                    status = run(h, g, f, i);
                }
            }
        }
    }
    release(heap);
    release(args);
    release(fs);
    release(io);
    return status;
}
