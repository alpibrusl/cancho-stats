// quantile-check: acc.quantile on data from standard input, for scripts/gate_quantile.py. One line per case:
//
//     T P K N HEX1 .. HEXN      T the type (1 to 9), P and K the probability P / 10^K, N the count (1 to 2048), each HEX the 16 hex digits of a FINITE double (unsorted)
//
// One line per case: the quantile as 16 hex digits of the double, then the code (0).
edition 5;

import std.io;
import acc.quantile;
import metrics.rank;
import ml.fbits;

fn hexval(c: int) -> [] int {
    if c >= '0' && c <= '9' {
        return c - '0';
    }
    if c >= 'a' && c <= 'f' {
        return c - 'a' + 10;
    }
    if c >= 'A' && c <= 'F' {
        return c - 'A' + 10;
    }
    return 0;
}

fn hex16[&i](io: &!i Io, bits: int) -> [io_write] int {
    var k = 0;
    while k < 16 {
        let nib = bits >> 60 - 4 * k & 15;
        if nib < 10 {
            putchar(io, '0' + nib);
        } else {
            putchar(io, 'a' + nib - 10);
        }
        k = k + 1;
    }
    return 0;
}

fn answer[&h, &i, &x](heap: &!h Heap, io: &!i Io, t: int, p: int, k: int, n: int, vals: &!x [int]) -> [heap, io_write] int {
    let keys = box_slice(heap, n + 1, 0);
    let tmp = box_slice(heap, n + 1, 0);
    let cnt = box_slice(heap, 256, 0);
    var bits = 0;
    var code = 0;
    borrow mut keys as &!kw in {
        borrow mut tmp as &!tw in {
            borrow mut cnt as &!cw in {
                var j = 0;
                while j < n {
                    contents(kw)[j] = rank.key_of(fbits.decode(vals[j]));
                    j = j + 1;
                }
                rank.sort_range(contents(kw), contents(tw), contents(cw), 0, n);
                let (b, c) = quantile.at(heap, contents(kw), n, t, p, k);
                bits = b;
                code = c;
            }
        }
    }
    unbox_slice(heap, keys);
    unbox_slice(heap, tmp);
    unbox_slice(heap, cnt);
    hex16(io, bits);
    io.space(io);
    io.print_int(io, code);
    io.newline(io);
    return 0;
}

fn serve[&h, &i](heap: &!h Heap, io: &!i Io) -> [heap, io_read, io_write] int {
    let xb = box_slice(heap, 2049, 0);
    var tok = 0;
    var inword = false;
    var v = 0;
    var t = 0;
    var p = 0;
    var k = 0;
    var n = 0;
    var c = getchar(io);
    borrow mut xb as &!xw in {
        let xs = contents(xw);
        while c >= 0 {
            if c == ' ' || c == '\n' || c == '\r' || c == '\t' {
                if inword {
                    if tok == 0 {
                        t = v;
                    } else if tok == 1 {
                        p = v;
                    } else if tok == 2 {
                        k = v;
                    } else if tok == 3 {
                        n = v;
                        if n > 2048 {
                            n = 0;
                        }
                    } else if tok - 4 < n {
                        xs[tok - 4] = v;
                    }
                    tok = tok + 1;
                    inword = false;
                    v = 0;
                }
                if c == '\n' {
                    if tok > 4 && t >= 1 && t <= 9 && n >= 1 && k <= 9 {
                        answer(heap, io, t, p, k, n, xs);
                    }
                    tok = 0;
                    n = 0;
                }
            } else {
                inword = true;
                if tok < 4 {
                    if v < 100000000000 {
                        v = v * 10 + (c - '0');
                    }
                } else {
                    v = v << 4 | hexval(c);
                }
            }
            c = getchar(io);
        }
    }
    unbox_slice(heap, xb);
    return 0;
}

fn main(world: World) -> [] int {
    let Split { io, ffi, fs, heap, args, net, clock } = split(world);
    release(ffi);
    release(net);
    release(fs);
    release(clock);
    release(args);
    borrow mut heap as &!h in {
        borrow mut io as &!w in {
            serve(h, w);
        }
    }
    release(heap);
    release(io);
    return 0;
}
