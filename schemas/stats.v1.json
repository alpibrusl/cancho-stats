{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://github.com/alpibrusl/cancho-stats/schemas/stats.v1.json","title":"stats.v1","description":"The document `stats describe` prints: the contract of cancho-tools' toolbox (ok, command, schema, then data or error) with the per-column statistics in data.","type":"object","required":["ok","command","schema"],"properties":{"ok":{"type":"boolean"},"command":{"const":"stats"},"schema":{"const":"stats.v1"},"data":{"type":"object","required":["rows","ddof","rounding","columns"],"properties":{"rows":{"type":"integer","minimum":0},"ddof":{"enum":[0,1]},"rounding":{"type":"string"},"columns":{"type":"array","items":{"type":"object","required":["name","kind","count","missing"],"properties":{"name":{"type":"string"},"kind":{"enum":["numeric","text","empty"]},"count":{"type":"integer","minimum":0},"missing":{"type":"integer","minimum":0},"min":{"type":"number"},"max":{"type":"number"},"mean":{"type":"number"},"variance":{"type":["number","null"]},"sd":{"type":["number","null"]},"skewness":{"type":["number","null"]},"kurtosis":{"type":["number","null"]}}}}}},"error":{"type":"object","required":["code","rule","message"]},"errors":{"type":"array"},"meta":{"type":"object"}}}
