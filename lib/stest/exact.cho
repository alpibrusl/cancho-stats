edition 5;

module stest.exact;

// The exact distributions of the rank tests, by counting in 64-bit integers (docs/rank.md section 4). The counts never exceed C(60, 30) = 1.18e17, below 2^63 = 9.22e18, which is the whole reason for the limits.

// The number of ways to choose na of the ranks 1 .. nn with a rank sum s, summed for s up to r_obs (answered le), for s from r_obs up (ge), and over all s (total = C(nn, na)); by the table g[k][s] of the ways to
// choose k of the ranks met so far with sum s, ranks in turn, k downwards so that each rank is used once. nn is at most 60.
pub fn rank_sum_counts[&h](heap: &!h Heap, na: int, nn: int, r_obs: int) -> [heap] (int, int, int) {
    let smax = na * nn;
    let width = smax + 1;
    let g = box_slice(heap, (na + 1) * width + 1, 0);
    var le = 0;
    var ge = 0;
    var total = 0;
    borrow mut g as &!gw in {
        let t = contents(gw);
        t[0] = 1;
        var r = 1;
        while r <= nn {
            var k = na;
            while k >= 1 {
                var s = smax;
                while s >= r {
                    t[k * width + s] = t[k * width + s] + t[(k - 1) * width + s - r];
                    s = s - 1;
                }
                k = k - 1;
            }
            r = r + 1;
        }
        var s = 0;
        while s <= smax {
            let c = t[na * width + s];
            total = total + c;
            if s <= r_obs {
                le = le + c;
            }
            if s >= r_obs {
                ge = ge + c;
            }
            s = s + 1;
        }
    }
    unbox_slice(heap, g);
    return (le, ge, total);
}
