edition 5;

module stest.answer5;

import std.json;
import std.vec;
import flt;
import special.dist;
import stest.answer;
import stest.anova;
import stest.welchf;

// One test of the answer for the kind anova (docs/rank.md section 3): the one-way analysis of the column `col` over the groups whose counts, mean bits and standard deviation bits are `ns` and `gs` (three ints for each).
// The groups are named once, in the header, in the order of their levels by bytes; here "n", "mean" and "sd" list them in that order (a group with no value in this column has n 0 and null for the others).
fn float_of_bits(bits: int) -> [] float {
    var key = bits;
    if bits < 0 {
        key = bits ^ 0x7fffffffffffffff;
    }
    return flt.float_of_key(key);
}

pub fn put_anova[&h, &n, &en, &c, &s](heap: &!h Heap, w0: json.Writer, names: &n [byte], ends: &en vec.Vec[int], col: int, r: anova.Anova, wr: welchf.WelchF, counts: &c [int], gs: &s [int], groups: int, pooled: bool) -> [heap] json.Writer {
    var w = w0;
    w = json.begin_object(heap, w);
    w = json.put_key(heap, w, "column");
    w = answer.put_name(heap, w, names, ends, col);
    var reason = "";
    var stat = 0.0;
    var have = false;
    var df2 = 0.0;
    if r.status == 1 {
        reason = "too-few-rows";
    } else if pooled {
        if r.status == 2 {
            reason = "variance-zero";
        } else if r.fc != 0 {
            reason = "statistic-beyond-double";
        } else {
            have = true;
            stat = float_of_bits(r.fb);
            df2 = float_of(r.nn - r.k);
        }
    } else if wr.status == 1 {
        reason = "too-few-rows";
    } else if wr.status == 2 {
        reason = "variance-zero";
    } else if wr.status == 3 {
        reason = "welch-range";
    } else if wr.status == 4 {
        reason = "statistic-beyond-double";
    } else {
        have = true;
        stat = wr.f;
        df2 = wr.df;
    }
    var p = 0.0;
    var have_p = false;
    if have {
        let (pv, code) = dist.f_sf(stat, float_of(r.k - 1), df2);
        if code == 0 {
            have_p = true;
            p = pv;
        } else {
            reason = "p-not-computed";
        }
    }
    w = json.put_key(heap, w, "statistic");
    if have {
        w = json.put_float(heap, w, stat);
    } else {
        w = json.put_null(heap, w);
    }
    w = json.put_key(heap, w, "df");
    if r.status != 1 && (pooled || have) {
        w = json.begin_object(heap, w);
        w = json.put_key(heap, w, "between");
        w = json.put_int(heap, w, r.k - 1);
        w = json.put_key(heap, w, "within");
        if pooled {
            w = json.put_int(heap, w, r.nn - r.k);
        } else {
            w = json.put_float(heap, w, df2);
        }
        w = json.end_object(heap, w);
    } else {
        w = json.put_null(heap, w);
    }
    w = json.put_key(heap, w, "p_value");
    if have_p {
        w = json.put_float(heap, w, p);
    } else {
        w = json.put_null(heap, w);
    }
    w = json.put_key(heap, w, "p_method");
    w = json.put_string(heap, w, "f");
    w = json.put_key(heap, w, "effect_size");
    if r.es == 0 && r.ec == 0 {
        w = json.begin_object(heap, w);
        w = json.put_key(heap, w, "name");
        w = json.put_string(heap, w, "eta_squared");
        w = json.put_key(heap, w, "value");
        w = json.put_float(heap, w, float_of_bits(r.eb));
        w = json.end_object(heap, w);
    } else {
        w = json.put_null(heap, w);
    }
    w = json.put_key(heap, w, "omega_squared");
    if r.os == 0 && r.oc == 0 {
        w = json.put_float(heap, w, float_of_bits(r.ob));
    } else {
        w = json.put_null(heap, w);
    }
    w = json.put_key(heap, w, "n");
    w = json.begin_array(heap, w);
    var i = 0;
    while i < groups {
        w = json.put_int(heap, w, counts[i]);
        i = i + 1;
    }
    w = json.end_array(heap, w);
    w = json.put_key(heap, w, "mean");
    w = json.begin_array(heap, w);
    i = 0;
    while i < groups {
        if counts[i] > 0 {
            w = json.put_float(heap, w, float_of_bits(gs[3 * i]));
        } else {
            w = json.put_null(heap, w);
        }
        i = i + 1;
    }
    w = json.end_array(heap, w);
    w = json.put_key(heap, w, "sd");
    w = json.begin_array(heap, w);
    i = 0;
    while i < groups {
        if counts[i] > 1 {
            w = json.put_float(heap, w, float_of_bits(gs[3 * i + 1]));
        } else {
            w = json.put_null(heap, w);
        }
        i = i + 1;
    }
    w = json.end_array(heap, w);
    w = json.put_key(heap, w, "method");
    if pooled {
        w = json.put_string(heap, w, "pooled");
    } else {
        w = json.put_string(heap, w, "welch");
    }
    if len(reason) > 0 {
        w = json.put_key(heap, w, "reason");
        w = json.put_string(heap, w, reason);
    }
    w = json.end_object(heap, w);
    return w;
}
