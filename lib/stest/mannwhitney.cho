edition 5;

module stest.mannwhitney;

import std.vec;
import acc.bigint;
import acc.central;
import metrics.rank;
import stest.exact;
import stest.kruskal;
import stest.welch;

// The Mann-Whitney U test of two groups (docs/rank.md section 2). The m present values of a column come with the index of their group (0 is the group a, the level that is first by bytes). With D_a the doubled rank sum of
// group a (stest.kruskal.gather), n_a and n_b the sizes, N = n_a + n_b, and the tie groups of sizes t, T = sum (t^3 - t):
//     2 U_a = D_a - n_a (n_a + 1)          m = 2 U_a - n_a n_b          rank-biserial  r = m / (n_a n_b)          (one rounding of a quotient of two exact integers)
//     z^2 = 3 m'^2 N (N - 1) / (n_a n_b (N^3 - N - T))          z = sign(m) sqrt(z^2)          m' = |m| - 1 with the continuity correction (and m != 0), else |m|
// z is one rounding of an exact rational (the root through central.sqrt_ratio_bits); N^3 - N - T = 0 (every value equal) is the status 2. The exact p-value, with no ties and N <= 60, is the count of the arrangements of the
// ranks (stest.exact) over C(N, n_a): p = min(1, 2 min(P(U <= u), P(U >= u))), an exact rational rounded once.

pub struct MannWhitney {
    na: int,
    nb: int,
    status: int,
    ties: int,
    twice_u: int,
    rb: float,
    zb: int,
    zc: int,
    exact: int,
    pb: int,
    pc: int,
}

// whether the exact p-value is available: no two values equal and at most 60 values
pub fn possible[&a](keys: &a [int], m: int) -> [] bool {
    if m > 60 {
        return false;
    }
    var i = 0;
    while i < m {
        var j = i + 1;
        while j < m {
            if keys[i] == keys[j] {
                return false;
            }
            j = j + 1;
        }
        i = i + 1;
    }
    return true;
}

// mode: 0 auto, 1 exact, 2 asymptotic (the caller has refused 1 where it is not possible); cont: 1 with the continuity correction
pub fn run[&h, &a, &g](heap: &!h Heap, keys: &a [int], gid: &g [int], m: int, mode: int, cont: int) -> [heap] MannWhitney {
    let c = central.cap();
    let tmp = box_slice(heap, 14 * c + 1, 0);
    let fs = box_slice(heap, 16 * welch.slot() + 8, 0);
    let ds = box_slice(heap, 4, 0);
    let ns = box_slice(heap, 4, 0);
    var status = 0;
    var ties = 0;
    var twice_u = 0;
    var rb = 0.0;
    var zb = 0;
    var zc = 1;
    var used_exact = 0;
    var pb = 0;
    var pc = 1;
    var na = 0;
    var nb = 0;
    borrow mut tmp as &!tw in {
        borrow mut fs as &!fw in {
            borrow mut ds as &!dw in {
                borrow mut ns as &!nw in {
                    let t = contents(tw);
                    let f = contents(fw);
                    let (tg, sum_t) = kruskal.gather(heap, keys, gid, m, contents(dw), contents(nw), t, f);
                    ties = tg;
                    na = contents(nw)[0];
                    nb = contents(nw)[1];
                    if na == 0 || nb == 0 {
                        status = 1;
                    } else {
                        twice_u = contents(dw)[0] - na * (na + 1);
                        let mm = twice_u - na * nb;
                        rb = float_of(mm) / float_of(na * nb);
                        // E = (N^3 + sum t) - (N + sum t^3)
                        central.limbs_of(m, f[0..3]);
                        welch.smul(f, 1, 0, 3, 0, 3);
                        welch.smul(f, 2, 1, 6, 0, 3);
                        central.limbs_of(sum_t, f[3 * welch.slot()..3 * welch.slot() + 3]);
                        bigint.clear(t[8 * c..9 * c], c);
                        bigint.copy(t[8 * c..8 * c + 9], f[2 * welch.slot()..2 * welch.slot() + 9], 9);
                        bigint.add_in(t[8 * c..9 * c], c, f[3 * welch.slot()..3 * welch.slot() + 3], 3);
                        bigint.copy(t[9 * c..10 * c], t[6 * c..7 * c], c);
                        bigint.add_in(t[9 * c..10 * c], c, f[0..3], 3);
                        bigint.sub_in(t[8 * c..9 * c], c, t[9 * c..10 * c], c);
                        let zero_e = bigint.is_zero(t[8 * c..9 * c], c);
                        if zero_e {
                            status = 2;
                        } else {
                            var am = mm;
                            if mm < 0 {
                                am = 0 - mm;
                            }
                            if cont == 1 && am > 0 {
                                am = am - 1;
                            }
                            // z^2 = 3 m'^2 N (N - 1) / (n_a n_b E)
                            central.limbs_of(am, f[4 * welch.slot()..4 * welch.slot() + 3]);
                            welch.smul(f, 5, 4, 3, 4, 3);
                            central.limbs_of(3 * m * (m - 1), f[6 * welch.slot()..6 * welch.slot() + 3]);
                            welch.smul(f, 7, 5, 6, 6, 3);
                            central.limbs_of(na * nb, f[8 * welch.slot()..8 * welch.slot() + 3]);
                            welch.mulf(t, 10, 8, welch.len_of(t, 8), f, 8, 3);
                            let (b1, c1) = central.sqrt_ratio_bits(heap, f[7 * welch.slot()..7 * welch.slot() + 9], 9, t[10 * c..11 * c], welch.len_of(t, 10));
                            zb = b1;
                            zc = c1;
                            if mm < 0 && zc == 0 && zb != 0 {
                                zb = zb | 0 - 9223372036854775807 - 1;
                            }
                        }
                        var use_exact = false;
                        if mode == 0 {
                            use_exact = possible(keys, m);
                        } else if mode == 1 {
                            use_exact = true;
                        }
                        if use_exact {
                            used_exact = 1;
                            let (le, ge, total) = exact.rank_sum_counts(heap, na, m, contents(dw)[0] / 2);
                            var lo = le;
                            if ge < lo {
                                lo = ge;
                            }
                            if 2 * lo >= total {
                                pb = bits_of(1.0);
                                pc = 0;
                            } else {
                                central.limbs_of(2 * lo, f[9 * welch.slot()..9 * welch.slot() + 3]);
                                central.limbs_of(total, f[10 * welch.slot()..10 * welch.slot() + 3]);
                                let (b2, c2) = central.ratio_bits(heap, f[9 * welch.slot()..9 * welch.slot() + 3], 3, f[10 * welch.slot()..10 * welch.slot() + 3], 3, 0, false);
                                pb = b2;
                                pc = c2;
                            }
                        }
                    }
                }
            }
        }
    }
    unbox_slice(heap, tmp);
    unbox_slice(heap, fs);
    unbox_slice(heap, ds);
    unbox_slice(heap, ns);
    return MannWhitney { na: na, nb: nb, status: status, ties: ties, twice_u: twice_u, rb: rb, zb: zb, zc: zc, exact: used_exact, pb: pb, pc: pc };
}
