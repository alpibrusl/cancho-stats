edition 5;

module csvx.pick;

import std.buffer;
import std.bytes;
import std.vec;
import csvx.rule;
import toolbox.fail;

// The columns named by --cols: `sel[j]` is 1 for each named column and 0 for the others. Answers (0, _) when all is well, else (1, i) no column of the header has the name of item i, (2, i) two or more have, (3, i) item i is empty.
pub fn select[&n, &en, &t, &o](names: &n [byte], ends: &en vec.Vec[int], ncols: int, list: &t [byte], sel: &!o [int]) -> [] (int, int) {
    var j = 0;
    while j < ncols {
        sel[j] = 0;
        j = j + 1;
    }
    let count = bytes.count_byte(list, ',') + 1;
    var i = 0;
    while i < count {
        let tok = bytes.field(list, ',', i + 1);
        if len(tok) == 0 {
            return (3, i);
        }
        let (matches, at) = find(names, ends, ncols, tok);
        if matches == 0 {
            return (1, i);
        }
        if matches > 1 {
            return (2, i);
        }
        sel[at] = 1;
        i = i + 1;
    }
    return (0, 0);
}

// The column of the header that has exactly the name `tok`: (the number of columns that have it, the index of the last one)
fn find[&n, &en, &t](names: &n [byte], ends: &en vec.Vec[int], ncols: int, tok: &t [byte]) -> [] (int, int) {
    var matches = 0;
    var at = 0;
    var j = 0;
    while j < ncols {
        var from = 0;
        if j > 0 {
            from = vec.get(ends, j - 1);
        }
        if bytes.equal(names[from..vec.get(ends, j)], tok) {
            matches = matches + 1;
            at = j;
        }
        j = j + 1;
    }
    return (matches, at);
}

// The pairs named by --pairs A:B,C:D: item i is the columns pa[i] and pb[i]. Answers (0, _) when all is well, else (1, i) item i names a column that no column of the header has, (2, i) one that two or more have,
// (3, i) item i is not two names around the first colon (a name with a colon in it cannot be named in a pair).
pub fn pairs[&n, &en, &t, &a, &b](names: &n [byte], ends: &en vec.Vec[int], ncols: int, list: &t [byte], pa: &!a [int], pb: &!b [int]) -> [] (int, int) {
    let count = bytes.count_byte(list, ',') + 1;
    var i = 0;
    while i < count {
        let tok = bytes.field(list, ',', i + 1);
        var colon = 0 - 1;
        var k = 0;
        while k < len(tok) && colon < 0 {
            if int_of(tok[k]) == 58 {
                colon = k;
            }
            k = k + 1;
        }
        if colon < 1 || colon + 1 >= len(tok) {
            return (3, i);
        }
        let (ma, ia) = find(names, ends, ncols, tok[0..colon]);
        let (mb, ib) = find(names, ends, ncols, tok[colon + 1..len(tok)]);
        if ma == 0 || mb == 0 {
            return (1, i);
        }
        if ma > 1 || mb > 1 {
            return (2, i);
        }
        pa[i] = ia;
        pb[i] = ib;
        i = i + 1;
    }
    return (0, 0);
}

// Checks that every column marked in `sel` is numeric in both reads (the same read twice for a test of one file): no cell that is not a number and at least one number between the two. Answers the errors.
pub fn check_numeric[&h, &n, &en, &s, &a1, &b1, &a2, &b2](heap: &!h Heap, names: &n buffer.Buffer, ends: &en vec.Vec[int], sel: &s [int], nc: int, num_a: &a1 [int], bad_a: &b1 [int], num_b: &a2 [int], bad_b: &b2 [int], errs: fail.Errors) -> [heap] fail.Errors {
    var e = errs;
    var ok = true;
    var j = 0;
    while j < nc {
        let numeric = num_a[j] + num_b[j] > 0 && bad_a[j] == 0 && bad_b[j] == 0;
        if sel[j] == 1 && !numeric && ok {
            ok = false;
            var from = 0;
            if j > 0 {
                from = vec.get(ends, j - 1);
            }
            e = rule.refuse(heap, e, "stats.non-numeric", "--cols names a column that has no numbers or has a cell that is not a number", "name numeric columns only", "column", buffer.bytes(names)[from..vec.get(ends, j)]);
        }
        j = j + 1;
    }
    return e;
}
