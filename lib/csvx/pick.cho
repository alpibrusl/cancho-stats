edition 5;

module csvx.pick;

import std.bytes;
import std.vec;

// The columns named by --cols: `sel[j]` is 1 for each named column and 0 for the others. Answers (0, _) when all is well, else (1, i) no column of the header has the name of item i, (2, i) two or more have, (3, i) item i is empty.
pub fn select[&n, &en, &t, &o](names: &n [byte], ends: &en vec.Vec[int], ncols: int, list: &t [byte], sel: &!o [int]) -> [] (int, int) {
    var j = 0;
    while j < ncols {
        sel[j] = 0;
        j = j + 1;
    }
    let count = bytes.count_byte(list, ',') + 1;
    var i = 0;
    while i < count {
        let tok = bytes.field(list, ',', i + 1);
        if len(tok) == 0 {
            return (3, i);
        }
        var matches = 0;
        var at = 0;
        j = 0;
        while j < ncols {
            var from = 0;
            if j > 0 {
                from = vec.get(ends, j - 1);
            }
            if bytes.equal(names[from..vec.get(ends, j)], tok) {
                matches = matches + 1;
                at = j;
            }
            j = j + 1;
        }
        if matches == 0 {
            return (1, i);
        }
        if matches > 1 {
            return (2, i);
        }
        sel[at] = 1;
        i = i + 1;
    }
    return (0, 0);
}
