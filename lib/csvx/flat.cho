edition 5;

module csvx.flat;

import std.buffer;

// The path of the value that the frames `f[0..count]` lead to: `.key` for an object (no dot first), `[i]` for an array item. A frame is six integers: kind (0 object, 1 array), the index, the start and end of the current key in `doc`, how many values it has had, and whether a key is expected.
fn put_path[&h, &d, &fr](heap: &!h Heap, out: buffer.Buffer, doc: &d [byte], f: &fr [int], count: int) -> [heap] buffer.Buffer {
    var o = out;
    var k = 0;
    while k < count {
        if f[6 * k] == 0 {
            if k > 0 {
                o = buffer.push(heap, o, byte_of(46));
            }
            o = buffer.append(heap, o, doc[f[6 * k + 2]..f[6 * k + 3]]);
        } else {
            o = buffer.push(heap, o, byte_of(91));
            o = buffer.push_nat(heap, o, f[6 * k + 1]);
            o = buffer.push(heap, o, byte_of(93));
        }
        k = k + 1;
    }
    return o;
}

fn put_line[&h, &d, &fr, &l](heap: &!h Heap, out: buffer.Buffer, doc: &d [byte], f: &fr [int], count: int, lit: &l [byte]) -> [heap] buffer.Buffer {
    var o = put_path(heap, out, doc, f, count);
    o = buffer.append(heap, o, " = ");
    o = buffer.append(heap, o, lit);
    o = buffer.push(heap, o, byte_of(10));
    return o;
}

// The document (the compact JSON this tool writes: no white space between tokens) as one line `path = value` per value, in document order, an empty array or object as `[]` or `{}`. Made from the bytes of the document, so a value cannot differ from the JSON's.
pub fn flatten[&h, &d](heap: &!h Heap, doc: &d [byte]) -> [heap] buffer.Buffer {
    var out = buffer.empty(heap, 1024);
    let frames = box_slice(heap, 6 * 64 + 6, 0);
    let n = len(doc);
    var depth = 0;
    var i = 0;
    borrow mut frames as &!fw in {
        let f = contents(fw);
        while i < n && depth < 63 {
            let c = int_of(doc[i]);
            if c == 123 || c == 91 {
                if depth > 0 {
                    f[6 * (depth - 1) + 4] = f[6 * (depth - 1) + 4] + 1;
                }
                f[6 * depth] = 0;
                if c == 91 {
                    f[6 * depth] = 1;
                }
                f[6 * depth + 1] = 0;
                f[6 * depth + 4] = 0;
                f[6 * depth + 5] = 0;
                if c == 123 {
                    f[6 * depth + 5] = 1;
                }
                depth = depth + 1;
                i = i + 1;
            } else if c == 125 || c == 93 {
                depth = depth - 1;
                if f[6 * depth + 4] == 0 {
                    if c == 125 {
                        out = put_line(heap, out, doc, f, depth, "{}");
                    } else {
                        out = put_line(heap, out, doc, f, depth, "[]");
                    }
                }
                i = i + 1;
            } else if c == 44 {
                if f[6 * (depth - 1)] == 1 {
                    f[6 * (depth - 1) + 1] = f[6 * (depth - 1) + 1] + 1;
                } else {
                    f[6 * (depth - 1) + 5] = 1;
                }
                i = i + 1;
            } else if c == 58 {
                i = i + 1;
            } else {
                let start = i;
                if c == 34 {
                    i = i + 1;
                    while i < n && int_of(doc[i]) != 34 {
                        if int_of(doc[i]) == 92 {
                            i = i + 1;
                        }
                        i = i + 1;
                    }
                    i = i + 1;
                } else {
                    while i < n && int_of(doc[i]) != 44 && int_of(doc[i]) != 125 && int_of(doc[i]) != 93 {
                        i = i + 1;
                    }
                }
                let top = depth - 1;
                if c == 34 && f[6 * top] == 0 && f[6 * top + 5] == 1 {
                    f[6 * top + 2] = start + 1;
                    f[6 * top + 3] = i - 1;
                    f[6 * top + 5] = 0;
                } else {
                    f[6 * top + 4] = f[6 * top + 4] + 1;
                    out = put_line(heap, out, doc, f, depth, doc[start..i]);
                }
            }
        }
    }
    unbox_slice(heap, frames);
    return out;
}
