edition 5;

module csvx.cat;

import std.bytes;
import std.json;
import std.map;
import acc.quantile;
import csvx.cross;
import csvx.rule;
import stest.answer3;
import stest.answer4;
import stest.answer10;
import stest.chisq;
import stest.fisher;
import stest.prop;
import toolbox.cli;
import toolbox.fail;
import toolbox.place;

// The tests of the categorical columns and of proportions (`test prop`, `test chisq`, `test fisher`: one pass over the file for each column named by --cols) and the helpers they share (the decimal parser of --level and --p0, the
// adjustment line of the answer), moved out of tools/stats/main.cho, which is limited to 2,000 lines. Not one byte of any answer changed by the move (the fingerprint is the gate).

pub fn parse_p[&t](tok: &t [byte]) -> [] (int, int, bool) {
    var num = 0;
    var k = 0;
    var dot = false;
    var digits = 0;
    var i = 0;
    while i < len(tok) {
        let c = int_of(tok[i]);
        if c == '.' {
            if dot {
                return (0, 0, false);
            }
            dot = true;
        } else if c >= '0' && c <= '9' {
            digits = digits + 1;
            if dot {
                k = k + 1;
            }
            if k > 9 || digits > 12 {
                return (0, 0, false);
            }
            num = num * 10 + (c - '0');
        } else {
            return (0, 0, false);
        }
        i = i + 1;
    }
    if digits == 0 || num > quantile.pow10(k) {
        return (0, 0, false);
    }
    return (num, k, true);
}

// the list of probabilities is valid: 1 to 99 tokens, each a probability
pub fn put_adjustment[&h, &c](heap: &!h Heap, w0: json.Writer, correction: &c [byte]) -> [heap] json.Writer {
    var w = json.put_key(heap, w0, "adjustment");
    w = json.put_string(heap, w, correction);
    return w;
}

// whether none of the comma separated items of the list is empty
fn no_empty_item[&l](list: &l [byte]) -> [] bool {
    var i = 0;
    while i < bytes.count_byte(list, ',') + 1 {
        if len(bytes.field(list, ',', i + 1)) == 0 {
            return false;
        }
        i = i + 1;
    }
    return true;
}

// The tests of the 2 x 2 tables of each column named by --cols against the column of --vs, kind fisher (docs/rank.md section 14). One pass over the file for each column.
pub fn fisher_one[&h, &g, &p, &f, &r, &sh, &fu](heap: &!h Heap, args: &g Args, parsed: &p cli.Parsed, fs: &f Fs(""), root: &r [byte], rel: &sh [byte], full: &fu [byte], table: &static [byte], w0: json.Writer, errs: fail.Errors) -> [heap, args, fs_read(""), dir_read, file_read] (json.Writer, fail.Errors) {
    var w = w0;
    var e = errs;
    let list = cli.text(args, parsed, table, "cols");
    let ncols_named = bytes.count_byte(list, ',') + 1;
    var ok = no_empty_item(list);
    var i = 0;
    if !ok {
        e = rule.refuse(heap, e, "args.bad-value", "--cols has an empty item", "--cols name1,name2: no empty item, no leading or trailing comma", "flag", "--cols");
    }
    let opened_header = ok;
    if ok {
        w = json.put_key(heap, w, "test");
        w = json.put_string(heap, w, "fisher");
        w = json.put_key(heap, w, "vs");
        w = json.put_string(heap, w, cli.text(args, parsed, table, "vs"));
        w = put_adjustment(heap, w, cli.text(args, parsed, table, "correct"));
        w = json.put_key(heap, w, "tests");
        w = json.begin_array(heap, w);
    }
    i = 0;
    while ok && i < ncols_named {
        let name = bytes.field(list, ',', i + 1);
        match place.open_operand(fs, root, rel, full) {
            Opened::Failed(reason) => {
                e = fail.io_error(heap, e, reason, false, rel);
            }
            Opened::Ok(opened) => {
                var file = opened;
                borrow mut file as &!handle in {
                    let (x, e2) = cross.cross(heap, handle, rel, name, cli.text(args, parsed, table, "vs"), true, false, int_of(cli.text(args, parsed, table, "delim")[0]), cli.nat(args, parsed, table, "max-line-bytes"), cli.nat(args, parsed, table, "max-rows"), cli.nat(args, parsed, table, "max-cols"), cli.nat(args, parsed, table, "max-groups"), e);
                    e = e2;
                    var clean = false;
                    borrow e as &er1 in {
                        clean = fail.count(er1) == 0;
                    }
                    if clean {
                        let dn = cross.dense(heap, x, true);
                        borrow dn as &dr in {
                            if dr.rows_ == 0 {
                                w = answer10.put_fisher(heap, w, name, cli.text(args, parsed, table, "vs"), dr, fisher.run(heap, 0, 0, 0, 0), dr.total);
                            } else if dr.rows_ != 2 || dr.cols_ != 2 {
                                e = rule.refuse_int(heap, e, "stats.group-levels", "fisher needs exactly two levels in each of the two columns", "filter the file to two levels of each column, or use chisq for a larger table", "levels", dr.rows_ * 1000 + dr.cols_, "missing", dr.total - dr.cross.used);
                            } else if dr.cross.used > fisher.limit() {
                                e = rule.refuse_int(heap, e, "limit.exact-too-large", "the exact p-value of Fisher's test is answered for at most 10,000 rows", "use chisq, which has no such limit", "rows", dr.cross.used, "limit", fisher.limit());
                            } else {
                                let cn = contents(dr.counts);
                                w = answer10.put_fisher(heap, w, name, cli.text(args, parsed, table, "vs"), dr, fisher.run(heap, cn[0], cn[1], cn[2], cn[3]), dr.total);
                            }
                        }
                        cross.drop_dense(heap, dn);
                    } else {
                        cross.drop_cross(heap, x);
                    }
                }
                file_close(file);
            }
        }
        var more = false;
        borrow e as &er3 in {
            more = fail.count(er3) == 0;
        }
        if !more {
            ok = false;
        }
        i = i + 1;
    }
    if opened_header {
        w = json.end_array(heap, w);
    }
    return (w, e);
}

// The tests of the categorical columns named by --cols, kind chisq (docs/test.md section 10): each against the column of --vs (independence), or against the proportions of --expected (goodness of fit). One pass over
// the file for each column.
pub fn chisq_one[&h, &g, &p, &f, &r, &sh, &fu](heap: &!h Heap, args: &g Args, parsed: &p cli.Parsed, fs: &f Fs(""), root: &r [byte], rel: &sh [byte], full: &fu [byte], table: &static [byte], w0: json.Writer, errs: fail.Errors) -> [heap, args, fs_read(""), dir_read, file_read] (json.Writer, fail.Errors) {
    var w = w0;
    var e = errs;
    let fit = cli.has(parsed, table, "expected");
    let list = cli.text(args, parsed, table, "cols");
    let ncols_named = bytes.count_byte(list, ',') + 1;
    var ok = no_empty_item(list);
    var i = 0;
    if !ok {
        e = rule.refuse(heap, e, "args.bad-value", "--cols has an empty item", "--cols name1,name2: no empty item, no leading or trailing comma", "flag", "--cols");
    }
    let (pst, props, kprops) = chisq.parse_expected(heap, cli.text(args, parsed, table, "expected"));
    if fit && pst != 0 {
        ok = false;
        e = rule.refuse_int(heap, e, "stats.expected-proportions", "--expected is not decimals above 0 with at most 9 decimals that add up to 1", "--expected 0.25,0.25,0.5: at most 1,000 items, no sign, no exponent", "problem", pst, "items", kprops);
    }
    let opened_header = ok;
    if ok {
        w = json.put_key(heap, w, "test");
        w = json.put_string(heap, w, "chisq");
        if fit {
            w = json.put_key(heap, w, "expected");
            w = json.begin_array(heap, w);
            borrow props as &pr0 in {
                var k = 0;
                while k < kprops {
                    w = json.put_float(heap, w, float_of(contents(pr0)[k]) / 1000000000.0);
                    k = k + 1;
                }
            }
            w = json.end_array(heap, w);
        } else {
            w = json.put_key(heap, w, "vs");
            w = json.put_string(heap, w, cli.text(args, parsed, table, "vs"));
        }
        w = put_adjustment(heap, w, cli.text(args, parsed, table, "correct"));
        w = json.put_key(heap, w, "tests");
        w = json.begin_array(heap, w);
    }
    i = 0;
    while ok && i < ncols_named {
        let name = bytes.field(list, ',', i + 1);
        match place.open_operand(fs, root, rel, full) {
            Opened::Failed(reason) => {
                e = fail.io_error(heap, e, reason, false, rel);
            }
            Opened::Ok(opened) => {
                var file = opened;
                borrow mut file as &!handle in {
                    let (x, e2) = cross.cross(heap, handle, rel, name, cli.text(args, parsed, table, "vs"), !fit, false, int_of(cli.text(args, parsed, table, "delim")[0]), cli.nat(args, parsed, table, "max-line-bytes"), cli.nat(args, parsed, table, "max-rows"), cli.nat(args, parsed, table, "max-cols"), cli.nat(args, parsed, table, "max-groups"), e);
                    e = e2;
                    var clean = false;
                    borrow e as &er1 in {
                        clean = fail.count(er1) == 0;
                    }
                    if clean {
                        let dn = cross.dense(heap, x, !fit);
                        var stat = chisq.ChiSq { n: 0, rows_: 0, cols_: 0, df: 0, x2: 0.0, effect: 0.0, min_expected: 0.0, below5: 0 };
                        borrow dn as &dr in {
                            if dr.rows_ == 0 {
                                stat = chisq.ChiSq { n: 0, rows_: 0, cols_: 0, df: 0, x2: 0.0, effect: 0.0, min_expected: 0.0, below5: 0 };
                            } else if fit {
                                if dr.rows_ != kprops {
                                    e = rule.refuse_int(heap, e, "stats.expected-proportions", "--expected has a different number of proportions than the column has levels", "give one proportion for each level, in the order of the levels by their bytes", "levels", dr.rows_, "expected", kprops);
                                } else {
                                    borrow props as &pr1 in {
                                        stat = chisq.fit(contents(dr.counts), contents(pr1), kprops, 1000000000);
                                    }
                                }
                            } else {
                                stat = chisq.independence(heap, contents(dr.counts), dr.rows_, dr.cols_);
                            }
                            borrow e as &er2 in {
                                clean = fail.count(er2) == 0;
                            }
                            if clean {
                                w = answer3.put_chisq(heap, w, name, cli.text(args, parsed, table, "vs"), fit, dr, stat, dr.total);
                            }
                        }
                        cross.drop_dense(heap, dn);
                    } else {
                        cross.drop_cross(heap, x);
                    }
                }
                file_close(file);
            }
        }
        var more = false;
        borrow e as &er3 in {
            more = fail.count(er3) == 0;
        }
        if !more {
            ok = false;
        }
        i = i + 1;
    }
    if opened_header {
        w = json.end_array(heap, w);
    }
    unbox_slice(heap, props);
    return (w, e);
}

// The tests of the proportion of successes in each column named by --cols (docs/test.md section 11): against --p0, or, with --group, between the two groups. One pass over the file for each column.
pub fn prop_one[&h, &g, &p, &f, &r, &sh, &fu](heap: &!h Heap, args: &g Args, parsed: &p cli.Parsed, fs: &f Fs(""), root: &r [byte], rel: &sh [byte], full: &fu [byte], table: &static [byte], w0: json.Writer, errs: fail.Errors) -> [heap, args, fs_read(""), dir_read, file_read] (json.Writer, fail.Errors) {
    var w = w0;
    var e = errs;
    let two = cli.has(parsed, table, "group");
    let list = cli.text(args, parsed, table, "cols");
    let ncols_named = bytes.count_byte(list, ',') + 1;
    let success = cli.text(args, parsed, table, "success");
    var ok = no_empty_item(list);
    var i = 0;
    if !ok {
        e = rule.refuse(heap, e, "args.bad-value", "--cols has an empty item", "--cols name1,name2: no empty item, no leading or trailing comma", "flag", "--cols");
    }
    let (lnum, lk, lok) = parse_p(cli.text(args, parsed, table, "level"));
    let level = float_of(lnum) / float_of(quantile.pow10(lk));
    let (p0n, p0k, p0ok) = parse_p(cli.text(args, parsed, table, "p0"));
    let dd = 1000000000;
    let p0 = p0n * (dd / quantile.pow10(p0k));
    let opened_header = ok;
    if ok {
        w = json.put_key(heap, w, "test");
        w = json.put_string(heap, w, "prop");
        w = json.put_key(heap, w, "success");
        w = json.put_string(heap, w, success);
        if two {
            w = json.put_key(heap, w, "group");
            w = json.put_string(heap, w, cli.text(args, parsed, table, "group"));
        } else {
            w = json.put_key(heap, w, "p0");
            w = json.put_float(heap, w, float_of(p0) / 1000000000.0);
        }
        w = json.put_key(heap, w, "level");
        w = json.put_float(heap, w, level);
        w = put_adjustment(heap, w, cli.text(args, parsed, table, "correct"));
        w = json.put_key(heap, w, "tests");
        w = json.begin_array(heap, w);
    }
    i = 0;
    while ok && i < ncols_named {
        let name = bytes.field(list, ',', i + 1);
        match place.open_operand(fs, root, rel, full) {
            Opened::Failed(reason) => {
                e = fail.io_error(heap, e, reason, false, rel);
            }
            Opened::Ok(opened) => {
                var file = opened;
                borrow mut file as &!handle in {
                    let (x, e2) = cross.cross(heap, handle, rel, name, cli.text(args, parsed, table, "group"), two, true, int_of(cli.text(args, parsed, table, "delim")[0]), cli.nat(args, parsed, table, "max-line-bytes"), cli.nat(args, parsed, table, "max-rows"), cli.nat(args, parsed, table, "max-cols"), cli.nat(args, parsed, table, "max-groups"), e);
                    e = e2;
                    var clean = false;
                    borrow e as &er1 in {
                        clean = fail.count(er1) == 0;
                    }
                    if clean {
                        let dn = cross.dense(heap, x, two);
                        borrow dn as &dr in {
                            // the row of the success level in the table (-1: no row has it) and the trials of each column of the table
                            let sr = map.get(dr.cross.la, success, 0 - 1);
                            var xs = 0;
                            var n1 = 0;
                            var x1 = 0;
                            var n2 = 0;
                            var x2 = 0;
                            var row = 0;
                            while row < dr.rows_ {
                                n1 = n1 + contents(dr.counts)[row * dr.cols_];
                                if two {
                                    n2 = n2 + contents(dr.counts)[row * dr.cols_ + 1];
                                }
                                row = row + 1;
                            }
                            if sr >= 0 {
                                x1 = contents(dr.counts)[sr * dr.cols_];
                                if two {
                                    x2 = contents(dr.counts)[sr * dr.cols_ + 1];
                                }
                            }
                            if two && dr.cols_ != 2 {
                                e = rule.refuse_int(heap, e, "stats.group-levels", "--group names a column that does not have exactly two levels", "give --group a column with two levels, or filter the file to two of them", "levels", dr.cols_, "missing", dr.total - n1 - n2);
                            } else if two {
                                let pr = prop.two_sample(heap, x1, n1, x2, n2);
                                w = answer4.put_two(heap, w, name, map.key_at(dr.cross.lb, contents(dr.order_b)[0]), map.key_at(dr.cross.lb, contents(dr.order_b)[1]), x1, n1, x2, n2, dr.total, pr, lnum, lk, level);
                            } else {
                                let pr = prop.one_sample(heap, x1, n1, p0, dd);
                                w = answer4.put_one(heap, w, name, x1, n1, dr.total, pr, p0, dd, lnum, lk, level);
                            }
                        }
                        cross.drop_dense(heap, dn);
                    } else {
                        cross.drop_cross(heap, x);
                    }
                }
                file_close(file);
            }
        }
        var more = false;
        borrow e as &er3 in {
            more = fail.count(er3) == 0;
        }
        if !more {
            ok = false;
        }
        i = i + 1;
    }
    if opened_header {
        w = json.end_array(heap, w);
    }
    return (w, e);
}
