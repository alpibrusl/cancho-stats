edition 5;

module csvx.run;

import std.buffer;
import std.bytes;
import std.json;
import std.map;
import std.vec;
import acc.psum;
import csvx.pick;
import csvx.rule;
import csvx.scan;
import flt;
import metrics.rank;
import stest.kruskal;
import stest.mannwhitney;
import stest.answer7;
import stest.answer6;
import stest.anova;
import stest.answer5;
import stest.welch;
import stest.welchf;
import toolbox.cli;
import toolbox.fail;
import toolbox.place;

// The kinds of test that read one group of the file at a time (moved out of tools/stats/main.cho, which is limited to 2,000 lines): the reading of one group, and the analysis of variance of docs/rank.md section 3.

// One group of the file: the file opened, read for the rows whose group cell is `key`, closed. On a failure the errors say so and the tables are empty.
pub fn read_group[&h, &g, &p, &f, &r, &sh, &fu, &k](heap: &!h Heap, args: &g Args, parsed: &p cli.Parsed, fs: &f Fs(""), root: &r [byte], rel: &sh [byte], full: &fu [byte], table: &static [byte], by: int, key: &k [byte], errs: fail.Errors) -> [heap, args, fs_read(""), dir_read, file_read] (buffer.Buffer, vec.Vec[int], scan.Cols, vec.Vec[int], scan.Scanned, fail.Errors) {
    var names = buffer.empty(heap, 1);
    var ends = vec.empty(heap, 1, 0);
    var cols = scan.make_cols(heap, 1);
    var store = vec.empty(heap, 1, 0);
    var info = scan.Scanned { rows: 0, ncols: 0 };
    var e = errs;
    match place.open_operand(fs, root, rel, full) {
        Opened::Failed(reason) => {
            e = fail.io_error(heap, e, reason, false, rel);
        }
        Opened::Ok(opened) => {
            var file = opened;
            borrow mut file as &!handle in {
                let (n2, ends2, cols2, store2, info2, e2) = scan.read_file(heap, cli.nat(args, parsed, table, "max-line-bytes"), int_of(cli.text(args, parsed, table, "delim")[0]), cli.nat(args, parsed, table, "max-rows"), cli.nat(args, parsed, table, "max-cols"), cli.nat(args, parsed, table, "max-cells"), handle, rel, by, key, false, e);
                buffer.drop(heap, names);
                vec.drop(heap, ends);
                scan.drop_cols(heap, cols);
                vec.drop(heap, store);
                names = n2;
                ends = ends2;
                cols = cols2;
                store = store2;
                info = info2;
                e = e2;
            }
            file_close(file);
        }
    }
    return (names, ends, cols, store, info, e);
}

// the exact sums of the selected columns of one group into the accumulators: the column of rank si among the selected ones, group i of k, at (si * k + i) * g; the counts into ns at si * k + i; the cells that are numbers and that are not into the totals
fn fold_group[&s, &c, &x, &a, &n, &tn, &tb, &w](store: &s vec.Vec[int], rows: int, cols: &c scan.Cols, nc: int, sel: &x [int], k: int, i: int, g: int, acc: &!a [int], ns: &!n [int], totnum: &!tn [int], totbad: &!tb [int], wk: &!w [int]) -> [] int {
    var si = 0;
    var j = 0;
    while j < nc {
        if sel[j] == 1 {
            let at = (si * k + i) * g;
            ns[si * k + i] = welch.fill(store, nc, j, rows, acc[at..at + g], wk);
            totnum[j] = totnum[j] + contents(cols.numeric)[j];
            totbad[j] = totbad[j] + contents(cols.bad)[j];
            si = si + 1;
        }
        j = j + 1;
    }
    return si;
}

// the cells of the selected columns of one group, row by row (nsel keys for each row), and the group's index for each row, appended to the stores of all the groups
fn collect_group[&h, &s, &x](heap: &!h Heap, store: &s vec.Vec[int], rows: int, nc: int, sel: &x [int], i: int, gk0: vec.Vec[int], gi0: vec.Vec[int]) -> [heap] (vec.Vec[int], vec.Vec[int]) {
    var gk = gk0;
    var gi = gi0;
    var r = 0;
    while r < rows {
        var j = 0;
        while j < nc {
            if sel[j] == 1 {
                gk = vec.push(heap, gk, vec.get(store, r * nc + j));
            }
            j = j + 1;
        }
        gi = vec.push(heap, gi, i);
        r = r + 1;
    }
    return (gk, gi);
}

// the tests of kind kruskal for the selected columns: for each, the present values with their group index go to stest.kruskal
fn put_kruskal_tests[&h, &n, &en, &x, &a, &b](heap: &!h Heap, w0: json.Writer, names: &n [byte], ends: &en vec.Vec[int], sel: &x [int], nc: int, nsel: int, gk: &a vec.Vec[int], gi: &b vec.Vec[int], total: int, k: int) -> [heap] json.Writer {
    var w = w0;
    let pk = box_slice(heap, total + 1, 0);
    let pg = box_slice(heap, total + 1, 0);
    let ds = box_slice(heap, k + 1, 0);
    let ns = box_slice(heap, k + 1, 0);
    var si = 0;
    var cj = 0;
    while cj < nc {
        if sel[cj] == 1 {
            borrow mut pk as &!pkw in {
                borrow mut pg as &!pgw in {
                    borrow mut ds as &!dsw in {
                        borrow mut ns as &!nsw in {
                            var m = 0;
                            var r = 0;
                            while r < total {
                                let key = vec.get(gk, r * nsel + si);
                                if key != rank.min_int() {
                                    contents(pkw)[m] = key;
                                    contents(pgw)[m] = vec.get(gi, r);
                                    m = m + 1;
                                }
                                r = r + 1;
                            }
                            var z = 0;
                            while z < k {
                                contents(dsw)[z] = 0;
                                contents(nsw)[z] = 0;
                                z = z + 1;
                            }
                            let kr = kruskal.run(heap, contents(pkw), contents(pgw), m, k, contents(dsw), contents(nsw));
                            w = answer6.put_kruskal(heap, w, names, ends, cj, kr, contents(nsw), contents(dsw), k);
                        }
                    }
                }
            }
            si = si + 1;
        }
        cj = cj + 1;
    }
    unbox_slice(heap, pk);
    unbox_slice(heap, pg);
    unbox_slice(heap, ds);
    unbox_slice(heap, ns);
    return w;
}

// the tests of kind mannwhitney for the selected columns (the group index 0 is the group a); the exact mode and the continuity correction as the flags say
fn put_mw_tests[&h, &n, &en, &x, &a, &b, &t1, &t2](heap: &!h Heap, w0: json.Writer, names: &n [byte], ends: &en vec.Vec[int], sel: &x [int], nc: int, nsel: int, gk: &a vec.Vec[int], gi: &b vec.Vec[int], total: int, exact_text: &t1 [byte], cont_text: &t2 [byte]) -> [heap] json.Writer {
    var w = w0;
    let pk = box_slice(heap, total + 1, 0);
    let pg = box_slice(heap, total + 1, 0);
    var mode = 0;
    if bytes.equal(exact_text, "yes") {
        mode = 1;
    } else if bytes.equal(exact_text, "no") {
        mode = 2;
    }
    var cont = 1;
    if bytes.equal(cont_text, "none") {
        cont = 0;
    }
    var si = 0;
    var cj = 0;
    while cj < nc {
        if sel[cj] == 1 {
            borrow mut pk as &!pkw in {
                borrow mut pg as &!pgw in {
                    var m = 0;
                    var r = 0;
                    while r < total {
                        let key = vec.get(gk, r * nsel + si);
                        if key != rank.min_int() {
                            contents(pkw)[m] = key;
                            contents(pgw)[m] = vec.get(gi, r);
                            m = m + 1;
                        }
                        r = r + 1;
                    }
                    let mr = mannwhitney.run(heap, contents(pkw), contents(pgw), m, mode, cont);
                    w = answer7.put_mannwhitney(heap, w, names, ends, cj, mr, cont == 1);
                }
            }
            si = si + 1;
        }
        cj = cj + 1;
    }
    unbox_slice(heap, pk);
    unbox_slice(heap, pg);
    return w;
}

// the first selected column (its index in the file) for which the exact p-value is not available, or -1
fn first_without_exact[&h, &x, &a](heap: &!h Heap, sel: &x [int], nc: int, nsel: int, gk: &a vec.Vec[int], total: int) -> [heap] int {
    let pk = box_slice(heap, total + 1, 0);
    var found = 0 - 1;
    var si = 0;
    var cj = 0;
    while cj < nc && found < 0 {
        if sel[cj] == 1 {
            borrow mut pk as &!pkw in {
                var m = 0;
                var r = 0;
                while r < total {
                    let key = vec.get(gk, r * nsel + si);
                    if key != rank.min_int() {
                        contents(pkw)[m] = key;
                        m = m + 1;
                    }
                    r = r + 1;
                }
                if !mannwhitney.possible(contents(pkw), m) {
                    found = cj;
                }
            }
            si = si + 1;
        }
        cj = cj + 1;
    }
    unbox_slice(heap, pk);
    return found;
}

// The analysis of variance (kind 0), the Kruskal-Wallis test (kind 1) or the Mann-Whitney test (kind 2) of the columns named by --cols over the groups (k >= 2 levels, at most --max-groups) of the column named by --group. Pass 0 finds the levels; then the file is read once for each level, in the order of the
// bytes of the levels, and only the exact sums of each (group, column) are kept, never the rows of two groups at once.
pub fn groups_one[&h, &g, &p, &f, &r, &sh, &fu](heap: &!h Heap, args: &g Args, parsed: &p cli.Parsed, fs: &f Fs(""), root: &r [byte], rel: &sh [byte], full: &fu [byte], table: &static [byte], kind: int, w0: json.Writer, errs: fail.Errors) -> [heap, args, fs_read(""), dir_read, file_read] (json.Writer, fail.Errors) {
    var w = w0;
    var e = errs;
    match place.open_operand(fs, root, rel, full) {
        Opened::Failed(reason) => {
            e = fail.io_error(heap, e, reason, false, rel);
        }
        Opened::Ok(opened) => {
            var file = opened;
            borrow mut file as &!handle in {
                let (groups, by, e1) = scan.discover(heap, handle, rel, cli.text(args, parsed, table, "group"), int_of(cli.text(args, parsed, table, "delim")[0]), cli.nat(args, parsed, table, "max-line-bytes"), cli.nat(args, parsed, table, "max-rows"), cli.nat(args, parsed, table, "max-cols"), cli.nat(args, parsed, table, "max-groups"), e);
                e = e1;
                var clean = false;
                borrow e as &er1 in {
                    clean = fail.count(er1) == 0;
                }
                borrow groups as &gr in {
                    let k = map.size(gr.m);
                    if clean && k < 2 {
                        clean = false;
                        e = rule.refuse_int(heap, e, "stats.group-levels", "--group names a column that has fewer than two levels", "give --group a column with two or more levels", "levels", k, "missing", gr.nulls);
                    }
                    if clean && kind == 2 && k != 2 {
                        clean = false;
                        e = rule.refuse_int(heap, e, "stats.group-levels", "--group names a column that does not have exactly two levels", "give --group a column with two levels, or filter the file to two of them", "levels", k, "missing", gr.nulls);
                    }
                    if clean {
                        let g1 = psum.size(1) + psum.size(2);
                        var names = buffer.empty(heap, 1);
                        var ends = vec.empty(heap, 1, 0);
                        var nc = 0;
                        var nsel = 0;
                        var rows_total = gr.nulls;
                        var acc = box_slice(heap, 1, 0);
                        var ns = box_slice(heap, 1, 0);
                        var sel = box_slice(heap, 1, 0);
                        var totnum = box_slice(heap, 1, 0);
                        var totbad = box_slice(heap, 1, 0);
                        let wkb = box_slice(heap, psum.scratch() + 1, 0);
                        var gkeys = vec.empty(heap, 1, 0);
                        var gids = vec.empty(heap, 1, 0);
                        var i = 0;
                        while i < k && clean {
                            let key = map.key_at(gr.m, contents(gr.order)[i]);
                            let (nm, en, cl, st, info, e2) = read_group(heap, args, parsed, fs, root, rel, full, table, by, key, e);
                            e = e2;
                            borrow e as &er2 in {
                                clean = fail.count(er2) == 0;
                            }
                            if clean && i == 0 {
                                nc = info.ncols;
                                unbox_slice(heap, sel);
                                sel = box_slice(heap, nc + 1, 0);
                                unbox_slice(heap, totnum);
                                totnum = box_slice(heap, nc + 1, 0);
                                unbox_slice(heap, totbad);
                                totbad = box_slice(heap, nc + 1, 0);
                                var stt = 0;
                                var item = 0;
                                borrow nm as &nb0 in {
                                    borrow en as &eb0 in {
                                        borrow mut sel as &!sw0 in {
                                            let (s1, i1) = pick.select(buffer.bytes(nb0), eb0, nc, cli.text(args, parsed, table, "cols"), contents(sw0));
                                            stt = s1;
                                            item = i1;
                                            var j = 0;
                                            while j < nc {
                                                nsel = nsel + contents(sw0)[j];
                                                j = j + 1;
                                            }
                                        }
                                    }
                                }
                                if stt != 0 {
                                    clean = false;
                                    e = rule.refuse_pick(heap, e, stt, bytes.field(cli.text(args, parsed, table, "cols"), ',', item + 1), false);
                                } else if kind == 0 && k * nsel > 8192 {
                                    clean = false;
                                    e = rule.refuse_int(heap, e, "limit.too-many-groups", "the groups times the chosen columns are more than 8,192 (each pair keeps exact sums of 4 KB)", "name fewer columns or filter the file to fewer groups", "groups", k, "columns", nsel);
                                } else if kind == 0 {
                                    unbox_slice(heap, acc);
                                    acc = box_slice(heap, k * nsel * g1 + 1, 0);
                                    unbox_slice(heap, ns);
                                    ns = box_slice(heap, k * nsel + 1, 0);
                                }
                                buffer.drop(heap, names);
                                vec.drop(heap, ends);
                                names = nm;
                                ends = en;
                            } else {
                                buffer.drop(heap, nm);
                                vec.drop(heap, en);
                            }
                            if clean && kind >= 1 {
                                borrow st as &sv in {
                                    borrow sel as &sr in {
                                        let (gk2, gi2) = collect_group(heap, sv, info.rows, nc, contents(sr), i, gkeys, gids);
                                        gkeys = gk2;
                                        gids = gi2;
                                    }
                                }
                                var held = 0;
                                borrow gkeys as &gk3 in {
                                    held = vec.size(gk3);
                                }
                                if held > cli.nat(args, parsed, table, "max-cells") {
                                    clean = false;
                                    e = rule.refuse(heap, e, "limit.too-many-cells", "the cells of the chosen columns held for the ranks are more than --max-cells", "name fewer columns or raise --max-cells", "", "");
                                }
                            }
                            if clean {
                                if kind == 0 {
                                borrow st as &sv in {
                                    borrow cl as &cv in {
                                        borrow sel as &sr in {
                                            borrow mut acc as &!aw in {
                                                borrow mut ns as &!nw in {
                                                    borrow mut totnum as &!tnw in {
                                                        borrow mut totbad as &!tbw in {
                                                            borrow mut wkb as &!wkw in {
                                                                fold_group(sv, info.rows, cv, nc, contents(sr), k, i, g1, contents(aw), contents(nw), contents(tnw), contents(tbw), contents(wkw));
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                                } else {
                                    borrow cl as &cv in {
                                        borrow mut totnum as &!tnw in {
                                            borrow mut totbad as &!tbw in {
                                                var jj = 0;
                                                while jj < nc {
                                                    contents(tnw)[jj] = contents(tnw)[jj] + contents(cv.numeric)[jj];
                                                    contents(tbw)[jj] = contents(tbw)[jj] + contents(cv.bad)[jj];
                                                    jj = jj + 1;
                                                }
                                            }
                                        }
                                    }
                                }
                                rows_total = rows_total + info.rows;
                            }
                            scan.drop_cols(heap, cl);
                            vec.drop(heap, st);
                            i = i + 1;
                        }
                        if clean {
                            var j = 0;
                            while j < nc && clean {
                                var numeric = false;
                                var chosen = false;
                                borrow sel as &sr2 in {
                                    borrow totnum as &tn2 in {
                                        borrow totbad as &tb2 in {
                                            chosen = contents(sr2)[j] == 1;
                                            numeric = contents(tn2)[j] > 0 && contents(tb2)[j] == 0;
                                        }
                                    }
                                }
                                if chosen && !numeric {
                                    clean = false;
                                    var from = 0;
                                    if j > 0 {
                                        borrow ends as &eb4 in {
                                            from = vec.get(eb4, j - 1);
                                        }
                                    }
                                    borrow names as &nb2 in {
                                        borrow ends as &eb2 in {
                                            e = rule.refuse(heap, e, "stats.non-numeric", "--cols names a column that has no numbers or has a cell that is not a number", "name numeric columns only", "column", buffer.bytes(nb2)[from..vec.get(eb2, j)]);
                                        }
                                    }
                                }
                                j = j + 1;
                            }
                        }
                        if clean && kind == 2 && bytes.equal(cli.text(args, parsed, table, "exact"), "yes") {
                            var bad_col = 0 - 1;
                            borrow sel as &sr6 in {
                                borrow gkeys as &gkr3 in {
                                    bad_col = first_without_exact(heap, contents(sr6), nc, nsel, gkr3, vec.size(gkr3) / nsel);
                                }
                            }
                            if bad_col >= 0 {
                                clean = false;
                                var from = 0;
                                if bad_col > 0 {
                                    borrow ends as &eb7 in {
                                        from = vec.get(eb7, bad_col - 1);
                                    }
                                }
                                borrow names as &nb6 in {
                                    borrow ends as &eb8 in {
                                        e = rule.refuse(heap, e, "stats.exact-unavailable", "--exact yes, but the exact p-value is available only without ties and for at most 60 values", "use --exact auto, or --exact no for the normal approximation", "column", buffer.bytes(nb6)[from..vec.get(eb8, bad_col)]);
                                    }
                                }
                            }
                        }
                        if clean {
                            let pooled = bytes.equal(cli.text(args, parsed, table, "variance"), "pooled");
                            let gsb = box_slice(heap, 3 * k + 3, 0);
                            w = json.put_key(heap, w, "test");
                            if kind == 0 {
                                w = json.put_string(heap, w, "anova");
                            } else {
                                if kind == 1 {
                                w = json.put_string(heap, w, "kruskal");
                                } else {
                                w = json.put_string(heap, w, "mannwhitney");
                                }
                            }
                            w = json.put_key(heap, w, "group");
                            w = json.put_string(heap, w, cli.text(args, parsed, table, "group"));
                            w = json.put_key(heap, w, "levels");
                            w = json.begin_array(heap, w);
                            var li = 0;
                            while li < k {
                                w = json.put_string(heap, w, map.key_at(gr.m, contents(gr.order)[li]));
                                li = li + 1;
                            }
                            w = json.end_array(heap, w);
                            w = json.put_key(heap, w, "rows");
                            w = json.put_int(heap, w, rows_total);
                            if kind == 0 {
                                w = json.put_key(heap, w, "variance");
                                if pooled {
                                    w = json.put_string(heap, w, "pooled");
                                } else {
                                    w = json.put_string(heap, w, "welch");
                                }
                            }
                            w = json.put_key(heap, w, "adjustment");
                            w = json.put_string(heap, w, cli.text(args, parsed, table, "correct"));
                            w = json.put_key(heap, w, "tests");
                            w = json.begin_array(heap, w);
                            if kind == 2 {
                                borrow sel as &sr5 in {
                                    borrow names as &nb5 in {
                                        borrow ends as &eb6 in {
                                            borrow gkeys as &gkr2 in {
                                                borrow gids as &gir2 in {
                                                    w = put_mw_tests(heap, w, buffer.bytes(nb5), eb6, contents(sr5), nc, nsel, gkr2, gir2, vec.size(gir2), cli.text(args, parsed, table, "exact"), cli.text(args, parsed, table, "continuity"));
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                            if kind == 1 {
                                borrow sel as &sr4 in {
                                    borrow names as &nb4 in {
                                        borrow ends as &eb5 in {
                                            borrow gkeys as &gkr in {
                                                borrow gids as &gir in {
                                                    w = put_kruskal_tests(heap, w, buffer.bytes(nb4), eb5, contents(sr4), nc, nsel, gkr, gir, vec.size(gir), k);
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                            var si = 0;
                            var cj = 0;
                            while cj < nc && kind == 0 {
                                var chosen2 = false;
                                borrow sel as &sr3 in {
                                    chosen2 = contents(sr3)[cj] == 1;
                                }
                                if chosen2 {
                                    borrow acc as &ar in {
                                        borrow ns as &nr in {
                                            borrow mut gsb as &!gw in {
                                                borrow names as &nb3 in {
                                                  borrow ends as &eb3 in {
                                                    let an = anova.one_way(heap, contents(ar)[si * k * g1..(si + 1) * k * g1], contents(nr)[si * k..(si + 1) * k], k, g1, contents(gw));
                                                    var wr = welchf.WelchF { status: 1, f: 0.0, df: 0.0 };
                                                    if !pooled {
                                                        wr = welchf.welch_f(heap, contents(ar)[si * k * g1..(si + 1) * k * g1], contents(nr)[si * k..(si + 1) * k], k, g1);
                                                    }
                                                    w = answer5.put_anova(heap, w, buffer.bytes(nb3), eb3, cj, an, wr, contents(nr)[si * k..(si + 1) * k], contents(gw), k, pooled);
                                                  }
                                                }
                                            }
                                        }
                                    }
                                    si = si + 1;
                                }
                                cj = cj + 1;
                            }
                            w = json.end_array(heap, w);
                            unbox_slice(heap, gsb);
                        }
                        buffer.drop(heap, names);
                        vec.drop(heap, ends);
                        unbox_slice(heap, acc);
                        unbox_slice(heap, ns);
                        unbox_slice(heap, sel);
                        unbox_slice(heap, totnum);
                        unbox_slice(heap, totbad);
                        unbox_slice(heap, wkb);
                        vec.drop(heap, gkeys);
                        vec.drop(heap, gids);
                    }
                }
                scan.drop_groups(heap, groups);
            }
            file_close(file);
        }
    }
    return (w, e);
}
