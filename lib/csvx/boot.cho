edition 5;

module csvx.boot;

import std.buffer;
import std.bytes;
import std.json;
import std.vec;
import csvx.cat;
import csvx.pick;
import csvx.rule;
import csvx.scan;
import acc.quantile;
import flt;
import metrics.rank;
import stest.answer;
import stest.boots;
import toolbox.cli;
import toolbox.fail;
import toolbox.place;

// `stats ci boot` (docs/resample.md section 12), moved out of tools/stats/main.cho, which is limited to 2,000 lines: the percentile interval of the mean, median, variance or sd of each column named by --cols, from --replicates
// resamples of the present values of the column (stest.boots). The endpoints are replicates themselves, at the positions printed, so no arithmetic touches them.

fn float_of_bits(bits: int) -> [] float {
    var key = bits;
    if bits < 0 {
        key = bits ^ 0x7fffffffffffffff;
    }
    return flt.float_of_key(key);
}

// the seed: all digits, 1 to 19 of them, below 2^62; (value, ok)
fn parse_seed[&t](text: &t [byte]) -> [] (int, bool) {
    if len(text) == 0 || len(text) > 19 {
        return (0, false);
    }
    var v = 0;
    var i = 0;
    while i < len(text) {
        let c = int_of(text[i]);
        if c < 48 || c > 57 {
            return (0, false);
        }
        let d = c - 48;
        if v > (4611686018427387903 - d) / 10 {
            return (0, false);
        }
        v = v * 10 + d;
        i = i + 1;
    }
    return (v, true);
}

// The refusals of the flags of `ci boot` that need no file: --seed required and below 2^62, --replicates 100 to 100000, --prob with the quantile only (and required there), --trim with the trimmed mean only, below 0.5. Answers
// (errors, seed, replicates, statistic code, quantile type, numerator and number of decimals of the probability or of the trim): the codes of stest.boots.
pub fn check_flags[&h, &g, &p](heap: &!h Heap, args: &g Args, parsed: &p cli.Parsed, table: &static [byte], errs: fail.Errors) -> [heap, args] (fail.Errors, int, int, int, int, int, int) {
    var e = errs;
    var seed = 0;
    if !cli.has(parsed, table, "seed") {
        e = rule.refuse(heap, e, "stats.seed-required", "ci boot needs --seed: an unseeded draw is not reproducible", "stats ci boot --cols A --seed 1 FILE", "flag", "--seed");
    } else {
        let (v, ok) = parse_seed(cli.text(args, parsed, table, "seed"));
        seed = v;
        if !ok {
            e = rule.refuse(heap, e, "args.bad-value", "--seed is an integer from 0 to 4611686018427387903", "--seed 20240229", "flag", "--seed");
        }
    }
    let reps = cli.nat(args, parsed, table, "replicates");
    if reps < 100 || reps > 100000 {
        e = rule.refuse(heap, e, "args.bad-value", "--replicates is outside 100 to 100000", "2000 is the default", "flag", "--replicates");
    }
    var stat = 0;
    let st = cli.text(args, parsed, table, "statistic");
    if bytes.equal(st, "median") {
        stat = 1;
    } else if bytes.equal(st, "variance") {
        stat = 2;
    } else if bytes.equal(st, "sd") {
        stat = 3;
    } else if bytes.equal(st, "skewness") {
        stat = 4;
    } else if bytes.equal(st, "kurtosis") {
        stat = 5;
    } else if bytes.equal(st, "quantile") {
        stat = 6;
    } else if bytes.equal(st, "trimmed-mean") {
        stat = 7;
    }
    var pn = 0;
    var pk = 0;
    if stat == 6 {
        if !cli.has(parsed, table, "prob") {
            e = rule.refuse(heap, e, "args.bad-value", "the quantile needs --prob, the probability from 0 to 1", "--statistic quantile --prob 0.9", "flag", "--prob");
        } else {
            let (n1, k1, ok1) = cat.parse_p(cli.text(args, parsed, table, "prob"));
            pn = n1;
            pk = k1;
            if !ok1 {
                e = rule.refuse(heap, e, "args.bad-value", "--prob is a decimal from 0 to 1 with at most 9 decimals", "--prob 0.9", "flag", "--prob");
            }
        }
    } else if cli.has(parsed, table, "prob") {
        e = rule.refuse(heap, e, "args.bad-value", "--prob is for --statistic quantile", "drop --prob, or use --statistic quantile", "flag", "--prob");
    }
    if stat == 7 {
        let (n2, k2, ok2) = cat.parse_p(cli.text(args, parsed, table, "trim"));
        pn = n2;
        pk = k2;
        if !ok2 || 2 * n2 >= quantile.pow10(k2) {
            e = rule.refuse(heap, e, "args.bad-value", "--trim is a decimal from 0 up to but not including 0.5 with at most 9 decimals", "--trim 0.1", "flag", "--trim");
        }
    } else if cli.has(parsed, table, "trim") {
        e = rule.refuse(heap, e, "args.bad-value", "--trim is for --statistic trimmed-mean", "drop --trim, or use --statistic trimmed-mean", "flag", "--trim");
    }
    return (e, seed, reps, stat, cli.nat(args, parsed, table, "quantile-type"), pn, pk);
}

fn put_entry[&h, &n, &en, &v](heap: &!h Heap, w0: json.Writer, names: &n [byte], ends: &en vec.Vec[int], j: int, vals: &v [int], count: int, rows: int, stat: int, qt: int, pn: int, pk: int, seed: int, reps: int, lnum: int, lk: int, level: float) -> [heap] json.Writer {
    var w = w0;
    w = json.begin_object(heap, w);
    w = json.put_key(heap, w, "column");
    w = answer.put_name(heap, w, names, ends, j);
    var reason = "";
    var ok = false;
    var est = 0.0;
    var have_est = false;
    var est_code = 0;
    var undef = 0;
    if count >= 1 {
        let (eb, ec) = boots.stat_bits(heap, vals[0..count], count, stat, qt, pn, pk);
        est_code = ec;
        if ec == 0 {
            est = float_of_bits(eb);
            have_est = true;
        }
    }
    var lo_pos = 0;
    var hi_pos = 0;
    var lo = 0.0;
    var hi = 0.0;
    if count < 2 {
        reason = "too-few-rows";
    } else if have_est {
        let scale = quantile.pow10(lk);
        lo_pos = reps * (scale - lnum) / (2 * scale);
        hi_pos = (reps * (scale + lnum) + 2 * scale - 1) / (2 * scale) - 1;
        let out = box_slice(heap, reps + 1, 0);
        var code = 0;
        borrow mut out as &!ow in {
            let (c1, u1) = boots.replicates(heap, vals[0..count], count, stat, qt, pn, pk, seed, reps, contents(ow));
            code = c1;
            undef = u1;
            if code == 0 && undef == 0 {
                lo = float_of_bits(boots.key_of_bits(contents(ow)[lo_pos]));
                hi = float_of_bits(boots.key_of_bits(contents(ow)[hi_pos]));
            }
        }
        unbox_slice(heap, out);
        if code != 0 {
            reason = "statistic-beyond-double";
            undef = 0;
        } else if undef != 0 {
            reason = "replicate-undefined";
        } else {
            ok = true;
        }
    } else if est_code == 2 {
        reason = "variance-zero";
    } else {
        reason = "statistic-beyond-double";
    }
    w = json.put_key(heap, w, "estimate");
    if have_est {
        w = json.put_float(heap, w, est);
    } else {
        w = json.put_null(heap, w);
    }
    w = json.put_key(heap, w, "interval");
    if ok {
        w = json.begin_object(heap, w);
        w = json.put_key(heap, w, "of");
        w = json.put_string(heap, w, stat_name(stat));
        w = json.put_key(heap, w, "method");
        w = json.put_string(heap, w, "bootstrap-percentile");
        w = json.put_key(heap, w, "level");
        w = json.put_float(heap, w, level);
        w = json.put_key(heap, w, "estimate");
        w = json.put_float(heap, w, est);
        w = json.put_key(heap, w, "low");
        w = json.put_float(heap, w, lo);
        w = json.put_key(heap, w, "high");
        w = json.put_float(heap, w, hi);
        w = json.put_key(heap, w, "positions");
        w = json.begin_object(heap, w);
        w = json.put_key(heap, w, "low");
        w = json.put_int(heap, w, lo_pos);
        w = json.put_key(heap, w, "high");
        w = json.put_int(heap, w, hi_pos);
        w = json.end_object(heap, w);
        w = json.put_key(heap, w, "rounding");
        w = json.put_string(heap, w, "double");
        w = json.end_object(heap, w);
    } else {
        w = json.put_null(heap, w);
    }
    w = json.put_key(heap, w, "n");
    w = json.begin_object(heap, w);
    w = json.put_key(heap, w, "n");
    w = json.put_int(heap, w, count);
    w = json.put_key(heap, w, "missing");
    w = json.put_int(heap, w, rows - count);
    w = json.end_object(heap, w);
    if len(reason) > 0 {
        w = json.put_key(heap, w, "reason");
        w = json.put_string(heap, w, reason);
    }
    if undef != 0 {
        w = json.put_key(heap, w, "undefined");
        w = json.put_int(heap, w, undef);
    }
    w = json.end_object(heap, w);
    return w;
}

fn stat_name(stat: int) -> [] &static [byte] {
    if stat == 1 {
        return "median";
    }
    if stat == 2 {
        return "variance";
    }
    if stat == 3 {
        return "sd";
    }
    if stat == 4 {
        return "skewness";
    }
    if stat == 5 {
        return "kurtosis";
    }
    if stat == 6 {
        return "quantile";
    }
    if stat == 7 {
        return "trimmed-mean";
    }
    return "mean";
}

// the keys of the present cells of column j of the store, in file order; answers how many
fn gather[&sv, &o](store: &sv vec.Vec[int], rows: int, ncols: int, j: int, out: &!o [int]) -> [] int {
    var m = 0;
    var r = 0;
    while r < rows {
        let k = vec.get(store, r * ncols + j);
        if k != rank.min_int() {
            out[m] = k;
            m = m + 1;
        }
        r = r + 1;
    }
    return m;
}

pub fn boot[&h, &g, &p, &f, &r, &sh, &fu](heap: &!h Heap, args: &g Args, parsed: &p cli.Parsed, fs: &f Fs(""), root: &r [byte], rel: &sh [byte], full: &fu [byte], table: &static [byte], seed: int, reps: int, stat: int, qt: int, pn: int, pk: int, lnum: int, lk: int, level: float, w0: json.Writer, errs: fail.Errors) -> [heap, args, fs_read(""), dir_read, file_read] (json.Writer, fail.Errors) {
    var w = w0;
    var e = errs;
    match place.open_operand(fs, root, rel, full) {
        Opened::Failed(reason) => {
            e = fail.io_error(heap, e, reason, false, rel);
        }
        Opened::Ok(opened) => {
            var file = opened;
            borrow mut file as &!handle in {
                let (names, ends, cols, store, info, e2) = scan.read_file(heap, cli.nat(args, parsed, table, "max-line-bytes"), int_of(cli.text(args, parsed, table, "delim")[0]), cli.nat(args, parsed, table, "max-rows"), cli.nat(args, parsed, table, "max-cols"), cli.nat(args, parsed, table, "max-cells"), handle, rel, 0 - 1, "", false, e);
                e = e2;
                var clean = false;
                borrow e as &er2 in {
                    clean = fail.count(er2) == 0;
                }
                if clean {
                    let nc = info.ncols;
                    let sel = box_slice(heap, nc + 1, 0);
                    var st = 0;
                    var item = 0;
                    borrow names as &nb0 in {
                        borrow ends as &eb0 in {
                            borrow mut sel as &!sw0 in {
                                let (s1, i1) = pick.select(buffer.bytes(nb0), eb0, nc, cli.text(args, parsed, table, "cols"), contents(sw0));
                                st = s1;
                                item = i1;
                            }
                        }
                    }
                    var ok = st == 0;
                    if st != 0 {
                        e = rule.refuse_pick(heap, e, st, bytes.field(cli.text(args, parsed, table, "cols"), ',', item + 1), false);
                    }
                    if ok {
                        borrow cols as &c0 in {
                            borrow sel as &sr in {
                                borrow names as &nb1 in {
                                    borrow ends as &eb1 in {
                                        e = pick.check_numeric(heap, nb1, eb1, contents(sr), nc, contents(c0.numeric), contents(c0.bad), contents(c0.numeric), contents(c0.bad), e);
                                        var j = 0;
                                        while j < nc {
                                            let cnt = contents(c0.numeric)[j];
                                            if contents(sr)[j] == 1 && cnt >= 2 && reps * cnt > cli.nat(args, parsed, table, "max-work") && ok {
                                                ok = false;
                                                e = rule.refuse_int(heap, e, "limit.too-much-work", "replicates times rows is above --max-work", "raise --max-work, or lower --replicates, or name columns of fewer rows", "limit", cli.nat(args, parsed, table, "max-work"), "work", reps * cnt);
                                            }
                                            j = j + 1;
                                        }
                                    }
                                }
                            }
                        }
                        borrow e as &er3 in {
                            if fail.count(er3) != 0 {
                                ok = false;
                            }
                        }
                    }
                    if ok {
                        w = json.put_key(heap, w, "ci");
                        w = json.put_string(heap, w, "boot");
                        w = json.put_key(heap, w, "statistic");
                        w = json.put_string(heap, w, stat_name(stat));
                        if stat == 6 {
                            w = json.put_key(heap, w, "p");
                            w = json.put_float(heap, w, float_of(pn) / float_of(quantile.pow10(pk)));
                            w = json.put_key(heap, w, "type");
                            w = json.put_int(heap, w, qt);
                        }
                        if stat == 7 {
                            w = json.put_key(heap, w, "trim");
                            w = json.put_float(heap, w, float_of(pn) / float_of(quantile.pow10(pk)));
                        }
                        w = json.put_key(heap, w, "method");
                        w = json.put_string(heap, w, "percentile");
                        w = json.put_key(heap, w, "level");
                        w = json.put_float(heap, w, level);
                        w = json.put_key(heap, w, "replicates");
                        w = json.put_int(heap, w, reps);
                        w = json.put_key(heap, w, "seed");
                        w = json.put_int(heap, w, seed);
                        w = json.put_key(heap, w, "rows");
                        w = json.put_int(heap, w, info.rows);
                        w = json.put_key(heap, w, "assumptions");
                        w = json.begin_object(heap, w);
                        w = json.put_key(heap, w, "draw");
                        w = json.put_string(heap, w, "row (z >> 1) mod n, z = mix(s_b + (j + 1) gold), j from 0");
                        w = json.put_key(heap, w, "stream");
                        w = json.put_string(heap, w, "s_b = derive(derive(seed, 1), b), b from 0");
                        w = json.end_object(heap, w);
                        w = json.put_key(heap, w, "intervals");
                        w = json.begin_array(heap, w);
                        let vals = box_slice(heap, info.rows + 1, 0);
                        borrow mut vals as &!vw in {
                            borrow sel as &sr2 in {
                                borrow names as &nb2 in {
                                    borrow ends as &eb2 in {
                                        borrow store as &sb in {
                                            var j = 0;
                                            while j < nc {
                                                if contents(sr2)[j] == 1 {
                                                    let m = gather(sb, info.rows, nc, j, contents(vw));
                                                    w = put_entry(heap, w, buffer.bytes(nb2), eb2, j, contents(vw), m, info.rows, stat, qt, pn, pk, seed, reps, lnum, lk, level);
                                                }
                                                j = j + 1;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        unbox_slice(heap, vals);
                        w = json.end_array(heap, w);
                    }
                    unbox_slice(heap, sel);
                }
                buffer.drop(heap, names);
                vec.drop(heap, ends);
                scan.drop_cols(heap, cols);
                vec.drop(heap, store);
            }
            file_close(file);
        }
    }
    return (w, e);
}
