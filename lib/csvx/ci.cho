edition 5;

module csvx.ci;

import std.bytes;
import std.json;
import std.map;
import csvx.cross;
import csvx.rule;
import stest.answerci;
import stest.prop;
import toolbox.cli;
import toolbox.fail;
import toolbox.place;

// `stats ci prop` (docs/resample.md section 3), moved out of tools/stats/main.cho, which is limited to 2,000 lines: one pass over the file for each column named by --cols (the counting pass of `test prop`, csvx.cross), the interval of
// the proportion of --success (Wilson by default, or --method clopper-pearson) or, with --group, of the difference of the proportions in the two groups (Newcombe's hybrid score, the only method). `lnum`, `lk` and `level` are
// the parsed --level.
pub fn prop[&h, &g, &p, &f, &r, &sh, &fu](heap: &!h Heap, args: &g Args, parsed: &p cli.Parsed, fs: &f Fs(""), root: &r [byte], rel: &sh [byte], full: &fu [byte], table: &static [byte], lnum: int, lk: int, level: float, w0: json.Writer, errs: fail.Errors) -> [heap, args, fs_read(""), dir_read, file_read] (json.Writer, fail.Errors) {
    var w = w0;
    var e = errs;
    let two = cli.has(parsed, table, "group");
    let list = cli.text(args, parsed, table, "cols");
    let ncols_named = bytes.count_byte(list, ',') + 1;
    let success = cli.text(args, parsed, table, "success");
    var ok = true;
    var i = 0;
    while i < ncols_named {
        if len(bytes.field(list, ',', i + 1)) == 0 {
            ok = false;
        }
        i = i + 1;
    }
    if !ok {
        e = rule.refuse(heap, e, "args.bad-value", "--cols has an empty item", "--cols name1,name2: no empty item, no leading or trailing comma", "flag", "--cols");
    }
    var exact = false;
    if cli.has(parsed, table, "method") {
        let m = cli.text(args, parsed, table, "method");
        if bytes.equal(m, "clopper-pearson") {
            exact = true;
        }
        if two && !bytes.equal(m, "newcombe") {
            ok = false;
            e = rule.refuse(heap, e, "args.bad-value", "the interval of a difference of two proportions is Newcombe's hybrid score only", "use --method newcombe, or drop --method", "method", m);
        } else if !two && !bytes.equal(m, "wilson") && !exact {
            ok = false;
            e = rule.refuse(heap, e, "args.bad-value", "the interval of a proportion is --method wilson or clopper-pearson", "use --method wilson or --method clopper-pearson, or drop --method", "method", m);
        }
    }
    let opened_header = ok;
    if ok {
        w = json.put_key(heap, w, "ci");
        w = json.put_string(heap, w, "prop");
        w = json.put_key(heap, w, "success");
        w = json.put_string(heap, w, success);
        if two {
            w = json.put_key(heap, w, "group");
            w = json.put_string(heap, w, cli.text(args, parsed, table, "group"));
        }
        w = json.put_key(heap, w, "level");
        w = json.put_float(heap, w, level);
        w = json.put_key(heap, w, "intervals");
        w = json.begin_array(heap, w);
    }
    i = 0;
    while ok && i < ncols_named {
        let name = bytes.field(list, ',', i + 1);
        match place.open_operand(fs, root, rel, full) {
            Opened::Failed(reason) => {
                e = fail.io_error(heap, e, reason, false, rel);
            }
            Opened::Ok(opened) => {
                var file = opened;
                borrow mut file as &!handle in {
                    let (x, e2) = cross.cross(heap, handle, rel, name, cli.text(args, parsed, table, "group"), two, true, int_of(cli.text(args, parsed, table, "delim")[0]), cli.nat(args, parsed, table, "max-line-bytes"), cli.nat(args, parsed, table, "max-rows"), cli.nat(args, parsed, table, "max-cols"), cli.nat(args, parsed, table, "max-groups"), e);
                    e = e2;
                    var clean = false;
                    borrow e as &er1 in {
                        clean = fail.count(er1) == 0;
                    }
                    if clean {
                        let dn = cross.dense(heap, x, two);
                        borrow dn as &dr in {
                            let sr = map.get(dr.cross.la, success, 0 - 1);
                            var n1 = 0;
                            var x1 = 0;
                            var n2 = 0;
                            var x2 = 0;
                            var row = 0;
                            while row < dr.rows_ {
                                n1 = n1 + contents(dr.counts)[row * dr.cols_];
                                if two {
                                    n2 = n2 + contents(dr.counts)[row * dr.cols_ + 1];
                                }
                                row = row + 1;
                            }
                            if sr >= 0 {
                                x1 = contents(dr.counts)[sr * dr.cols_];
                                if two {
                                    x2 = contents(dr.counts)[sr * dr.cols_ + 1];
                                }
                            }
                            if two && dr.cols_ != 2 {
                                e = rule.refuse_int(heap, e, "stats.group-levels", "--group names a column that does not have exactly two levels", "give --group a column with two levels, or filter the file to two of them", "levels", dr.cols_, "missing", dr.total - dr.cross.used);
                            } else if two {
                                let pr = prop.two_sample(heap, x1, n1, x2, n2);
                                w = answerci.put_two(heap, w, name, map.key_at(dr.cross.lb, contents(dr.order_b)[0]), map.key_at(dr.cross.lb, contents(dr.order_b)[1]), x1, n1, x2, n2, dr.total, pr, lnum, lk, level);
                            } else {
                                let pr = prop.one_sample(heap, x1, n1, 500000000, 1000000000);
                                w = answerci.put_one(heap, w, name, x1, n1, dr.total, pr, lnum, lk, level, exact);
                            }
                        }
                        cross.drop_dense(heap, dn);
                    } else {
                        cross.drop_cross(heap, x);
                    }
                }
                file_close(file);
            }
        }
        var more = false;
        borrow e as &er3 in {
            more = fail.count(er3) == 0;
        }
        if !more {
            ok = false;
        }
        i = i + 1;
    }
    if opened_header {
        w = json.end_array(heap, w);
    }
    return (w, e);
}
