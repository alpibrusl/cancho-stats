edition 5;

module special.ibeta;

import std.math;
import special.lgam;
import special.rules;

// The regularised incomplete beta function I_x(a, b) and its complement (docs/numerics.md section 3.1), answered as the pair (lower, upper), each computed directly where the
// other would lose it. The input is the pair (x, y) with x + y = 1 up to the rounding of each, so a caller that has x and 1 - x to full relative accuracy (the t and F
// distributions) does not round 1 - x. Lentz's continued fraction on the side where it converges, x < (a + 1) / (a + b + 2), otherwise the swapped arguments. The prefactor
// x^a y^b / B(a, b) is Loader's binomial form for a, b >= 10 and a direct exponential below, with `betaln` by Stirling differences when one argument is large.

fn nan() -> [] float {
    return 0.0 / 0.0;
}

fn cap(a: float, b: float) -> [] int {
    var m = a;
    if b > m {
        m = b;
    }
    return 2000 + truncate(100.0 * sqrt(m));
}

// ln B(p, q), p <= q, not both large (callers use Loader's form then)
fn betaln(p: float, q: float) -> [] float {
    let s = p + q;
    if q < 10.0 {
        return lgam.lgamma_pos(p) + lgam.lgamma_pos(q) - lgam.lgamma_pos(s);
    }
    // p < 10 <= q: ln Gamma(p) + [ln Gamma(q) - ln Gamma(p + q)], the bracket by Stirling differences
    let br = 0.0 - (q - 0.5) * math.log1p(p / q) - p * math.log(s) + p + lgam.delta(q) - lgam.delta(s);
    return lgam.lgamma_pos(p) + br;
}

// ln x and ln y, each accurate whichever of the two is near 1
fn ln_xy(x: float, y: float) -> [] (float, float) {
    var lx = 0.0;
    var ly = 0.0;
    if x <= 0.5 {
        lx = math.log(x);
        ly = math.log1p(0.0 - x);
    } else {
        lx = math.log1p(0.0 - y);
        ly = math.log(y);
    }
    return (lx, ly);
}

// x^a y^b / B(a, b)
fn front(a: float, b: float, x: float, y: float) -> [] float {
    if a >= 10.0 && b >= 10.0 {
        let n = a + b;
        return math.exp(lgam.stirlerr(n) - lgam.stirlerr(a) - lgam.stirlerr(b) - lgam.bd0(a, n * x) - lgam.bd0(b, n * y)) * sqrt(a * b / (6.283185307179586 * n));
    }
    var p = a;
    var q = b;
    if b < a {
        p = b;
        q = a;
    }
    let (lx, ly) = ln_xy(x, y);
    return math.exp(a * lx + b * ly - betaln(p, q));
}

// the continued fraction of I_x(a, b) (Numerical Recipes' betacf, modified Lentz); NaN when the cap is reached
fn cf(a: float, b: float, x: float, y: float) -> [] float {
    let tiny = 1.0e-300;
    let qab = a + b;
    let qap = a + 1.0;
    let qam = a - 1.0;
    var c = 1.0;
    // 1 - (a + b) x / (a + 1) = (a y + 1 - b x) / (a + 1) with y = 1 - x known to full accuracy: the direct form cancels to 1/(1 - x) digits near the switch point
    var d = (a * y + 1.0 - b * x) / qap;
    if math.fabs(d) < tiny {
        d = tiny;
    }
    d = 1.0 / d;
    var h = d;
    var m = 1;
    let cp = cap(a, b);
    while m <= cp {
        let fm = float_of(m);
        let m2 = 2.0 * fm;
        var aa = fm * (b - fm) * x / ((qam + m2) * (a + m2));
        d = 1.0 + aa * d;
        if math.fabs(d) < tiny {
            d = tiny;
        }
        c = 1.0 + aa / c;
        if math.fabs(c) < tiny {
            c = tiny;
        }
        d = 1.0 / d;
        h = h * d * c;
        aa = 0.0 - (a + fm) * (qab + fm) * x / ((a + m2) * (qap + m2));
        d = 1.0 + aa * d;
        if math.fabs(d) < tiny {
            d = tiny;
        }
        c = 1.0 + aa / c;
        if math.fabs(c) < tiny {
            c = tiny;
        }
        d = 1.0 / d;
        let del = d * c;
        h = h * del;
        if math.fabs(del - 1.0) < 2.5e-16 {
            return h;
        }
        m = m + 1;
    }
    return nan();
}

// I_x(a, b) by the fraction (the caller chose the side), NaN if it does not converge
fn side(a: float, b: float, x: float, y: float) -> [] float {
    let h = cf(a, b, x, y);
    if is_nan(h) {
        return h;
    }
    return front(a, b, x, y) * h / a;
}

fn clamp01(v: float) -> [] float {
    if v > 1.0 {
        return 1.0;
    }
    if v < 0.0 {
        return 0.0;
    }
    return v;
}

// (lower, upper, code) for a, b > 0 (<= 1e8) and x, y >= 0 with x + y = 1 (up to rounding)
pub fn beta_xy(a: float, b: float, x: float, y: float) -> [] (float, float, int) {
    if is_nan(a) || is_nan(b) || is_nan(x) || is_nan(y) {
        return (nan(), nan(), rules.domain_nan());
    }
    if a <= 0.0 || b <= 0.0 || x < 0.0 || y < 0.0 || x > 1.0 || y > 1.0 {
        return (nan(), nan(), rules.domain_param());
    }
    if a > 1.0e8 || b > 1.0e8 {
        return (nan(), nan(), rules.domain_range());
    }
    if x == 0.0 {
        return (0.0, 1.0, 0);
    }
    if y == 0.0 {
        return (1.0, 0.0, 0);
    }
    var lo = 0.0;
    var up = 0.0;
    if x < (a + 1.0) / (a + b + 2.0) {
        lo = side(a, b, x, y);
        if is_nan(lo) {
            return (nan(), nan(), rules.noconverge());
        }
        up = 1.0 - lo;
        if up < 0.001 {
            let u2 = side(b, a, y, x);
            if !is_nan(u2) {
                up = u2;
            }
        }
    } else {
        up = side(b, a, y, x);
        if is_nan(up) {
            return (nan(), nan(), rules.noconverge());
        }
        lo = 1.0 - up;
        if lo < 0.001 {
            let l2 = side(a, b, x, y);
            if !is_nan(l2) {
                lo = l2;
            }
        }
    }
    return (clamp01(lo), clamp01(up), 0);
}

// (lower, upper, code) at x in [0, 1]; 1 - x is rounded for x < 1/2 (it is exact above)
pub fn beta_ix(a: float, b: float, x: float) -> [] (float, float, int) {
    if is_nan(x) {
        return (nan(), nan(), rules.domain_nan());
    }
    return beta_xy(a, b, x, 1.0 - x);
}
